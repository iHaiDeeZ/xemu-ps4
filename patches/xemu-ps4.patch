diff --git a/tcg/tcg-aot.c.inc b/tcg/tcg-aot.c.inc
new file mode 100644
index 0000000..e0b245b
--- /dev/null
+++ b/tcg/tcg-aot.c.inc
@@ -0,0 +1,1310 @@
+/*
+ * xemu-ps4: a translation block written out as C, for the ahead-of-time
+ * translator (accel/tcg/aot.c records these on the console, scripts/aot-build.py
+ * compiles them with clang on a PC, and the result runs instead of the JIT's code).
+ *
+ * Included at the end of tcg/tcg.c: it walks the TB's ops after the optimizer and
+ * liveness, where tcg_gen_code would allocate registers and emit host code, and
+ * prints one C statement (or a few) per op. Everything the generated code needs
+ * from this build (env offsets, TLB layout) is a number taken from the ops or from
+ * accel/tcg/aot.c's ABI header, so the C is only valid for the build that wrote it
+ * (the loader compares the ABI key).
+ *
+ * The guest registers that pass from block to block are the C function's
+ * parameters (eax..edi, cc_dst, cc_src, cc_op: scripts/aot_rt.h, AOT_PARAMS), kept
+ * in host registers across the blocks by a preserve_none calling convention and
+ * musttail calls; the other globals live in env as for the JIT. Before anything
+ * that can read env (a helper, a TLB miss, a return to the JIT) the changed
+ * registers are stored; after a helper that may write globals they are reloaded.
+ *
+ * This program is free software; you can redistribute it and/or modify it under
+ * the terms of the GNU General Public License as published by the Free Software
+ * Foundation; either version 2 of the License, or (at your option) any later
+ * version.
+ */
+
+#include "exec/aot.h"
+#include "hw/core/cpu.h"
+
+/* The globals that are C parameters (in this order: AOT_PARAMS in aot_rt.h). */
+static const char *const aot_passed_names[] = {
+    "eax", "ecx", "edx", "ebx", "esp", "ebp", "esi", "edi",
+    "cc_dst", "cc_src", "cc_op",
+};
+
+typedef struct AotEmit {
+    TCGContext *s;
+    GString *o;
+    const char *fail;
+    char failbuf[96];
+    uint64_t tb_pc;          /* the TB's virtual pc (cs_base 0) */
+    uint64_t cur_pc;         /* the current guest instruction's pc */
+    int cur_cc;              /* its cc_op at insn start (CC_OP_DYNAMIC: env) */
+    bool have_insn;
+    bool skip_exit_tb;       /* a goto_tb was just emitted: its exit_tb goes */
+    TCGTemp *lookup_ptr;     /* the lookup_tb_ptr call's result */
+    bool lookup_pending;
+    int x87_csr_set;         /* host MXCSR holds the x87 value (flcr) */
+    TCGTemp *eip;            /* the eip global */
+    /* eip's value where it is known statically (direct jumps name their target) */
+    bool eip_known;
+    uint32_t eip_val;
+    int nb_labels;
+    int8_t *lab_seen;        /* per label: 0 none yet, 1 known state, -1 unknown */
+    uint32_t *lab_val;
+    bool flow_ends;          /* the previous op never falls through */
+    /* per temp index */
+    uint8_t *passed;         /* 1 + index in aot_passed_names, 0 if not passed */
+    uint8_t *used;           /* referenced at all */
+    uint8_t *written;        /* globals: written somewhere in the TB */
+    uint8_t *dirty;          /* globals: env is older than the C variable */
+    uint8_t *declared;
+    int nb_temps;
+} AotEmit;
+
+static void aot_failf(AotEmit *e, const char *fmt, ...) G_GNUC_PRINTF(2, 3);
+static void aot_failf(AotEmit *e, const char *fmt, ...)
+{
+    va_list ap;
+    if (e->fail) {
+        return;
+    }
+    va_start(ap, fmt);
+    vsnprintf(e->failbuf, sizeof(e->failbuf), fmt, ap);
+    va_end(ap);
+    e->fail = e->failbuf;
+}
+
+static const char *aot_ctype(TCGType t)
+{
+    switch (t) {
+    case TCG_TYPE_I32: return "uint32_t";
+    case TCG_TYPE_I64: return "uint64_t";
+    case TCG_TYPE_F32: return "float";
+    case TCG_TYPE_F64: return "double";
+    case TCG_TYPE_V64: return "aotv64";
+    case TCG_TYPE_V128: return "aotv128";
+    case TCG_TYPE_V256: return "aotv256";
+    default: return NULL;
+    }
+}
+
+static const char *aot_stype(TCGType t)
+{
+    return t == TCG_TYPE_I32 ? "int32_t" : "int64_t";
+}
+
+static int aot_bits(TCGType t)
+{
+    return t == TCG_TYPE_I32 ? 32 : 64;
+}
+
+static int aot_vbytes(TCGType t)
+{
+    switch (t) {
+    case TCG_TYPE_V64: return 8;
+    case TCG_TYPE_V128: return 16;
+    case TCG_TYPE_V256: return 32;
+    default: return 0;
+    }
+}
+
+/* The C name or literal of an argument temp, in a static ring of buffers. */
+static const char *aot_t(AotEmit *e, TCGArg arg)
+{
+    static char ring[16][64];
+    static int ri;
+    char *b = ring[ri++ & 15];
+    TCGTemp *ts = arg_temp(arg);
+    int idx = temp_idx(ts);
+
+    switch (ts->kind) {
+    case TEMP_FIXED:
+        snprintf(b, 64, "((uintptr_t)env)");
+        break;
+    case TEMP_GLOBAL:
+        snprintf(b, 64, "g_%s", ts->name);
+        break;
+    case TEMP_CONST:
+        switch (ts->type) {
+        case TCG_TYPE_I32:
+            snprintf(b, 64, "0x%" PRIx32 "u", (uint32_t)ts->val);
+            break;
+        case TCG_TYPE_I64:
+            snprintf(b, 64, "0x%" PRIx64 "ull", (uint64_t)ts->val);
+            break;
+        case TCG_TYPE_V64:
+            snprintf(b, 64, "((aotv64){0x%" PRIx64 "ull})", (uint64_t)ts->val);
+            break;
+        case TCG_TYPE_V128:
+            snprintf(b, 64, "AOT_VC128(0x%" PRIx64 "ull)", (uint64_t)ts->val);
+            break;
+        case TCG_TYPE_V256:
+            snprintf(b, 64, "AOT_VC256(0x%" PRIx64 "ull)", (uint64_t)ts->val);
+            break;
+        default:
+            aot_failf(e, "constant of type %d", ts->type);
+            snprintf(b, 64, "0");
+            break;
+        }
+        break;
+    default:
+        snprintf(b, 64, "t%d", idx);
+        break;
+    }
+    return b;
+}
+
+/* A pointer-sized base for ld/st: env or a temp holding a host address. */
+static const char *aot_base(AotEmit *e, TCGArg arg)
+{
+    static char ring[4][80];
+    static int ri;
+    char *b = ring[ri++ & 3];
+    TCGTemp *ts = arg_temp(arg);
+    if (ts->kind == TEMP_FIXED) {
+        return "((char *)env)";
+    }
+    snprintf(b, 80, "((char *)(uintptr_t)%s)", aot_t(e, arg));
+    return b;
+}
+
+static void aot_note_temp(AotEmit *e, TCGArg arg, bool out)
+{
+    TCGTemp *ts = arg_temp(arg);
+    int idx = temp_idx(ts);
+
+    e->used[idx] = 1;
+    if (ts->kind == TEMP_FIXED) {
+        if (ts != tcgv_ptr_temp(tcg_env)) {
+            aot_failf(e, "fixed temp %s", ts->name ? ts->name : "?");
+        }
+        if (out) {
+            aot_failf(e, "write to env");
+        }
+        return;
+    }
+    if (!aot_ctype(ts->type)) {
+        aot_failf(e, "temp type %d", ts->type);
+        return;
+    }
+    if (ts->kind == TEMP_GLOBAL) {
+        if (ts->indirect_reg || ts->mem_base != tcgv_ptr_temp(tcg_env)) {
+            aot_failf(e, "global %s not in env", ts->name);
+            return;
+        }
+        if (out) {
+            e->written[idx] = 1;
+        }
+    }
+}
+
+/* Store the globals whose C copy is newer than env (all of them if 'all'). */
+static void aot_sync(AotEmit *e, bool all)
+{
+    for (int i = 0; i < e->nb_temps; i++) {
+        TCGTemp *ts = &e->s->temps[i];
+        if (ts->kind != TEMP_GLOBAL || !(e->dirty[i] || (all && e->used[i]))) {
+            continue;
+        }
+        if (!e->dirty[i] && !e->written[i] && !e->passed[i] && ts != e->eip) {
+            continue;   /* loaded from env and never changed */
+        }
+        g_string_append_printf(e->o, " AOT_ST_%s(%" PRIdPTR ", g_%s);",
+                               ts->type == TCG_TYPE_I32 ? "I32" : "I64",
+                               ts->mem_offset, ts->name);
+        e->dirty[i] = 0;
+    }
+}
+
+/* Reload every global the block keeps in C variables (after a helper may write them). */
+static void aot_reload(AotEmit *e)
+{
+    for (int i = 0; i < e->nb_temps; i++) {
+        TCGTemp *ts = &e->s->temps[i];
+        if (ts->kind != TEMP_GLOBAL || !(e->used[i] || e->passed[i])) {
+            continue;
+        }
+        g_string_append_printf(e->o, " g_%s = AOT_LD_%s(%" PRIdPTR ");", ts->name,
+                               ts->type == TCG_TYPE_I32 ? "I32" : "I64", ts->mem_offset);
+        e->dirty[i] = 0;
+    }
+}
+
+static void aot_mark_all_dirty(AotEmit *e)
+{
+    for (int i = 0; i < e->nb_temps; i++) {
+        TCGTemp *ts = &e->s->temps[i];
+        if (ts->kind == TEMP_GLOBAL && (e->written[i] || e->passed[i] || ts == e->eip)) {
+            e->dirty[i] = 1;
+        }
+    }
+}
+
+static void aot_cur(AotEmit *e)
+{
+    g_string_append_printf(e->o, " AOT_CUR(0x%" PRIx64 "u, %d);", e->cur_pc, e->cur_cc);
+}
+
+static const char *aot_cond(AotEmit *e, TCGCond c, TCGType t, const char *a, const char *b)
+{
+    static char ring[4][192];
+    static int ri;
+    char *r = ring[ri++ & 3];
+    const char *st = aot_stype(t);
+
+    switch (c) {
+    case TCG_COND_NEVER: return "0";
+    case TCG_COND_ALWAYS: return "1";
+    case TCG_COND_EQ: snprintf(r, 192, "(%s == %s)", a, b); break;
+    case TCG_COND_NE: snprintf(r, 192, "(%s != %s)", a, b); break;
+    case TCG_COND_TSTEQ: snprintf(r, 192, "((%s & %s) == 0)", a, b); break;
+    case TCG_COND_TSTNE: snprintf(r, 192, "((%s & %s) != 0)", a, b); break;
+    case TCG_COND_LT: snprintf(r, 192, "((%s)%s < (%s)%s)", st, a, st, b); break;
+    case TCG_COND_GE: snprintf(r, 192, "((%s)%s >= (%s)%s)", st, a, st, b); break;
+    case TCG_COND_GT: snprintf(r, 192, "((%s)%s > (%s)%s)", st, a, st, b); break;
+    case TCG_COND_LE: snprintf(r, 192, "((%s)%s <= (%s)%s)", st, a, st, b); break;
+    case TCG_COND_LTU: snprintf(r, 192, "(%s < %s)", a, b); break;
+    case TCG_COND_GEU: snprintf(r, 192, "(%s >= %s)", a, b); break;
+    case TCG_COND_GTU: snprintf(r, 192, "(%s > %s)", a, b); break;
+    case TCG_COND_LEU: snprintf(r, 192, "(%s <= %s)", a, b); break;
+    default:
+        aot_failf(e, "condition %d", c);
+        return "0";
+    }
+    return r;
+}
+
+/* Lane vector type names for vector ops: u32x4 and so on (aot_rt.h). */
+static void aot_lanes(TCGType t, unsigned vece, char *u, char *s, int *bits, int *count)
+{
+    int b = 8 << vece, n = aot_vbytes(t) * 8 / b;
+    sprintf(u, "u%dx%d", b, n);
+    sprintf(s, "s%dx%d", b, n);
+    *bits = b;
+    *count = n;
+}
+
+static const char *aot_vcond(AotEmit *e, TCGCond c, const char *u, const char *s,
+                             const char *a, const char *b)
+{
+    static char ring[2][256];
+    static int ri;
+    char *r = ring[ri++ & 1];
+    switch (c) {
+    case TCG_COND_EQ: snprintf(r, 256, "((%s)%s == (%s)%s)", u, a, u, b); break;
+    case TCG_COND_NE: snprintf(r, 256, "((%s)%s != (%s)%s)", u, a, u, b); break;
+    case TCG_COND_TSTEQ: snprintf(r, 256, "(((%s)%s & (%s)%s) == 0)", u, a, u, b); break;
+    case TCG_COND_TSTNE: snprintf(r, 256, "(((%s)%s & (%s)%s) != 0)", u, a, u, b); break;
+    case TCG_COND_LT: snprintf(r, 256, "((%s)%s < (%s)%s)", s, a, s, b); break;
+    case TCG_COND_GE: snprintf(r, 256, "((%s)%s >= (%s)%s)", s, a, s, b); break;
+    case TCG_COND_GT: snprintf(r, 256, "((%s)%s > (%s)%s)", s, a, s, b); break;
+    case TCG_COND_LE: snprintf(r, 256, "((%s)%s <= (%s)%s)", s, a, s, b); break;
+    case TCG_COND_LTU: snprintf(r, 256, "((%s)%s < (%s)%s)", u, a, u, b); break;
+    case TCG_COND_GEU: snprintf(r, 256, "((%s)%s >= (%s)%s)", u, a, u, b); break;
+    case TCG_COND_GTU: snprintf(r, 256, "((%s)%s > (%s)%s)", u, a, u, b); break;
+    case TCG_COND_LEU: snprintf(r, 256, "((%s)%s <= (%s)%s)", u, a, u, b); break;
+    default:
+        aot_failf(e, "vector condition %d", c);
+        return "0";
+    }
+    return r;
+}
+
+static void aot_emit_vec(AotEmit *e, TCGOp *op)
+{
+    TCGOpcode c = op->opc;
+    TCGType t = TCGOP_TYPE(op);
+    unsigned vece = TCGOP_VECE(op);
+    const char *vt = aot_ctype(t);
+    char u[16], s[16];
+    int bits, n;
+    GString *o = e->o;
+
+    if (!aot_vbytes(t)) {
+        aot_failf(e, "vector type %d", t);
+        return;
+    }
+    aot_lanes(t, vece, u, s, &bits, &n);
+#define A(i) aot_t(e, op->args[i])
+    switch (c) {
+    case INDEX_op_mov_vec:
+        g_string_append_printf(o, " %s = %s;", A(0), A(1));
+        break;
+    case INDEX_op_dup_vec: {
+        TCGTemp *src = arg_temp(op->args[1]);
+        g_string_append_printf(o, " { %s _x = (%s)", vt, vt);
+        g_string_append_printf(o, "(%s){", u);
+        for (int i = 0; i < n; i++) {
+            g_string_append_printf(o, "%s(uint%d_t)%s", i ? "," : "", bits, A(1));
+        }
+        g_string_append_printf(o, "}; %s = _x; }", A(0));
+        (void)src;
+        break;
+    }
+    case INDEX_op_dupm_vec:
+        g_string_append_printf(o, " { uint%d_t _l; __builtin_memcpy(&_l, %s + %" PRId64 ", %d);"
+                               " %s = (%s)(%s){", bits, aot_base(e, op->args[1]),
+                               (int64_t)op->args[2], bits / 8, A(0), vt, u);
+        for (int i = 0; i < n; i++) {
+            g_string_append_printf(o, "%s_l", i ? "," : "");
+        }
+        g_string_append(o, "}; }");
+        break;
+    case INDEX_op_ld_vec:
+        g_string_append_printf(o, " __builtin_memcpy(&%s, %s + %" PRId64 ", %d);", A(0),
+                               aot_base(e, op->args[1]), (int64_t)op->args[2], aot_vbytes(t));
+        break;
+    case INDEX_op_st_vec:
+        g_string_append_printf(o, " { %s _v = %s; __builtin_memcpy(%s + %" PRId64 ", &_v, %d); }",
+                               vt, A(0), aot_base(e, op->args[1]), (int64_t)op->args[2],
+                               aot_vbytes(t));
+        break;
+    case INDEX_op_and_vec: g_string_append_printf(o, " %s = %s & %s;", A(0), A(1), A(2)); break;
+    case INDEX_op_or_vec: g_string_append_printf(o, " %s = %s | %s;", A(0), A(1), A(2)); break;
+    case INDEX_op_xor_vec: g_string_append_printf(o, " %s = %s ^ %s;", A(0), A(1), A(2)); break;
+    case INDEX_op_andc_vec: g_string_append_printf(o, " %s = %s & ~%s;", A(0), A(1), A(2)); break;
+    case INDEX_op_orc_vec: g_string_append_printf(o, " %s = %s | ~%s;", A(0), A(1), A(2)); break;
+    case INDEX_op_nand_vec: g_string_append_printf(o, " %s = ~(%s & %s);", A(0), A(1), A(2)); break;
+    case INDEX_op_nor_vec: g_string_append_printf(o, " %s = ~(%s | %s);", A(0), A(1), A(2)); break;
+    case INDEX_op_eqv_vec: g_string_append_printf(o, " %s = ~(%s ^ %s);", A(0), A(1), A(2)); break;
+    case INDEX_op_not_vec: g_string_append_printf(o, " %s = ~%s;", A(0), A(1)); break;
+    case INDEX_op_add_vec:
+        g_string_append_printf(o, " %s = (%s)((%s)%s + (%s)%s);", A(0), vt, u, A(1), u, A(2));
+        break;
+    case INDEX_op_sub_vec:
+        g_string_append_printf(o, " %s = (%s)((%s)%s - (%s)%s);", A(0), vt, u, A(1), u, A(2));
+        break;
+    case INDEX_op_mul_vec:
+        g_string_append_printf(o, " %s = (%s)((%s)%s * (%s)%s);", A(0), vt, u, A(1), u, A(2));
+        break;
+    case INDEX_op_neg_vec:
+        g_string_append_printf(o, " %s = (%s)(-(%s)%s);", A(0), vt, u, A(1));
+        break;
+    case INDEX_op_abs_vec:
+        g_string_append_printf(o, " %s = (%s)__builtin_elementwise_abs((%s)%s);", A(0), vt, s, A(1));
+        break;
+    case INDEX_op_ssadd_vec:
+        g_string_append_printf(o, " %s = (%s)__builtin_elementwise_add_sat((%s)%s, (%s)%s);",
+                               A(0), vt, s, A(1), s, A(2));
+        break;
+    case INDEX_op_usadd_vec:
+        g_string_append_printf(o, " %s = (%s)__builtin_elementwise_add_sat((%s)%s, (%s)%s);",
+                               A(0), vt, u, A(1), u, A(2));
+        break;
+    case INDEX_op_sssub_vec:
+        g_string_append_printf(o, " %s = (%s)__builtin_elementwise_sub_sat((%s)%s, (%s)%s);",
+                               A(0), vt, s, A(1), s, A(2));
+        break;
+    case INDEX_op_ussub_vec:
+        g_string_append_printf(o, " %s = (%s)__builtin_elementwise_sub_sat((%s)%s, (%s)%s);",
+                               A(0), vt, u, A(1), u, A(2));
+        break;
+    case INDEX_op_smin_vec:
+        g_string_append_printf(o, " %s = (%s)__builtin_elementwise_min((%s)%s, (%s)%s);",
+                               A(0), vt, s, A(1), s, A(2));
+        break;
+    case INDEX_op_umin_vec:
+        g_string_append_printf(o, " %s = (%s)__builtin_elementwise_min((%s)%s, (%s)%s);",
+                               A(0), vt, u, A(1), u, A(2));
+        break;
+    case INDEX_op_smax_vec:
+        g_string_append_printf(o, " %s = (%s)__builtin_elementwise_max((%s)%s, (%s)%s);",
+                               A(0), vt, s, A(1), s, A(2));
+        break;
+    case INDEX_op_umax_vec:
+        g_string_append_printf(o, " %s = (%s)__builtin_elementwise_max((%s)%s, (%s)%s);",
+                               A(0), vt, u, A(1), u, A(2));
+        break;
+    case INDEX_op_shli_vec:
+        g_string_append_printf(o, " %s = (%s)((%s)%s << %d);", A(0), vt, u, A(1),
+                               (int)(op->args[2] & (bits - 1)));
+        break;
+    case INDEX_op_shri_vec:
+        g_string_append_printf(o, " %s = (%s)((%s)%s >> %d);", A(0), vt, u, A(1),
+                               (int)(op->args[2] & (bits - 1)));
+        break;
+    case INDEX_op_sari_vec:
+        g_string_append_printf(o, " %s = (%s)((%s)%s >> %d);", A(0), vt, s, A(1),
+                               (int)(op->args[2] & (bits - 1)));
+        break;
+    case INDEX_op_rotli_vec: {
+        int k = op->args[2] & (bits - 1);
+        if (k == 0) {
+            g_string_append_printf(o, " %s = %s;", A(0), A(1));
+        } else {
+            g_string_append_printf(o, " %s = (%s)(((%s)%s << %d) | ((%s)%s >> %d));", A(0), vt,
+                                   u, A(1), k, u, A(1), bits - k);
+        }
+        break;
+    }
+    case INDEX_op_shls_vec:
+        g_string_append_printf(o, " %s = (%s)((%s)%s << (uint%d_t)(%s & %d));", A(0), vt, u, A(1),
+                               bits, A(2), bits - 1);
+        break;
+    case INDEX_op_shrs_vec:
+        g_string_append_printf(o, " %s = (%s)((%s)%s >> (uint%d_t)(%s & %d));", A(0), vt, u, A(1),
+                               bits, A(2), bits - 1);
+        break;
+    case INDEX_op_sars_vec:
+        g_string_append_printf(o, " %s = (%s)((%s)%s >> (int%d_t)(%s & %d));", A(0), vt, s, A(1),
+                               bits, A(2), bits - 1);
+        break;
+    case INDEX_op_rotls_vec:
+        g_string_append_printf(o, " { uint%d_t _k = %s & %d; %s = _k ? (%s)(((%s)%s << _k) |"
+                               " ((%s)%s >> (uint%d_t)(%d - _k))) : %s; }", bits, A(2), bits - 1,
+                               A(0), vt, u, A(1), u, A(1), bits, bits, A(1));
+        break;
+    case INDEX_op_shlv_vec:
+        g_string_append_printf(o, " %s = (%s)((%s)%s << ((%s)%s & %d));", A(0), vt, u, A(1), u,
+                               A(2), bits - 1);
+        break;
+    case INDEX_op_shrv_vec:
+        g_string_append_printf(o, " %s = (%s)((%s)%s >> ((%s)%s & %d));", A(0), vt, u, A(1), u,
+                               A(2), bits - 1);
+        break;
+    case INDEX_op_sarv_vec:
+        g_string_append_printf(o, " %s = (%s)((%s)%s >> ((%s)%s & %d));", A(0), vt, s, A(1), s,
+                               A(2), bits - 1);
+        break;
+    case INDEX_op_rotlv_vec:
+    case INDEX_op_rotrv_vec: {
+        bool left = c == INDEX_op_rotlv_vec;
+        g_string_append_printf(o, " { %s _k = (%s)%s & %d, _a = (%s)%s;"
+                               " %s = (%s)((_a %s _k) | (_a %s ((%d - _k) & %d))); }",
+                               u, u, A(2), bits - 1, u, A(1), A(0), vt, left ? "<<" : ">>",
+                               left ? ">>" : "<<", bits, bits - 1);
+        break;
+    }
+    case INDEX_op_cmp_vec:
+        g_string_append_printf(o, " %s = (%s)%s;", A(0), vt,
+                               aot_vcond(e, op->args[3], u, s, A(1), A(2)));
+        break;
+    case INDEX_op_bitsel_vec:
+        g_string_append_printf(o, " %s = (%s & %s) | (%s & ~%s);", A(0), A(2), A(1), A(3), A(1));
+        break;
+    case INDEX_op_cmpsel_vec:
+        g_string_append_printf(o, " { %s _m = (%s)%s; %s = (%s & _m) | (%s & ~_m); }", vt, vt,
+                               aot_vcond(e, op->args[5], u, s, A(1), A(2)), A(0), A(3), A(4));
+        break;
+    default:
+        aot_failf(e, "op %s", tcg_op_defs[c].name);
+        break;
+    }
+#undef A
+}
