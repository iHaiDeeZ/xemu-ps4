diff --git a/ui/ps4/ps4-frontend.h b/ui/ps4/ps4-frontend.h
new file mode 100644
index 0000000..eafad10
--- /dev/null
+++ b/ui/ps4/ps4-frontend.h
@@ -0,0 +1,102 @@
+/*
+ * xemu-ps4: the PS4 frontend's pieces (xemu-ps4.c, ps4-present.cc, ps4-hud.cc)
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#ifndef UI_PS4_PS4_FRONTEND_H
+#define UI_PS4_PS4_FRONTEND_H
+
+#include <stdbool.h>
+#include <SDL3/SDL.h>
+#include "hw/xbox/nv2a/nv2a_vk_ps4.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ps4-present.cc: VideoOut swapchain on the renderer's device, ImGui on top */
+bool ps4_present_ready(void);
+bool ps4_present_init(const NV2AVkDevice *dev);
+/* Draws one frame: the display image (between nv2a_get/release_framebuffer_surface) scaled to
+ * the screen, then the HUD's ImGui frame; returns once the GPU is done with the display image. */
+void ps4_present_frame(bool have_display);
+void ps4_present_shutdown(void);
+/* frames presented so far, and those that had the emulated display in them */
+void ps4_present_stats(uint64_t *frames, uint64_t *display_frames);
+
+/* ps4-present.cc: an RGBA picture as an ImGui texture (an ImTextureID; 0 when it can't be made) */
+unsigned long long ps4_present_texture(const unsigned char *rgba, int w, int h);
+
+/* ps4-pad.c: the DualShock 4 as an SDL virtual gamepad (after SDL's gamepad subsystem) */
+void ps4_pad_init(void);
+/* its SDL joystick id (0 if it couldn't be set up) */
+SDL_JoystickID ps4_pad_joystick_id(void);
+/* reads, failures, reopens and the last buttons, for the monitor */
+void ps4_pad_stats(char *out, size_t size);
+/* the system holds the pad's input (its reads are marked intercepted) */
+bool ps4_pad_intercepted(void);
+
+/* xemu-ps4.c: the busiest threads over the last 5 s ("name N%, ..."), for the overlay */
+extern char ps4_perf_threads[256];
+/* xemu-ps4.c: how busy the GPU was over the last 5 s, in percent (-1: not known yet) */
+extern int ps4_perf_gpu;
+
+/* xemu-ps4.c: why the Xbox can't start (a BIOS mismatch, ...), NULL if nothing is known wrong */
+extern const char *ps4_setup_problem;
+
+/* ps4-pad.c: the quick menu's buttons (ORBIS_PAD_BUTTON_*) pressed since the last call; while
+ * the menu is open the Xbox controller sees nothing pressed */
+uint32_t ps4_pad_menu_pressed(void);
+/* ps4-hud.cc: the quick menu is up (L3+R3 toggles it, ps4-pad.c) */
+extern bool ps4_menu_open;
+/* ps4-hud.cc: opens the menu on its game list (no disc at start) */
+void ps4_hud_open_games(void);
+
+/* xemu-ps4.c: the menu's actions, called with the main loop lock */
+bool ps4_load_disc(const char *path);
+void ps4_eject_disc(void);
+void ps4_request_reset(void);
+void ps4_request_quit(void);
+/* ps4-live.c: the live console (TCP), and the monitor's last line it reports */
+void ps4_live_start(int port);
+extern char ps4_live_last_monitor[1024];
+/* xemu-ps4.c: an 8 s CPU profile of the emulation threads now (profiles/profile_N.txt) */
+bool ps4_profile_now(const char *reason);
+
+/* ps4-hud.cc: notifications, status and menus (ImGui), called with the main loop lock */
+void ps4_hud_process_sdl_event(const SDL_Event *event);
+void ps4_hud_update(void);
+/* between ImGui::NewFrame and ImGui::Render (presenter) */
+void ps4_hud_draw(void);
+
+/* ps4-launcher.cc: the game library at start and from the quick menu (covers from the games'
+ * own title images or /data/xemu/covers) */
+extern bool ps4_launcher_active;
+void ps4_launcher_open(void);
+/* between ImGui::NewFrame and ImGui::Render; true while it covers the screen */
+bool ps4_launcher_draw(void);
+/* under the main loop lock: the game picked, if any (ps4_hud_update starts it) */
+const char *ps4_launcher_take_pick(void);
+
+/* xemu-ps4.c: start or switch to a game (under the main loop lock): the disc in, and the machine
+ * started (from -S) or reset; pause/resume around the library */
+bool ps4_launch_game(const char *path);
+/* ps4-launcher.cc: an ISO's default.xbe title ID (0 if it has none) */
+uint32_t ps4_iso_title_id(const char *path);
+void ps4_pause_emulation(bool pause);
+extern bool ps4_emulation_started;
+
+#ifdef __cplusplus
+}
+#endif
+
+#ifdef __cplusplus
+struct ImFont;
+extern ImFont *ps4_font_title, *ps4_font_small;
+#endif
+
+#endif
diff --git a/ui/ps4/ps4-hud.cc b/ui/ps4/ps4-hud.cc
new file mode 100644
index 0000000..f7db113
--- /dev/null
+++ b/ui/ps4/ps4-hud.cc
@@ -0,0 +1,457 @@
+/*
+ * xemu-ps4: what is drawn over the emulated picture (ImGui): notifications and error messages
+ * (xemu-notifications.h, which the desktop's xui implements), the frame rate, what is missing
+ * before a game can start, and the quick menu (L3+R3: games, reset, picture, CPU layout, quit).
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "ps4-frontend.h"
+#include "ps4-settings.h"
+#include "ui/xemu-notifications.h"
+#include "ui/xemu-settings.h"
+#include "hw/xbox/nv2a/debug.h"
+
+#include "imgui.h"
+
+#include <algorithm>
+#include <chrono>
+#include <deque>
+#include <dirent.h>
+#include <mutex>
+#include <string>
+#include <strings.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <vector>
+
+#include <orbis/Pad.h>
+
+extern "C" unsigned ps4_kit_cpu_mhz(void);
+
+namespace
+{
+using Clock = std::chrono::steady_clock;
+
+// --- notifications ---------------------------------------------------------------------------
+
+struct Message
+{
+    std::string text;
+    bool error;
+    Clock::time_point shown;
+};
+
+std::mutex sMutex;
+std::deque<Message> sQueue;     // waiting to be shown, oldest first
+Message sCurrent;
+bool sShowing;
+constexpr auto kShowTime = std::chrono::seconds(4);
+constexpr auto kErrorShowTime = std::chrono::seconds(10);
+
+void Queue(const char *msg, bool error)
+{
+    std::lock_guard<std::mutex> lock(sMutex);
+    sQueue.push_back({ msg, error, {} });
+}
+
+void DrawNotification()
+{
+    std::lock_guard<std::mutex> lock(sMutex);
+    const auto now = Clock::now();
+    if (sShowing && now - sCurrent.shown > (sCurrent.error ? kErrorShowTime : kShowTime)) {
+        sShowing = false;
+    }
+    if (!sShowing && !sQueue.empty()) {
+        sCurrent = sQueue.front();
+        sCurrent.shown = now;
+        sQueue.pop_front();
+        sShowing = true;
+    }
+    if (!sShowing) {
+        return;
+    }
+    const ImVec2 screen = ImGui::GetIO().DisplaySize;
+    ImGui::SetNextWindowPos(ImVec2(screen.x * 0.5f, screen.y - 80.0f), ImGuiCond_Always,
+                            ImVec2(0.5f, 1.0f));
+    ImGui::SetNextWindowBgAlpha(0.8f);
+    ImGui::Begin("##notification", nullptr,
+                 ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_AlwaysAutoResize |
+                     ImGuiWindowFlags_NoNav | ImGuiWindowFlags_NoFocusOnAppearing |
+                     ImGuiWindowFlags_NoInputs);
+    if (sCurrent.error) {
+        ImGui::TextColored(ImVec4(1.0f, 0.4f, 0.4f, 1.0f), "%s", sCurrent.text.c_str());
+    } else {
+        ImGui::TextUnformatted(sCurrent.text.c_str());
+    }
+    ImGui::End();
+}
+
+// --- frame rate ------------------------------------------------------------------------------
+
+// Top left: the game's frame rate (NV2A flips), the display's, and (Show load) GPU and threads
+void DrawPerformance()
+{
+    static Clock::time_point last = Clock::now();
+    static unsigned lastFlips;
+    static uint64_t lastFrames;
+    static float gameFps, displayFps;
+    const auto now = Clock::now();
+    const float secs = std::chrono::duration<float>(now - last).count();
+    if (secs >= 0.5f) {
+        uint64_t frames, displayFrames;
+        ps4_present_stats(&frames, &displayFrames);
+        const unsigned flips = g_nv2a_stats.frame_count;
+        gameFps = (flips - lastFlips) / secs;
+        displayFps = (frames - lastFrames) / secs;
+        lastFlips = flips;
+        lastFrames = frames;
+        last = now;
+    }
+    if (!ps4_settings.show_fps && !ps4_pad_intercepted()) {
+        return;
+    }
+    ImGui::SetNextWindowPos(ImVec2(16.0f, 16.0f), ImGuiCond_Always);
+    ImGui::SetNextWindowBgAlpha(0.55f);
+    ImGui::Begin("##performance", nullptr,
+                 ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_AlwaysAutoResize |
+                     ImGuiWindowFlags_NoNav | ImGuiWindowFlags_NoFocusOnAppearing |
+                     ImGuiWindowFlags_NoInputs);
+    if (ps4_settings.show_fps) {
+        if (ps4_settings.show_stats && ps4_perf_gpu >= 0) {
+            ImGui::Text("Game %.1f FPS   Display %.0f FPS   GPU %d%%", gameFps, displayFps,
+                        ps4_perf_gpu);
+        } else {
+            ImGui::Text("Game %.1f FPS", gameFps);
+        }
+    }
+    if (ps4_pad_intercepted()) {
+        ImGui::TextColored(ImVec4(1.0f, 0.6f, 0.3f, 1.0f),
+                           "Controller input held by the PS4 system");
+    }
+    if (ps4_settings.show_fps && ps4_settings.show_stats && ps4_perf_threads[0] != '\0') {
+        ImGui::TextColored(ImVec4(0.7f, 0.7f, 0.7f, 1.0f), "%s", ps4_perf_threads);
+    }
+    ImGui::End();
+}
+
+// --- setup help ------------------------------------------------------------------------------
+
+// Until the BIOS files are in place the Xbox can't start: say where they go
+void DrawSetupHelp()
+{
+    const bool haveBootrom = g_config.sys.files.bootrom_path[0] != '\0' &&
+                             access(g_config.sys.files.bootrom_path, R_OK) == 0;
+    const bool haveFlash = g_config.sys.files.flashrom_path[0] != '\0' &&
+                           access(g_config.sys.files.flashrom_path, R_OK) == 0;
+    const ImVec2 screen = ImGui::GetIO().DisplaySize;
+    if (haveBootrom && haveFlash) {
+        if (ps4_setup_problem != nullptr) {
+            ImGui::SetNextWindowPos(ImVec2(screen.x * 0.5f, screen.y * 0.5f), ImGuiCond_Always,
+                                    ImVec2(0.5f, 0.5f));
+            ImGui::SetNextWindowSize(ImVec2(screen.x * 0.6f, 0.0f));
+            ImGui::Begin("xemu for PS4", nullptr,
+                         ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoMove |
+                             ImGuiWindowFlags_NoResize);
+            ImGui::TextWrapped("%s", ps4_setup_problem);
+            ImGui::End();
+        }
+        return;
+    }
+    ImGui::SetNextWindowPos(ImVec2(screen.x * 0.5f, screen.y * 0.5f), ImGuiCond_Always,
+                            ImVec2(0.5f, 0.5f));
+    ImGui::Begin("xemu for PS4", nullptr,
+                 ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_AlwaysAutoResize |
+                     ImGuiWindowFlags_NoMove);
+    ImGui::TextUnformatted("The Xbox BIOS files are missing.");
+    ImGui::Spacing();
+    ImGui::TextUnformatted("Copy them to /data/xemu/bios on the PS4 (FTP), then restart:");
+    ImGui::BulletText("MCPX boot ROM (512 bytes)%s", haveBootrom ? ": found" : "");
+    ImGui::BulletText("flash BIOS (256 KiB or 1 MiB)%s", haveFlash ? ": found" : "");
+    ImGui::Spacing();
+    ImGui::TextUnformatted("Hard disk image: /data/xemu/hdd/xbox_hdd.qcow2");
+    ImGui::TextUnformatted("Games (.iso): /data/xemu/games");
+    ImGui::End();
+}
+
+// --- the quick menu --------------------------------------------------------------------------
+
+constexpr const char *kGamesDir = "/data/xemu/games";
+
+enum Page { kMain, kGames };
+enum Row {
+    kResume, kGamesRow, kEject, kReset, kScaling, kFilter, kShowFps, kShowStats, kCpuLayout,
+    kResampler, kHrtf, kMonitor, kTlbIndex, kAutoProfile, kAot, kAotRecord, kProfileNow, kQuit,
+    kRowCount
+};
+
+struct Menu
+{
+    Page page = kMain;
+    int row = 0;
+    int gameRow = 0;
+    std::vector<std::string> games;     // file names in kGamesDir
+    // done under the main loop lock (ps4_hud_update): the menu draws without it
+    std::string loadPath;
+    bool eject = false, reset = false, quit = false, pause = false;
+    bool restartNote = false;
+} M;
+
+void ScanGames()
+{
+    M.games.clear();
+    if (DIR *dir = opendir(kGamesDir)) {
+        while (dirent *e = readdir(dir)) {
+            const char *dot = strrchr(e->d_name, '.');
+            if (e->d_name[0] != '.' && dot &&
+                (strcasecmp(dot, ".iso") == 0 || strcasecmp(dot, ".xiso") == 0)) {
+                M.games.emplace_back(e->d_name);
+            }
+        }
+        closedir(dir);
+    }
+    std::sort(M.games.begin(), M.games.end(), [](const std::string &a, const std::string &b) {
+        return strcasecmp(a.c_str(), b.c_str()) < 0;
+    });
+    M.gameRow = std::min(M.gameRow, std::max(0, (int)M.games.size() - 1));
+}
+
+const char *DiscName()
+{
+    const char *p = g_config.sys.files.dvd_path;
+    if (p == nullptr || p[0] == '\0') {
+        return "no disc";
+    }
+    const char *slash = strrchr(p, '/');
+    return slash ? slash + 1 : p;
+}
+
+std::string RowText(int row)
+{
+    static const char *const scaling[] = { "Fit", "Stretch", "Integer" };
+    static const char *const filter[] = { "Smooth", "Sharp" };
+    switch (row) {
+    case kResume: return "Resume";
+    case kGamesRow: return std::string("Games...   (") + DiscName() + ")";
+    case kEject: return "Eject disc";
+    case kReset: return "Reset Xbox";
+    case kScaling: return std::string("Picture          < ") + scaling[ps4_settings.scaling] + " >";
+    case kFilter: return std::string("Filter           < ") + filter[ps4_settings.filter] + " >";
+    case kShowFps: return std::string("Show frame rate  < ") + (ps4_settings.show_fps ? "On" : "Off") + " >";
+    case kShowStats: return std::string("Show load        < ") + (ps4_settings.show_stats ? "On" : "Off") + " >";
+    case kCpuLayout:
+        return std::string("CPU layout       < ") +
+               (ps4_settings.cpu_layout == PS4_CPU_PINNED ? "Pinned" : "Floating") + " >  (restart)";
+    case kResampler:
+        return std::string("Voice resampling < ") + (ps4_settings.audio_resampler ? "Sinc" : "Linear") +
+               " >  (restart)";
+    case kHrtf: return std::string("3D audio (HRTF)  < ") + (g_config.audio.hrtf ? "On" : "Off") + " >";
+    case kMonitor: return std::string("Monitor log      < ") + (ps4_settings.monitor_log ? "On" : "Off") + " >";
+    case kTlbIndex:
+        return std::string("TLB dirty index  < ") + (ps4_settings.tlb_index ? "On" : "Off") + " >  (restart)";
+    case kAutoProfile:
+        return std::string("Auto profile     < ") + (ps4_settings.auto_profile ? "On" : "Off") + " >";
+    case kAot:
+        return std::string("Translated code  < ") + (ps4_settings.aot ? "On" : "Off") + " >  (next game)";
+    case kAotRecord:
+        return std::string("Record for PC    < ") + (ps4_settings.aot_record ? "On" : "Off") +
+               " >  (next game)";
+    case kProfileNow: return "Profile 8 s now (profiles/)";
+    case kQuit: return "Quit xemu";
+    }
+    return "";
+}
+
+void Change(int row, int dir)
+{
+    switch (row) {
+    case kScaling: ps4_settings.scaling = (ps4_settings.scaling + 3 + dir) % 3; break;
+    case kFilter: ps4_settings.filter ^= 1; break;
+    case kShowFps: ps4_settings.show_fps = !ps4_settings.show_fps; break;
+    case kShowStats: ps4_settings.show_stats = !ps4_settings.show_stats; break;
+    case kCpuLayout: ps4_settings.cpu_layout ^= 1; M.restartNote = true; break;
+    case kResampler: ps4_settings.audio_resampler ^= 1; M.restartNote = true; break;
+    case kHrtf: g_config.audio.hrtf = !g_config.audio.hrtf; xemu_settings_save(); return;
+    case kMonitor: ps4_settings.monitor_log = !ps4_settings.monitor_log; break;
+    case kAutoProfile: ps4_settings.auto_profile = !ps4_settings.auto_profile; break;
+    case kTlbIndex: ps4_settings.tlb_index = !ps4_settings.tlb_index; M.restartNote = true; break;
+    case kAot: ps4_settings.aot = !ps4_settings.aot; ps4_settings_apply_aot(); break;
+    case kAotRecord: ps4_settings.aot_record = !ps4_settings.aot_record; ps4_settings_apply_aot(); break;
+    default: return;
+    }
+    ps4_settings_save();
+}
+
+void Activate(int row)
+{
+    switch (row) {
+    case kResume: ps4_menu_open = false; break;
+    case kGamesRow:
+        ps4_menu_open = false;
+        if (ps4_emulation_started) {
+            M.pause = true;     // the game waits while the library is up (ps4_hud_update)
+        }
+        ps4_launcher_open();
+        break;
+    case kEject: M.eject = true; ps4_menu_open = false; break;
+    case kReset: M.reset = true; ps4_menu_open = false; break;
+    case kQuit: M.quit = true; break;
+    case kProfileNow:
+        Queue(ps4_profile_now("menu") ? "Profiling 8 s: /data/xemu/profiles" : "A profile is running", false);
+        ps4_menu_open = false;
+        break;
+    default: Change(row, 1); break;
+    }
+}
+
+void HandleInput()
+{
+    const uint32_t b = ps4_pad_menu_pressed();
+    if (b == 0) {
+        return;
+    }
+    if (M.page == kGames) {
+        const int n = (int)M.games.size();
+        if (b & ORBIS_PAD_BUTTON_UP) M.gameRow = n ? (M.gameRow + n - 1) % n : 0;
+        if (b & ORBIS_PAD_BUTTON_DOWN) M.gameRow = n ? (M.gameRow + 1) % n : 0;
+        if ((b & ORBIS_PAD_BUTTON_CROSS) && n) {
+            M.loadPath = std::string(kGamesDir) + "/" + M.games[M.gameRow];
+            M.page = kMain;
+            ps4_menu_open = false;
+        }
+        if (b & ORBIS_PAD_BUTTON_CIRCLE) M.page = kMain;
+        return;
+    }
+    if (b & ORBIS_PAD_BUTTON_UP) M.row = (M.row + kRowCount - 1) % kRowCount;
+    if (b & ORBIS_PAD_BUTTON_DOWN) M.row = (M.row + 1) % kRowCount;
+    if (b & ORBIS_PAD_BUTTON_LEFT) Change(M.row, -1);
+    if (b & ORBIS_PAD_BUTTON_RIGHT) Change(M.row, 1);
+    if (b & ORBIS_PAD_BUTTON_CROSS) Activate(M.row);
+    if (b & ORBIS_PAD_BUTTON_CIRCLE) ps4_menu_open = false;
+}
+
+void DrawRow(ImDrawList *dl, ImVec2 pos, float width, const std::string &text, bool selected)
+{
+    const float h = ImGui::GetTextLineHeightWithSpacing() + 8.0f;
+    if (selected) {
+        dl->AddRectFilled(pos, ImVec2(pos.x + width, pos.y + h), IM_COL32(16, 124, 16, 230), 6.0f);
+    }
+    dl->AddText(ImVec2(pos.x + 16.0f, pos.y + 4.0f), selected ? IM_COL32_WHITE : IM_COL32(220, 220, 220, 255),
+                text.c_str());
+}
+
+void DrawMenu()
+{
+    HandleInput();
+    if (!ps4_menu_open) {
+        M.page = kMain;
+        return;
+    }
+    const ImVec2 screen = ImGui::GetIO().DisplaySize;
+    const float width = screen.x * 0.42f;
+    const float rowH = ImGui::GetTextLineHeightWithSpacing() + 8.0f;
+    ImDrawList *dl = ImGui::GetForegroundDrawList();
+    dl->AddRectFilled(ImVec2(0, 0), ImVec2(width + 64.0f, screen.y), IM_COL32(8, 12, 8, 225));
+    ImVec2 pos(32.0f, 48.0f);
+    dl->AddText(pos, IM_COL32(120, 220, 90, 255), M.page == kGames ? "xemu  -  Load game" : "xemu  -  Quick menu");
+    pos.y += rowH * 1.5f;
+    if (M.page == kGames) {
+        if (M.games.empty()) {
+            dl->AddText(ImVec2(pos.x + 16.0f, pos.y), IM_COL32(220, 220, 220, 255),
+                        "No .iso files in /data/xemu/games");
+        }
+        const int visible = (int)((screen.y - pos.y - 120.0f) / rowH);
+        const int first = std::max(0, std::min(M.gameRow - visible / 2, (int)M.games.size() - visible));
+        for (int i = first; i < (int)M.games.size() && i < first + visible; i++) {
+            DrawRow(dl, pos, width, M.games[i], i == M.gameRow);
+            pos.y += rowH;
+        }
+    } else {
+        for (int i = 0; i < kRowCount; i++) {
+            DrawRow(dl, pos, width, RowText(i), i == M.row);
+            pos.y += rowH;
+        }
+        if (M.restartNote) {
+            pos.y += rowH * 0.5f;
+            dl->AddText(ImVec2(pos.x + 16.0f, pos.y), IM_COL32(255, 200, 80, 255),
+                        "Takes effect at the next start");
+        }
+        pos.y += rowH;
+        char line[96];
+        snprintf(line, sizeof(line), "CPU %u MHz", ps4_kit_cpu_mhz());
+        dl->AddText(ImVec2(pos.x + 16.0f, pos.y), IM_COL32(160, 160, 160, 255), line);
+    }
+    dl->AddText(ImVec2(48.0f, screen.y - 72.0f), IM_COL32(160, 160, 160, 255),
+                M.page == kGames ? "Cross: load   Circle: back" : "Cross: select   Left/Right: change   Circle: close   L3+R3: menu");
+}
+} // namespace
+
+bool ps4_menu_open;
+
+extern "C" void xemu_queue_notification(const char *msg)
+{
+    fprintf(stderr, "notification: %s\n", msg);
+    Queue(msg, false);
+}
+
+extern "C" void xemu_queue_error_message(const char *msg)
+{
+    fprintf(stderr, "error: %s\n", msg);
+    Queue(msg, true);
+}
+
+extern "C" void ps4_hud_process_sdl_event(const SDL_Event *event)
+{
+    (void)event;
+}
+
+/* the menu's actions that need the emulator: here, under the main loop lock */
+extern "C" void ps4_hud_update(void)
+{
+    if (!M.loadPath.empty()) {
+        const bool ok = ps4_load_disc(M.loadPath.c_str());
+        Queue(ok ? (std::string("Disc: ") + DiscName()).c_str() : "Couldn't load the disc", !ok);
+        M.loadPath.clear();
+    }
+    if (const char *pick = ps4_launcher_take_pick()) {
+        const bool ok = ps4_launch_game(pick);
+        Queue(ok ? (std::string("Starting ") + DiscName()).c_str() : "Couldn't start the game", !ok);
+    }
+    if (M.pause) {
+        ps4_pause_emulation(true);
+        M.pause = false;
+    }
+    if (M.eject) {
+        ps4_eject_disc();
+        M.eject = false;
+    }
+    if (M.reset) {
+        ps4_request_reset();
+        M.reset = false;
+    }
+    if (M.quit) {
+        ps4_request_quit();
+        M.quit = false;
+    }
+}
+
+extern "C" void ps4_hud_open_games(void)
+{
+    ScanGames();
+    M.page = kGames;
+    ps4_menu_open = true;
+}
+
+extern "C" void ps4_hud_draw(void)
+{
+    const bool library = ps4_launcher_draw();
+    if (!library) {
+        DrawPerformance();
+    }
+    DrawSetupHelp();
+    DrawMenu();
+    DrawNotification();
+}
diff --git a/ui/ps4/ps4-launcher.cc b/ui/ps4/ps4-launcher.cc
new file mode 100644
index 0000000..a80721c
--- /dev/null
+++ b/ui/ps4/ps4-launcher.cc
@@ -0,0 +1,699 @@
+/*
+ * xemu-ps4: the game library - the first screen at start (Settings: boot_launcher) and the quick
+ * menu's "Games". The Xbox waits stopped (QEMU's -S) until a game is picked; then the disc goes in
+ * and it starts (xemu-ps4.c ps4_launch_game), so the BIOS boots straight into the game.
+ *
+ * Each game in /data/xemu/games (.iso: redump images or XISO) is read for its default.xbe: the title
+ * name and ID from the certificate, and the title image the Xbox dashboard shows (the "$$XTIMAGE"
+ * section, an XPR texture: DXT1/3/5 or 32-bit). A picture of the user's own in /data/xemu/covers
+ * (<iso name>.png or .jpg: box art) wins. Results are cached in /data/xemu/covers/cache.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "ps4-frontend.h"
+#include "ps4-settings.h"
+#include "ui/xemu-settings.h"
+
+#include "imgui.h"
+
+#define STB_IMAGE_IMPLEMENTATION
+#define STB_IMAGE_STATIC
+#define STBI_ONLY_PNG
+#define STBI_ONLY_JPEG
+#define STBI_NO_STDIO_SUPPORT_EXCEPT_FILE
+#include "ui/thirdparty/stb_image/stb_image.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cfloat>
+#include <cmath>
+#include <cstring>
+#include <dirent.h>
+#include <fcntl.h>
+#include <mutex>
+#include <string>
+#include <strings.h>
+#include <sys/stat.h>
+#include <thread>
+#include <unistd.h>
+#include <vector>
+
+#include <orbis/Pad.h>
+
+namespace
+{
+constexpr const char *kGames = "/data/xemu/games";
+constexpr const char *kCovers = "/data/xemu/covers";
+constexpr const char *kCache = "/data/xemu/covers/cache";
+
+struct Game
+{
+    std::string path, file, stem, title, titleId;
+    uint32_t titleIdRaw = 0;        // the certificate's title ID (the translated code's name)
+    std::vector<uint8_t> rgba;      // the cover, until it is a texture
+    int w = 0, h = 0;
+    ImTextureID tex = 0;
+    bool userCover = false;
+};
+
+std::mutex sLock;
+std::vector<Game> sGames;           // guarded by sLock while the scan runs
+std::atomic<bool> sScanning { false };
+std::atomic<bool> sScanned { false };
+int sSel = 0;
+float sScroll = 0.0f;               // the carousel's position, easing to sSel
+const char *sPick = nullptr;        // the game to start (ps4_hud_update takes it)
+std::string sPickPath;
+bool sOpenedInGame = false;         // opened from the quick menu over a running game
+
+uint32_t rd32(const uint8_t *p)
+{
+    return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+uint16_t rd16(const uint8_t *p)
+{
+    return p[0] | p[1] << 8;
+}
+
+bool ReadAt(int fd, uint64_t off, void *buf, size_t len)
+{
+    return pread(fd, buf, len, (off_t)off) == (ssize_t)len;
+}
+
+// --- XDVDFS: the game partition and a file in its root ----------------------------------------
+
+// The partition's offset: 0 for an XISO, else the redump layouts (XGD1, XGD2, XGD3)
+bool FindPartition(int fd, uint64_t *base)
+{
+    static const uint64_t offsets[] = { 0, 0x18300000ull, 0xFD90000ull, 0x2080000ull };
+    for (uint64_t o : offsets) {
+        char magic[20];
+        if (ReadAt(fd, o + 0x10000, magic, sizeof(magic)) && memcmp(magic, "MICROSOFT*XBOX*MEDIA", 20) == 0) {
+            *base = o;
+            return true;
+        }
+    }
+    return false;
+}
+
+// The directory is a binary tree of entries: left/right child offsets (in 4-byte units, 0 none),
+// start sector, size, attributes, name length, name
+bool FindInDir(const std::vector<uint8_t> &dir, size_t off, const char *name, uint32_t *sector,
+               uint32_t *size, int depth)
+{
+    if (depth > 64 || off + 14 > dir.size()) {
+        return false;
+    }
+    const uint8_t *e = dir.data() + off;
+    const uint16_t left = rd16(e), right = rd16(e + 2);
+    if (left == 0xFFFF) {
+        return false;
+    }
+    const uint8_t len = e[13];
+    if (off + 14 + len <= dir.size() && len == strlen(name) && strncasecmp((const char *)e + 14, name, len) == 0) {
+        *sector = rd32(e + 4);
+        *size = rd32(e + 8);
+        return true;
+    }
+    return (left && FindInDir(dir, left * 4u, name, sector, size, depth + 1)) ||
+           (right && FindInDir(dir, right * 4u, name, sector, size, depth + 1));
+}
+
+// --- XPR textures (the XBE's title image) ---------------------------------------------------------
+
+void Rgb565(uint16_t c, uint8_t *o)
+{
+    o[0] = ((c >> 11) & 31) * 255 / 31;
+    o[1] = ((c >> 5) & 63) * 255 / 63;
+    o[2] = (c & 31) * 255 / 31;
+}
+
+// One 4x4 colour block of DXT1 (with its 1-bit alpha) or of DXT3/5 (always four colours)
+void DxtColour(const uint8_t *b, bool dxt1, uint8_t out[16][4])
+{
+    const uint16_t c0 = rd16(b), c1 = rd16(b + 2);
+    uint8_t pal[4][4] = {};
+    Rgb565(c0, pal[0]);
+    Rgb565(c1, pal[1]);
+    pal[0][3] = pal[1][3] = 255;
+    for (int i = 0; i < 3; i++) {
+        if (!dxt1 || c0 > c1) {
+            pal[2][i] = (2 * pal[0][i] + pal[1][i]) / 3;
+            pal[3][i] = (pal[0][i] + 2 * pal[1][i]) / 3;
+        } else {
+            pal[2][i] = (pal[0][i] + pal[1][i]) / 2;
+            pal[3][i] = 0;
+        }
+    }
+    pal[2][3] = 255;
+    pal[3][3] = (!dxt1 || c0 > c1) ? 255 : 0;
+    const uint32_t idx = rd32(b + 4);
+    for (int p = 0; p < 16; p++) {
+        memcpy(out[p], pal[(idx >> (2 * p)) & 3], 4);
+    }
+}
+
+void DxtAlpha5(const uint8_t *b, uint8_t out[16][4])
+{
+    uint8_t a[8] = { b[0], b[1] };
+    if (a[0] > a[1]) {
+        for (int i = 1; i < 7; i++) {
+            a[i + 1] = ((7 - i) * a[0] + i * a[1]) / 7;
+        }
+    } else {
+        for (int i = 1; i < 5; i++) {
+            a[i + 1] = ((5 - i) * a[0] + i * a[1]) / 5;
+        }
+        a[6] = 0;
+        a[7] = 255;
+    }
+    uint64_t bits = 0;
+    for (int i = 0; i < 6; i++) {
+        bits |= (uint64_t)b[2 + i] << (8 * i);
+    }
+    for (int p = 0; p < 16; p++) {
+        out[p][3] = a[(bits >> (3 * p)) & 7];
+    }
+}
+
+// The NV2A's swizzle (Morton order; the larger side's remaining bits follow): texel index of x, y
+uint32_t Swizzle(uint32_t x, uint32_t y, uint32_t w, uint32_t h)
+{
+    uint32_t out = 0, bit = 0;
+    for (uint32_t m = 1; m < w || m < h; m <<= 1) {
+        if (m < w) {
+            out |= ((x & m) ? 1u : 0u) << bit++;
+        }
+        if (m < h) {
+            out |= ((y & m) ? 1u : 0u) << bit++;
+        }
+    }
+    return out;
+}
+
+bool DecodeXpr(const uint8_t *x, size_t n, Game &g)
+{
+    if (n < 32 || memcmp(x, "XPR0", 4) != 0) {
+        return false;
+    }
+    const uint32_t hdr = rd32(x + 8);
+    const uint32_t data = rd32(x + 16), format = rd32(x + 24), size = rd32(x + 28);
+    const uint32_t fmt = (format >> 8) & 0xff;
+    int w, h;
+    if (size) {
+        w = (size & 0xfff) + 1;
+        h = ((size >> 12) & 0xfff) + 1;
+    } else {
+        w = 1 << ((format >> 20) & 0xf);
+        h = 1 << ((format >> 24) & 0xf);
+    }
+    if (w > 1024 || h > 1024 || (uint64_t)hdr + data >= n) {
+        return false;
+    }
+    const uint8_t *px = x + hdr + data;
+    const size_t avail = n - hdr - data;
+    std::vector<uint8_t> out((size_t)w * h * 4);
+    switch (fmt) {
+    case 0x0C: case 0x0E: case 0x0F: {   // DXT1, DXT2/3, DXT4/5
+        const size_t blockBytes = fmt == 0x0C ? 8 : 16;
+        if (avail < (size_t)(w / 4) * (h / 4) * blockBytes) {
+            return false;
+        }
+        for (int by = 0; by < h / 4; by++) {
+            for (int bx = 0; bx < w / 4; bx++) {
+                const uint8_t *b = px + ((size_t)by * (w / 4) + bx) * blockBytes;
+                uint8_t texel[16][4];
+                if (fmt == 0x0C) {
+                    DxtColour(b, true, texel);
+                } else {
+                    DxtColour(b + 8, false, texel);
+                    if (fmt == 0x0E) {
+                        for (int p = 0; p < 16; p++) {
+                            texel[p][3] = ((b[p / 2] >> (4 * (p & 1))) & 15) * 17;
+                        }
+                    } else {
+                        DxtAlpha5(b, texel);
+                    }
+                }
+                for (int p = 0; p < 16; p++) {
+                    memcpy(&out[(((size_t)by * 4 + p / 4) * w + bx * 4 + p % 4) * 4], texel[p], 4);
+                }
+            }
+        }
+        break;
+    }
+    case 0x06: case 0x07: case 0x12: case 0x1E: {   // A8R8G8B8 / X8R8G8B8, swizzled or linear
+        if (avail < (size_t)w * h * 4) {
+            return false;
+        }
+        const bool linear = fmt >= 0x10;
+        for (int y = 0; y < h; y++) {
+            for (int xx = 0; xx < w; xx++) {
+                const uint8_t *s = px + (size_t)(linear ? y * w + xx : Swizzle(xx, y, w, h)) * 4;
+                uint8_t *d = &out[((size_t)y * w + xx) * 4];
+                d[0] = s[2];
+                d[1] = s[1];
+                d[2] = s[0];
+                d[3] = (fmt == 0x07 || fmt == 0x1E) ? 255 : s[3];
+            }
+        }
+        break;
+    }
+    default:
+        return false;
+    }
+    g.rgba.swap(out);
+    g.w = w;
+    g.h = h;
+    return true;
+}
+
+// --- default.xbe: title, title ID, title image ---------------------------------------------------
+
+void ReadXbe(int fd, uint64_t xbeOff, uint32_t xbeSize, Game &g)
+{
+    std::vector<uint8_t> head(std::min<uint32_t>(xbeSize, 0x10000));
+    if (head.size() < 0x180 || !ReadAt(fd, xbeOff, head.data(), head.size()) || memcmp(head.data(), "XBEH", 4) != 0) {
+        return;
+    }
+    const uint32_t base = rd32(&head[0x104]);
+    const uint32_t certAddr = rd32(&head[0x118]);
+    const uint32_t numSections = rd32(&head[0x11C]);
+    const uint32_t secAddr = rd32(&head[0x120]);
+    const uint32_t cert = certAddr - base;
+    if (cert + 0x5C <= head.size()) {
+        char tid[16];
+        const uint32_t id = rd32(&head[cert + 8]);
+        g.titleIdRaw = id;
+        snprintf(tid, sizeof(tid), "%c%c-%03u", (char)(id >> 24), (char)((id >> 16) & 0xff), id & 0xffff);
+        g.titleId = tid;
+        std::string name;
+        for (int i = 0; i < 40; i++) {
+            const uint16_t c = rd16(&head[cert + 0xC + i * 2]);
+            if (c == 0) {
+                break;
+            }
+            if (c < 0x80) {
+                name += (char)c;
+            } else if (c < 0x800) {
+                name += (char)(0xC0 | (c >> 6));
+                name += (char)(0x80 | (c & 0x3F));
+            } else {
+                name += (char)(0xE0 | (c >> 12));
+                name += (char)(0x80 | ((c >> 6) & 0x3F));
+                name += (char)(0x80 | (c & 0x3F));
+            }
+        }
+        if (!name.empty()) {
+            g.title = name;
+        }
+    }
+    const uint32_t sec = secAddr - base;
+    for (uint32_t i = 0; i < numSections && i < 128 && sec + (i + 1) * 0x38 <= head.size(); i++) {
+        const uint8_t *s = &head[sec + i * 0x38];
+        const uint32_t raw = rd32(s + 0xC), rawSize = rd32(s + 0x10), nameAddr = rd32(s + 0x14);
+        const uint32_t nameOff = nameAddr - base;
+        if (nameOff + 10 > head.size() || memcmp(&head[nameOff], "$$XTIMAGE", 10) != 0) {
+            continue;
+        }
+        if (rawSize == 0 || rawSize > (4u << 20) || (uint64_t)raw + rawSize > xbeSize) {
+            return;
+        }
+        std::vector<uint8_t> img(rawSize);
+        if (ReadAt(fd, xbeOff + raw, img.data(), rawSize)) {
+            DecodeXpr(img.data(), img.size(), g);
+        }
+        return;
+    }
+}
+
+void ReadIso(Game &g)
+{
+    const int fd = open(g.path.c_str(), O_RDONLY);
+    if (fd < 0) {
+        return;
+    }
+    uint64_t base;
+    uint8_t vd[28];
+    if (FindPartition(fd, &base) && ReadAt(fd, base + 0x10000, vd, sizeof(vd))) {
+        const uint32_t rootSector = rd32(vd + 20), rootSize = rd32(vd + 24);
+        std::vector<uint8_t> dir(std::min<uint32_t>(rootSize, 1u << 20));
+        uint32_t sector, size;
+        if (!dir.empty() && ReadAt(fd, base + (uint64_t)rootSector * 2048, dir.data(), dir.size()) &&
+            FindInDir(dir, 0, "default.xbe", &sector, &size, 0)) {
+            ReadXbe(fd, base + (uint64_t)sector * 2048, size, g);
+        }
+    }
+    close(fd);
+}
+
+// --- the cache: title, ID and the cover's pixels, valid for the ISO's size and time ---------------
+
+std::string CachePath(const Game &g)
+{
+    return std::string(kCache) + "/" + g.stem + ".bin";
+}
+
+bool LoadCache(Game &g, const struct stat &st)
+{
+    FILE *f = fopen(CachePath(g).c_str(), "rb");
+    if (!f) {
+        return false;
+    }
+    uint32_t h[8];
+    bool ok = fread(h, sizeof(h), 1, f) == 1 && h[0] == 0x31564358 /* XCV1 */ &&
+              h[1] == (uint32_t)st.st_size && h[2] == (uint32_t)(st.st_size >> 32) &&
+              h[3] == (uint32_t)st.st_mtime && h[6] < 256 && h[7] < 32 && h[4] <= 1024 && h[5] <= 1024;
+    if (ok) {
+        std::string title(h[6], '\0'), tid(h[7], '\0');
+        ok = (h[6] == 0 || fread(&title[0], h[6], 1, f) == 1) && (h[7] == 0 || fread(&tid[0], h[7], 1, f) == 1);
+        g.w = h[4];
+        g.h = h[5];
+        g.rgba.resize((size_t)g.w * g.h * 4);
+        ok = ok && (g.rgba.empty() || fread(g.rgba.data(), g.rgba.size(), 1, f) == 1);
+        if (ok) {
+            if (!title.empty()) {
+                g.title = title;
+            }
+            g.titleId = tid;
+        }
+    }
+    fclose(f);
+    if (!ok) {
+        g.rgba.clear();
+        g.w = g.h = 0;
+    }
+    return ok;
+}
+
+void SaveCache(const Game &g, const struct stat &st)
+{
+    mkdir(kCovers, 0777);
+    mkdir(kCache, 0777);
+    FILE *f = fopen(CachePath(g).c_str(), "wb");
+    if (!f) {
+        return;
+    }
+    const uint32_t h[8] = { 0x31564358, (uint32_t)st.st_size, (uint32_t)(st.st_size >> 32), (uint32_t)st.st_mtime,
+                            (uint32_t)g.w, (uint32_t)g.h, (uint32_t)std::min<size_t>(g.title.size(), 255),
+                            (uint32_t)std::min<size_t>(g.titleId.size(), 31) };
+    fwrite(h, sizeof(h), 1, f);
+    fwrite(g.title.data(), h[6], 1, f);
+    fwrite(g.titleId.data(), h[7], 1, f);
+    if (!g.rgba.empty()) {
+        fwrite(g.rgba.data(), g.rgba.size(), 1, f);
+    }
+    fclose(f);
+}
+
+// The user's box art: /data/xemu/covers/<iso name>.png / .jpg
+bool LoadUserCover(Game &g)
+{
+    static const char *const exts[] = { ".png", ".jpg", ".jpeg", ".PNG", ".JPG" };
+    for (const char *e : exts) {
+        const std::string p = std::string(kCovers) + "/" + g.stem + e;
+        int w, h, n;
+        stbi_uc *px = stbi_load(p.c_str(), &w, &h, &n, 4);
+        if (px) {
+            // large pictures shrink to at most 512 a side (point sampling: it is only a cover)
+            int tw = w, th = h;
+            while (tw > 512 || th > 512) {
+                tw /= 2;
+                th /= 2;
+            }
+            g.rgba.resize((size_t)tw * th * 4);
+            for (int y = 0; y < th; y++) {
+                for (int x = 0; x < tw; x++) {
+                    memcpy(&g.rgba[((size_t)y * tw + x) * 4], px + ((size_t)(y * h / th) * w + x * w / tw) * 4, 4);
+                }
+            }
+            g.w = tw;
+            g.h = th;
+            g.userCover = true;
+            stbi_image_free(px);
+            return true;
+        }
+    }
+    return false;
+}
+
+void ScanGames()
+{
+    std::vector<std::string> files;
+    if (DIR *d = opendir(kGames)) {
+        while (dirent *e = readdir(d)) {
+            const char *dot = strrchr(e->d_name, '.');
+            if (e->d_name[0] != '.' && dot && (strcasecmp(dot, ".iso") == 0 || strcasecmp(dot, ".xiso") == 0)) {
+                files.emplace_back(e->d_name);
+            }
+        }
+        closedir(d);
+    }
+    std::sort(files.begin(), files.end(), [](const std::string &a, const std::string &b) {
+        return strcasecmp(a.c_str(), b.c_str()) < 0;
+    });
+    for (const std::string &f : files) {
+        Game g;
+        g.file = f;
+        g.path = std::string(kGames) + "/" + f;
+        g.stem = f.substr(0, f.rfind('.'));
+        g.title = g.stem;
+        struct stat st;
+        if (stat(g.path.c_str(), &st) == 0) {
+            if (!LoadCache(g, st)) {
+                ReadIso(g);
+                SaveCache(g, st);
+            }
+        }
+        Game user = g;
+        if (LoadUserCover(user)) {
+            g.rgba.swap(user.rgba);
+            g.w = user.w;
+            g.h = user.h;
+            g.userCover = true;
+        }
+        std::lock_guard<std::mutex> lock(sLock);
+        sGames.push_back(std::move(g));
+    }
+}
+
+void StartScan()
+{
+    if (sScanning.exchange(true)) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(sLock);
+        sGames.clear();
+    }
+    sScanned = false;
+    std::thread([] {
+        ScanGames();
+        sScanned = true;
+        sScanning = false;
+    }).detach();
+}
+
+// --- drawing ---------------------------------------------------------------------------------
+
+constexpr ImU32 kGreen = IM_COL32(16, 124, 16, 255);
+constexpr ImU32 kLime = IM_COL32(155, 240, 11, 255);
+
+void Glow(ImDrawList *dl, ImVec2 c, float r, ImU32 rgb, float alpha)
+{
+    for (int i = 12; i >= 1; i--) {
+        const float t = i / 12.0f;
+        dl->AddCircleFilled(c, r * t, (rgb & 0x00FFFFFF) | ((ImU32)(alpha * (1.0f - t) * 40.0f) << 24), 64);
+    }
+}
+
+void DrawCard(ImDrawList *dl, const Game &g, ImVec2 center, float scale, bool selected)
+{
+    const float cw = 300.0f * scale, ch = 420.0f * scale;
+    const ImVec2 a(center.x - cw / 2, center.y - ch / 2), b(center.x + cw / 2, center.y + ch / 2);
+    if (selected) {
+        for (int i = 6; i >= 1; i--) {
+            dl->AddRect(ImVec2(a.x - i * 3, a.y - i * 3), ImVec2(b.x + i * 3, b.y + i * 3),
+                        IM_COL32(155, 240, 11, 18 * (7 - i)), 18.0f + i * 3, 0, 3.0f);
+        }
+    }
+    dl->AddRectFilledMultiColor(a, b, IM_COL32(28, 34, 30, 255), IM_COL32(28, 34, 30, 255),
+                                IM_COL32(10, 14, 11, 255), IM_COL32(10, 14, 11, 255));
+    if (g.tex) {
+        // the picture as large as fits the card, its own aspect ratio
+        const float pad = 12.0f * scale;
+        const float aw = cw - 2 * pad, ah = ch - 2 * pad;
+        const float s = std::min(aw / g.w, ah / g.h);
+        const float iw = g.w * s, ih = g.h * s;
+        const ImVec2 ia(center.x - iw / 2, center.y - ih / 2);
+        dl->AddImageRounded(g.tex, ia, ImVec2(ia.x + iw, ia.y + ih), ImVec2(0, 0), ImVec2(1, 1),
+                            IM_COL32_WHITE, 10.0f * scale);
+    } else {
+        // no picture: the title on the card
+        ImFont *f = ps4_font_title ? ps4_font_title : ImGui::GetFont();
+        const float fs = f->FontSize * 0.6f * scale;
+        dl->AddText(f, fs, ImVec2(a.x + 20 * scale, center.y - fs), IM_COL32(220, 230, 220, 255), g.title.c_str(),
+                    nullptr, cw - 40 * scale);
+    }
+    dl->AddRect(a, b, selected ? kLime : IM_COL32(60, 70, 62, 255), 14.0f * scale, 0, selected ? 4.0f : 2.0f);
+    if (!selected) {
+        dl->AddRectFilled(a, b, IM_COL32(0, 0, 0, 110), 14.0f * scale);
+    }
+}
+
+void HandleInput(int count)
+{
+    if (ps4_menu_open) {
+        return;     // the quick menu (L3+R3) is over the library and takes the buttons
+    }
+    const uint32_t btn = ps4_pad_menu_pressed();
+    if (count > 0) {
+        if (btn & ORBIS_PAD_BUTTON_LEFT) {
+            sSel = (sSel + count - 1) % count;
+        }
+        if (btn & ORBIS_PAD_BUTTON_RIGHT) {
+            sSel = (sSel + 1) % count;
+        }
+        if (btn & ORBIS_PAD_BUTTON_L1) {
+            sSel = std::max(0, sSel - 5);
+        }
+        if (btn & ORBIS_PAD_BUTTON_R1) {
+            sSel = std::min(count - 1, sSel + 5);
+        }
+        if (btn & ORBIS_PAD_BUTTON_CROSS) {
+            std::lock_guard<std::mutex> lock(sLock);
+            sPickPath = sGames[sSel].path;
+            sPick = sPickPath.c_str();
+            ps4_launcher_active = false;
+        }
+    }
+    if (btn & ORBIS_PAD_BUTTON_TRIANGLE) {
+        // rescan (and re-read every game: the cache is only skipped for changed files)
+        StartScan();
+    }
+    if ((btn & ORBIS_PAD_BUTTON_CIRCLE) && sOpenedInGame) {
+        ps4_launcher_active = false;    // back to the game
+        ps4_pause_emulation(false);
+    }
+    if (btn & ORBIS_PAD_BUTTON_OPTIONS) {
+        ps4_menu_open = true;           // settings: the quick menu over the library
+    }
+}
+} // namespace
+
+bool ps4_launcher_active;
+
+void ps4_launcher_open(void)
+{
+    sOpenedInGame = ps4_emulation_started;
+    ps4_launcher_active = true;
+    if (!sScanned && !sScanning) {
+        StartScan();
+    }
+}
+
+const char *ps4_launcher_take_pick(void)
+{
+    const char *p = sPick;
+    sPick = nullptr;
+    return p;
+}
+
+bool ps4_launcher_draw(void)
+{
+    if (!ps4_launcher_active) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(sLock);
+    const int count = (int)sGames.size();
+    if (sSel >= count) {
+        sSel = std::max(0, count - 1);
+    }
+    // covers to textures, a few a frame
+    int uploads = 0;
+    for (Game &g : sGames) {
+        if (!g.tex && !g.rgba.empty() && uploads < 3) {
+            g.tex = (ImTextureID)ps4_present_texture(g.rgba.data(), g.w, g.h);
+            std::vector<uint8_t>().swap(g.rgba);
+            uploads++;
+        }
+    }
+    sLock.unlock();
+    HandleInput(count);
+    sLock.lock();
+
+    const ImVec2 screen = ImGui::GetIO().DisplaySize;
+    ImDrawList *dl = ImGui::GetBackgroundDrawList();
+    // the backdrop: black to a deep green, the dashboard's glow in the middle
+    dl->AddRectFilledMultiColor(ImVec2(0, 0), screen, IM_COL32(2, 8, 3, 255), IM_COL32(2, 8, 3, 255),
+                                IM_COL32(4, 30, 8, 255), IM_COL32(4, 30, 8, 255));
+    Glow(dl, ImVec2(screen.x * 0.5f, screen.y * 0.46f), screen.y * 0.75f, kGreen, 1.0f);
+    // the x in a circle, and the title
+    const ImVec2 logo(110.0f, 96.0f);
+    dl->AddCircleFilled(logo, 40.0f, kGreen, 48);
+    dl->AddCircle(logo, 40.0f, kLime, 48, 3.0f);
+    dl->AddLine(ImVec2(logo.x - 18, logo.y - 18), ImVec2(logo.x + 18, logo.y + 18), IM_COL32_WHITE, 8.0f);
+    dl->AddLine(ImVec2(logo.x + 18, logo.y - 18), ImVec2(logo.x - 18, logo.y + 18), IM_COL32_WHITE, 8.0f);
+    ImFont *big = ps4_font_title ? ps4_font_title : ImGui::GetFont();
+    ImFont *small = ps4_font_small ? ps4_font_small : ImGui::GetFont();
+    dl->AddText(big, big->FontSize, ImVec2(170.0f, 60.0f), IM_COL32_WHITE, "xemu");
+    char countText[64];
+    snprintf(countText, sizeof(countText), sScanning ? "Reading games... %d" : "%d games", count);
+    dl->AddText(small, small->FontSize, ImVec2(174.0f, 60.0f + big->FontSize), IM_COL32(160, 200, 160, 255), countText);
+
+    if (count == 0) {
+        const char *msg = sScanning ? "Looking for games..." : "Put your Xbox games (.iso) in /data/xemu/games";
+        const ImVec2 ts = big->CalcTextSizeA(big->FontSize * 0.7f, FLT_MAX, 0.0f, msg);
+        dl->AddText(big, big->FontSize * 0.7f, ImVec2((screen.x - ts.x) / 2, screen.y * 0.45f), IM_COL32_WHITE, msg);
+    } else {
+        // the carousel: the picked game in the middle, larger
+        sScroll += (sSel - sScroll) * 0.2f;
+        const float spacing = 340.0f;
+        const float cy = screen.y * 0.46f;
+        for (int pass = 0; pass < 2; pass++) {   // the others first, the selected one on top
+            for (int i = 0; i < count; i++) {
+                const bool sel = i == sSel;
+                if ((pass == 1) != sel) {
+                    continue;
+                }
+                const float dx = (i - sScroll) * spacing;
+                if (std::fabs(dx) > screen.x) {
+                    continue;
+                }
+                const float t = std::min(1.0f, std::fabs(i - sScroll));
+                DrawCard(dl, sGames[i], ImVec2(screen.x * 0.5f + dx, cy), 1.18f - 0.3f * t, sel);
+            }
+        }
+        const Game &g = sGames[sSel];
+        const ImVec2 ts = big->CalcTextSizeA(big->FontSize, FLT_MAX, 0.0f, g.title.c_str());
+        dl->AddText(big, big->FontSize, ImVec2((screen.x - ts.x) / 2, cy + 280.0f), IM_COL32_WHITE, g.title.c_str());
+        std::string sub = g.titleId.empty() ? g.file : g.titleId + "   " + g.file;
+        const ImVec2 ss = small->CalcTextSizeA(small->FontSize, FLT_MAX, 0.0f, sub.c_str());
+        dl->AddText(small, small->FontSize, ImVec2((screen.x - ss.x) / 2, cy + 290.0f + big->FontSize),
+                    IM_COL32(150, 190, 150, 255), sub.c_str());
+    }
+    // the blade along the bottom: what the buttons do
+    const float by = screen.y - 84.0f;
+    dl->AddRectFilledMultiColor(ImVec2(0, by), ImVec2(screen.x, screen.y), kGreen, IM_COL32(9, 80, 9, 255),
+                                IM_COL32(9, 80, 9, 255), kGreen);
+    dl->AddLine(ImVec2(0, by), ImVec2(screen.x, by), kLime, 3.0f);
+    const char *hints = sOpenedInGame
+                            ? "Cross  Play        Circle  Back to the game        Triangle  Refresh        Options  Settings"
+                            : "Cross  Play        L1 / R1  Page        Triangle  Refresh        Options  Settings";
+    dl->AddText(ImGui::GetFont(), ImGui::GetFontSize(), ImVec2(64.0f, by + 24.0f), IM_COL32_WHITE, hints);
+    return true;
+}
+
+/* the game's title ID for the translated code (xemu-ps4.c ps4_launch_game) */
+extern "C" uint32_t ps4_iso_title_id(const char *path)
+{
+    Game g;
+    g.path = path;
+    ReadIso(g);
+    return g.titleIdRaw;
+}
diff --git a/ui/ps4/ps4-live.c b/ui/ps4/ps4-live.c
new file mode 100644
index 0000000..6a073f9
--- /dev/null
+++ b/ui/ps4/ps4-live.c
@@ -0,0 +1,233 @@
+/*
+ * xemu-ps4: the live console - a TCP port on the PS4 (ps4.ini live_port, default 4445; 0 = off)
+ * to look into and steer the running emulator from a PC (scripts/live.py). One client at a time,
+ * one command per line; every answer ends with a line holding a single ".".
+ *
+ *   help                 the commands
+ *   stats                the monitor's last line (frame rates, thread loads, main loop, TLB)
+ *   hmp <command>        a QEMU monitor command: info registers, x/64xb $eip, xp, info tlb,
+ *                        info mtree, stop, cont, system_reset, ... (as in xemu's desktop monitor)
+ *   mem <addr> [len]     guest physical memory, hex (len up to 4096, default 64)
+ *   profile [seconds]    a CPU profile of the emulation threads (profiles/profile_N.txt)
+ *   dump                 every thread's call stack into hang.log
+ *   get [key]            ps4.ini settings (all of them without a key)
+ *   set <key> <value>    change one (the live ones apply at once; see ps4-settings.h)
+ *   quit                 close the connection
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/thread.h"
+#include "qemu/main-loop.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-misc.h"
+#include "exec/cpu-common.h"
+#include "system/memory.h"
+#include "exec/tb-flush.h"
+#include "system/runstate.h"
+#include "exec/aot.h"
+#include "ps4-frontend.h"
+#include "ps4-settings.h"
+#include "ps4_kit_diag.h"
+
+#include <netinet/in.h>
+#include <sys/socket.h>
+
+char ps4_live_last_monitor[1024];
+
+static int live_port;
+
+static void send_all(int fd, const char *s, size_t n)
+{
+    while (n > 0) {
+        ssize_t w = send(fd, s, n, 0);
+        if (w <= 0) {
+            return;
+        }
+        s += w;
+        n -= w;
+    }
+}
+
+static void reply(int fd, GString *out)
+{
+    if (out->len == 0 || out->str[out->len - 1] != '\n') {
+        g_string_append_c(out, '\n');
+    }
+    g_string_append(out, ".\n");
+    send_all(fd, out->str, out->len);
+}
+
+static void cmd_hmp(GString *out, const char *line)
+{
+    Error *err = NULL;
+    bql_lock();
+    char *text = qmp_human_monitor_command(line, false, 0, &err);
+    bql_unlock();
+    if (err) {
+        g_string_append_printf(out, "error: %s\n", error_get_pretty(err));
+        error_free(err);
+    }
+    if (text) {
+        g_string_append(out, text);
+        g_free(text);
+    }
+}
+
+static void cmd_mem(GString *out, const char *args)
+{
+    unsigned long long addr = 0, len = 64;
+    if (sscanf(args, "%llx %llu", &addr, &len) < 1) {
+        g_string_append(out, "usage: mem <hex address> [length]\n");
+        return;
+    }
+    len = MIN(len, 4096);
+    uint8_t buf[4096];
+    cpu_physical_memory_read(addr, buf, len);
+    for (unsigned long long i = 0; i < len; i += 16) {
+        g_string_append_printf(out, "%08llx:", addr + i);
+        for (unsigned long long j = i; j < MIN(i + 16, len); j++) {
+            g_string_append_printf(out, " %02x", buf[j]);
+        }
+        g_string_append_c(out, '\n');
+    }
+}
+
+static void run_command(int fd, char *line)
+{
+    g_autoptr(GString) out = g_string_new(NULL);
+    char *args = strchr(line, ' ');
+    if (args) {
+        *args++ = '\0';
+        while (*args == ' ') {
+            args++;
+        }
+    } else {
+        args = line + strlen(line);
+    }
+    if (strcmp(line, "help") == 0) {
+        g_string_append(out, "stats | aot [load|off|exits [on|off]] | hmp <monitor command> | mem <addr> [len] | "
+                             "profile [s] | dump | get [key] | set <key> <value> | quit\n");
+    } else if (strcmp(line, "stats") == 0) {
+        g_string_append(out, ps4_live_last_monitor);
+    } else if (strcmp(line, "aot") == 0 && strncmp(args, "exits", 5) == 0) {
+        const char *a = args + 5;
+        while (*a == ' ') {
+            a++;
+        }
+        aot_exits(out, a);
+    } else if (strcmp(line, "aot") == 0) {
+        if (strcmp(args, "load") == 0 || strcmp(args, "off") == 0) {
+            /* with the CPU stopped: TBs made for the old file go, the new file's come next */
+            bql_lock();
+            const bool was_running = runstate_is_running();
+            if (was_running) {
+                vm_stop(RUN_STATE_PAUSED);
+            }
+            const char *r = aot_switch(strcmp(args, "load") == 0);
+            tb_flush__exclusive_or_serial();
+            if (was_running) {
+                vm_start();
+            }
+            bql_unlock();
+            g_string_append_printf(out, "%s\n", r);
+        }
+        aot_stats(out, true);
+        g_string_append_c(out, '\n');
+    } else if (strcmp(line, "hmp") == 0) {
+        cmd_hmp(out, args);
+    } else if (strcmp(line, "mem") == 0) {
+        cmd_mem(out, args);
+    } else if (strcmp(line, "profile") == 0) {
+        g_string_append(out, ps4_profile_now("live") ? "profiling: profiles/profile_N.txt in 8 s\n"
+                                                     : "a profile is running\n");
+    } else if (strcmp(line, "dump") == 0) {
+        ps4_dump_thread_stacks("/data/xemu/hang.log", "live console");
+        g_string_append(out, "thread stacks in /data/xemu/hang.log\n");
+    } else if (strcmp(line, "get") == 0) {
+        ps4_settings_describe(out, *args ? args : NULL);
+    } else if (strcmp(line, "set") == 0) {
+        char *val = strchr(args, ' ');
+        if (val == NULL) {
+            g_string_append(out, "usage: set <key> <value>\n");
+        } else {
+            *val++ = '\0';
+            g_string_append(out, ps4_settings_set_text(args, val) ? "ok\n" : "no such setting\n");
+            ps4_settings_save();
+        }
+    } else if (line[0] != '\0') {
+        g_string_append_printf(out, "unknown command '%s' (help)\n", line);
+    }
+    reply(fd, out);
+}
+
+static void *live_thread(void *opaque)
+{
+    int srv = socket(AF_INET, SOCK_STREAM, 0);
+    if (srv < 0) {
+        ps4_boot_tracef("live console: socket failed (%d)", errno);
+        return NULL;
+    }
+    int one = 1;
+    setsockopt(srv, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+    struct sockaddr_in a = { .sin_family = AF_INET, .sin_port = htons(live_port) };
+    a.sin_addr.s_addr = htonl(INADDR_ANY);
+    if (bind(srv, (struct sockaddr *)&a, sizeof(a)) != 0 || listen(srv, 1) != 0) {
+        ps4_boot_tracef("live console: port %d not available (%d)", live_port, errno);
+        close(srv);
+        return NULL;
+    }
+    ps4_boot_tracef("live console on TCP port %d", live_port);
+    for (;;) {
+        int fd = accept(srv, NULL, NULL);
+        if (fd < 0) {
+            g_usleep(100000);
+            continue;
+        }
+        char buf[2048];
+        size_t have = 0;
+        for (;;) {
+            ssize_t r = recv(fd, buf + have, sizeof(buf) - 1 - have, 0);
+            if (r <= 0) {
+                break;
+            }
+            have += r;
+            buf[have] = '\0';
+            char *nl;
+            bool quit = false;
+            while ((nl = strchr(buf, '\n')) != NULL) {
+                *nl = '\0';
+                if (nl > buf && nl[-1] == '\r') {
+                    nl[-1] = '\0';
+                }
+                if (strcmp(buf, "quit") == 0) {
+                    quit = true;
+                } else {
+                    run_command(fd, buf);
+                }
+                size_t used = nl + 1 - buf;
+                memmove(buf, nl + 1, have - used + 1);
+                have -= used;
+            }
+            if (quit || have == sizeof(buf) - 1) {
+                break;
+            }
+        }
+        close(fd);
+    }
+    return NULL;
+}
+
+void ps4_live_start(int port)
+{
+    if (port <= 0) {
+        return;
+    }
+    live_port = port;
+    static QemuThread thread;
+    qemu_thread_create(&thread, "ps4-live", live_thread, NULL, QEMU_THREAD_DETACHED);
+}
diff --git a/ui/ps4/ps4-pad.c b/ui/ps4/ps4-pad.c
new file mode 100644
index 0000000..c716d7a
--- /dev/null
+++ b/ui/ps4/ps4-pad.c
@@ -0,0 +1,262 @@
+/*
+ * xemu-ps4: the DualShock 4 as an SDL gamepad. SDL has no PS4 joystick driver; its virtual
+ * gamepad stands in, fed from ScePad each time SDL updates its joysticks, so xemu-input.c binds,
+ * maps and rumbles it like any desktop gamepad (auto-bound to the first free Xbox port).
+ *
+ *   Cross/Circle/Square/Triangle   A/B/X/Y
+ *   L1/R1                          white/black (SDL's shoulders, as xemu maps them)
+ *   L2/R2                          left/right trigger (analog)
+ *   Options                        Start
+ *   touchpad click                 Back
+ *   L3+R3 together                 the quick menu (ps4-hud.cc), not passed to the Xbox
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "ps4-frontend.h"
+
+#include <SDL3/SDL.h>
+#include <orbis/Pad.h>
+#include <orbis/UserService.h>
+
+void ps4_boot_trace(const char *line); /* port/ps4_crashlog.cpp */
+
+typedef struct PS4Pad {
+    int user;
+    int handle;
+    SDL_JoystickID id;
+    SDL_Joystick *joystick;
+    /* reads since start: for the monitor (v00.12: SDL stopped seeing the pad change) */
+    unsigned reads, failures, disconnected, reopens;
+    int last_error;
+    uint32_t last_buttons;
+    unsigned failures_in_a_row;
+    /* the quick menu: the previous read's buttons, presses for the menu, and buttons held when it
+     * closed (kept from the Xbox until released) */
+    uint32_t prev_buttons;
+    uint32_t menu_pressed;
+    uint32_t held_from_menu;
+} PS4Pad;
+
+static PS4Pad pad = { .user = -1, .handle = -1 };
+
+static const struct {
+    uint32_t ps4;
+    SDL_GamepadButton sdl;
+} button_map[] = {
+    { ORBIS_PAD_BUTTON_CROSS, SDL_GAMEPAD_BUTTON_SOUTH },
+    { ORBIS_PAD_BUTTON_CIRCLE, SDL_GAMEPAD_BUTTON_EAST },
+    { ORBIS_PAD_BUTTON_SQUARE, SDL_GAMEPAD_BUTTON_WEST },
+    { ORBIS_PAD_BUTTON_TRIANGLE, SDL_GAMEPAD_BUTTON_NORTH },
+    { ORBIS_PAD_BUTTON_TOUCH_PAD, SDL_GAMEPAD_BUTTON_BACK },
+    { ORBIS_PAD_BUTTON_OPTIONS, SDL_GAMEPAD_BUTTON_START },
+    { ORBIS_PAD_BUTTON_L3, SDL_GAMEPAD_BUTTON_LEFT_STICK },
+    { ORBIS_PAD_BUTTON_R3, SDL_GAMEPAD_BUTTON_RIGHT_STICK },
+    { ORBIS_PAD_BUTTON_L1, SDL_GAMEPAD_BUTTON_LEFT_SHOULDER },
+    { ORBIS_PAD_BUTTON_R1, SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER },
+    { ORBIS_PAD_BUTTON_UP, SDL_GAMEPAD_BUTTON_DPAD_UP },
+    { ORBIS_PAD_BUTTON_DOWN, SDL_GAMEPAD_BUTTON_DPAD_DOWN },
+    { ORBIS_PAD_BUTTON_LEFT, SDL_GAMEPAD_BUTTON_DPAD_LEFT },
+    { ORBIS_PAD_BUTTON_RIGHT, SDL_GAMEPAD_BUTTON_DPAD_RIGHT },
+};
+
+/* The pad's reads are marked "intercepted" (bit 31) while the system has the input */
+#define PS4_PAD_INTERCEPTED 0x80000000u
+
+uint32_t ps4_pad_menu_pressed(void)
+{
+    const uint32_t b = pad.menu_pressed;
+    pad.menu_pressed = 0;
+    return b;
+}
+
+/* 0..255, centre 128 -> SDL's -32768..32767 */
+static Sint16 stick_axis(uint8_t v)
+{
+    int a = ((int)v - 128) * 256;
+    return (Sint16)MAX(-32768, MIN(32767, a));
+}
+
+/* 0..255 -> SDL's trigger range 0..32767 */
+static Sint16 trigger_axis(uint8_t v)
+{
+    return (Sint16)(v * 32767 / 255);
+}
+
+static void SDLCALL pad_update(void *userdata)
+{
+    OrbisPadData data;
+    memset(&data, 0, sizeof(data));
+    if (pad.joystick == NULL) {
+        return;
+    }
+    int r = scePadReadState(pad.handle, &data);
+    if (r != 0) {
+        pad.failures++;
+        pad.last_error = r;
+        /* a handle gone bad (the pad reconnected, ...): open it again after a second */
+        if (++pad.failures_in_a_row >= 60) {
+            scePadClose(pad.handle);
+            pad.handle = scePadOpen(pad.user, ORBIS_PAD_PORT_TYPE_STANDARD, 0, NULL);
+            if (pad.handle < 0) {
+                pad.handle = scePadGetHandle(pad.user, ORBIS_PAD_PORT_TYPE_STANDARD, 0);
+            }
+            pad.reopens++;
+            pad.failures_in_a_row = 0;
+        }
+        return;
+    }
+    pad.failures_in_a_row = 0;
+    pad.reads++;
+    pad.last_buttons = data.buttons;
+    if (!data.connected) {
+        pad.disconnected++;
+        data.buttons = 0;
+        data.leftStick.x = data.leftStick.y = 128;
+        data.rightStick.x = data.rightStick.y = 128;
+        data.analogButtons.l2 = data.analogButtons.r2 = 0;
+    }
+    /* L3+R3: the quick menu; its presses don't reach the Xbox */
+    {
+        uint32_t buttons = data.buttons & ~PS4_PAD_INTERCEPTED;
+        const uint32_t combo = ORBIS_PAD_BUTTON_L3 | ORBIS_PAD_BUTTON_R3;
+        const bool menus = ps4_menu_open || ps4_launcher_active;
+        if (menus) {
+            /* in the menus the left stick steps like the d-pad */
+            buttons |= data.leftStick.x < 48 ? ORBIS_PAD_BUTTON_LEFT : 0;
+            buttons |= data.leftStick.x > 208 ? ORBIS_PAD_BUTTON_RIGHT : 0;
+            buttons |= data.leftStick.y < 48 ? ORBIS_PAD_BUTTON_UP : 0;
+            buttons |= data.leftStick.y > 208 ? ORBIS_PAD_BUTTON_DOWN : 0;
+        }
+        const bool was_open = ps4_menu_open || ps4_launcher_active;
+        if ((buttons & combo) == combo && (pad.prev_buttons & combo) != combo) {
+            ps4_menu_open = !ps4_menu_open;
+            pad.menu_pressed = 0;
+        } else if (menus) {
+            pad.menu_pressed |= buttons & ~pad.prev_buttons;
+        }
+        pad.prev_buttons = buttons;
+        if (was_open || ps4_menu_open || ps4_launcher_active) {
+            pad.held_from_menu = buttons;
+        }
+        pad.held_from_menu &= buttons;
+        if (ps4_menu_open || ps4_launcher_active || (buttons & combo) == combo) {
+            data.buttons = 0;
+            data.leftStick.x = data.leftStick.y = 128;
+            data.rightStick.x = data.rightStick.y = 128;
+            data.analogButtons.l2 = data.analogButtons.r2 = 0;
+        } else {
+            data.buttons &= ~pad.held_from_menu;
+        }
+    }
+    for (size_t i = 0; i < ARRAY_SIZE(button_map); i++) {
+        SDL_SetJoystickVirtualButton(pad.joystick, button_map[i].sdl,
+                                     (data.buttons & button_map[i].ps4) != 0);
+    }
+    SDL_SetJoystickVirtualAxis(pad.joystick, SDL_GAMEPAD_AXIS_LEFTX, stick_axis(data.leftStick.x));
+    SDL_SetJoystickVirtualAxis(pad.joystick, SDL_GAMEPAD_AXIS_LEFTY, stick_axis(data.leftStick.y));
+    SDL_SetJoystickVirtualAxis(pad.joystick, SDL_GAMEPAD_AXIS_RIGHTX, stick_axis(data.rightStick.x));
+    SDL_SetJoystickVirtualAxis(pad.joystick, SDL_GAMEPAD_AXIS_RIGHTY, stick_axis(data.rightStick.y));
+    SDL_SetJoystickVirtualAxis(pad.joystick, SDL_GAMEPAD_AXIS_LEFT_TRIGGER,
+                               trigger_axis(data.analogButtons.l2));
+    SDL_SetJoystickVirtualAxis(pad.joystick, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER,
+                               trigger_axis(data.analogButtons.r2));
+}
+
+static bool SDLCALL pad_rumble(void *userdata, Uint16 low, Uint16 high)
+{
+    OrbisPadVibeParam param = { .lgMotor = low >> 8, .smMotor = high >> 8 };
+    return scePadSetVibration(pad.handle, &param) == 0;
+}
+
+void ps4_pad_init(void)
+{
+    char line[128];
+    sceUserServiceInitialize(NULL);
+    scePadInit();
+    int user = -1;
+    if (sceUserServiceGetInitialUser(&user) != 0 || user < 0) {
+        ps4_boot_trace("pad: no initial user");
+        return;
+    }
+    pad.user = user;
+    pad.handle = scePadOpen(user, ORBIS_PAD_PORT_TYPE_STANDARD, 0, NULL);
+    if (pad.handle < 0) {
+        snprintf(line, sizeof(line), "pad: scePadOpen(user %x) failed (%x)", user,
+                 (unsigned)pad.handle);
+        ps4_boot_trace(line);
+        return;
+    }
+
+    SDL_VirtualJoystickDesc desc;
+    SDL_INIT_INTERFACE(&desc);
+    desc.type = SDL_JOYSTICK_TYPE_GAMEPAD;
+    desc.vendor_id = 0x054c;    /* Sony */
+    desc.product_id = 0x09cc;   /* DualShock 4 (v2) */
+    desc.naxes = SDL_GAMEPAD_AXIS_COUNT;
+    desc.nbuttons = SDL_GAMEPAD_BUTTON_DPAD_RIGHT + 1;
+    /* every button and axis the pad has, in SDL's gamepad order: index == SDL_GamepadButton */
+    desc.button_mask = (1u << (SDL_GAMEPAD_BUTTON_DPAD_RIGHT + 1)) - 1;
+    desc.axis_mask = (1u << SDL_GAMEPAD_AXIS_COUNT) - 1;
+    desc.name = "DualShock 4";
+    desc.Update = pad_update;
+    desc.Rumble = pad_rumble;
+
+    pad.id = SDL_AttachVirtualJoystick(&desc);
+    if (pad.id == 0) {
+        snprintf(line, sizeof(line), "pad: SDL_AttachVirtualJoystick: %s", SDL_GetError());
+        ps4_boot_trace(line);
+        return;
+    }
+    /* the gamepad layer opens it for xemu-input; this keeps the virtual device's state */
+    pad.joystick = SDL_OpenJoystick(pad.id);
+    snprintf(line, sizeof(line),
+             "pad: DualShock 4 of user %x (handle %d) as SDL joystick %u, gamepad: %s",
+             user, pad.handle, (unsigned)pad.id, SDL_IsGamepad(pad.id) ? "yes" : "NO");
+    ps4_boot_trace(line);
+}
+
+SDL_JoystickID ps4_pad_joystick_id(void)
+{
+    return pad.id;
+}
+
+/* sceSystemServiceGetStatus's result (Sony's SceSystemServiceStatus; OpenOrbis declares the
+ * function without it) */
+typedef struct PS4SystemStatus {
+    int32_t event_count;
+    bool system_ui_overlaid;
+    bool in_background;
+    bool cpu_mode7_normal;
+    bool live_streaming;
+    bool out_of_vr_area;
+    uint8_t reserved[125];
+} PS4SystemStatus;
+int sceSystemServiceGetStatus(PS4SystemStatus *status);
+
+/* (PS4_PAD_INTERCEPTED, above: the system has the input - its UI is over the app, the app is in
+ * the background, ... - and reports no buttons to us) */
+
+bool ps4_pad_intercepted(void)
+{
+    return (pad.last_buttons & PS4_PAD_INTERCEPTED) != 0;
+}
+
+void ps4_pad_stats(char *out, size_t size)
+{
+    PS4SystemStatus status;
+    memset(&status, 0, sizeof(status));
+    int r = sceSystemServiceGetStatus(&status);
+    snprintf(out, size, "pad: %u reads, %u failed (last %x), %u disconnected, %u reopens, "
+             "buttons %x%s | system: %s%s%s (%x, %d events)", pad.reads, pad.failures,
+             (unsigned)pad.last_error, pad.disconnected, pad.reopens, pad.last_buttons,
+             ps4_pad_intercepted() ? " INTERCEPTED" : "",
+             status.system_ui_overlaid ? "UI overlaid " : "",
+             status.in_background ? "in background " : "",
+             !status.system_ui_overlaid && !status.in_background ? "foreground" : "",
+             (unsigned)r, status.event_count);
+}
diff --git a/ui/ps4/ps4-present.cc b/ui/ps4/ps4-present.cc
new file mode 100644
index 0000000..a2486cb
--- /dev/null
+++ b/ui/ps4/ps4-present.cc
@@ -0,0 +1,664 @@
+/*
+ * xemu-ps4: presents the emulated display on VideoOut, on the Vulkan renderer's own device and
+ * queue (the PS4 has no OpenGL to hand the picture to, as the desktop frontends do).
+ *
+ * Each frame: clear the swapchain image, blit the renderer's display image into it scaled to
+ * fit, draw the HUD with ImGui's Vulkan backend, present (ps4-wsi.cc: a VideoOut flip behind
+ * the GPU work). The display image belongs to the renderer again once the frame's commands have
+ * finished, so the frame waits for its fence before returning.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "ps4-frontend.h"
+#include "ps4-wsi.h"
+#include "ps4-settings.h"
+
+#include <volk.h>
+#include "imgui.h"
+#include "backends/imgui_impl_vulkan.h"
+
+#include <algorithm>
+#include <unistd.h>
+#include <cstdio>
+#include <cstring>
+
+// the fonts (ps4-frontend.h's C++ part): titles and small print, null without the TTFs
+ImFont *ps4_font_title, *ps4_font_small;
+
+namespace
+{
+constexpr uint32_t kMaxImages = 4;
+
+struct Presenter
+{
+    bool ready = false;
+    NV2AVkDevice dev {};
+    VkSurfaceKHR surface = VK_NULL_HANDLE;
+    VkSwapchainKHR swapchain = VK_NULL_HANDLE;
+    uint32_t imageCount = 0;
+    VkImage images[kMaxImages] {};
+    VkImageView views[kMaxImages] {};
+    VkFramebuffer framebuffers[kMaxImages] {};
+    VkCommandBuffer commands[kMaxImages] {};
+    VkFence fences[kMaxImages] {};
+    VkRenderPass renderPass = VK_NULL_HANDLE;
+    VkCommandPool pool = VK_NULL_HANDLE;
+    bool imguiReady = false;
+    uint64_t frames = 0;
+    uint64_t displayFrames = 0;
+    // the last finished guest frame (a copy of the renderer's display image), shown until the
+    // next: the renderer is asked for the display only when the guest has flipped
+    VkImage last = VK_NULL_HANDLE;
+    VkDeviceMemory lastMemory = VK_NULL_HANDLE;
+    uint32_t lastWidth = 0, lastHeight = 0;
+    bool lastValid = false;
+    VkSampler textureSampler = VK_NULL_HANDLE;   // the launcher's covers (ps4_present_texture)
+} P;
+
+bool Check(VkResult r, const char *what);
+
+uint32_t DeviceLocalMemoryType(uint32_t typeBits)
+{
+    VkPhysicalDeviceMemoryProperties props;
+    vkGetPhysicalDeviceMemoryProperties(P.dev.physical_device, &props);
+    for (uint32_t i = 0; i < props.memoryTypeCount; i++) {
+        if ((typeBits & (1u << i)) &&
+            (props.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) {
+            return i;
+        }
+    }
+    return 0;
+}
+
+void DestroyLastFrame()
+{
+    if (P.last != VK_NULL_HANDLE) {
+        vkDestroyImage(P.dev.device, P.last, nullptr);
+        vkFreeMemory(P.dev.device, P.lastMemory, nullptr);
+    }
+    P.last = VK_NULL_HANDLE;
+    P.lastMemory = VK_NULL_HANDLE;
+    P.lastWidth = P.lastHeight = 0;
+    P.lastValid = false;
+}
+
+// The copy of the guest's frame, at the display image's size (made again when that changes;
+// the caller has waited for the GPU)
+bool EnsureLastFrame(uint32_t w, uint32_t h)
+{
+    if (P.last != VK_NULL_HANDLE && P.lastWidth == w && P.lastHeight == h) {
+        return true;
+    }
+    DestroyLastFrame();
+    VkImageCreateInfo ici { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+    ici.imageType = VK_IMAGE_TYPE_2D;
+    ici.format = VK_FORMAT_R8G8B8A8_UNORM;
+    ici.extent = { w, h, 1 };
+    ici.mipLevels = 1;
+    ici.arrayLayers = 1;
+    ici.samples = VK_SAMPLE_COUNT_1_BIT;
+    ici.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ici.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    ici.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (!Check(vkCreateImage(P.dev.device, &ici, nullptr, &P.last), "vkCreateImage (last frame)")) {
+        P.last = VK_NULL_HANDLE;
+        return false;
+    }
+    VkMemoryRequirements req;
+    vkGetImageMemoryRequirements(P.dev.device, P.last, &req);
+    VkMemoryAllocateInfo mai { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    mai.allocationSize = req.size;
+    mai.memoryTypeIndex = DeviceLocalMemoryType(req.memoryTypeBits);
+    if (!Check(vkAllocateMemory(P.dev.device, &mai, nullptr, &P.lastMemory),
+               "vkAllocateMemory (last frame)")) {
+        vkDestroyImage(P.dev.device, P.last, nullptr);
+        P.last = VK_NULL_HANDLE;
+        return false;
+    }
+    vkBindImageMemory(P.dev.device, P.last, P.lastMemory, 0);
+    P.lastWidth = w;
+    P.lastHeight = h;
+    P.lastValid = false;
+    return true;
+}
+
+bool Check(VkResult r, const char *what)
+{
+    if (r != VK_SUCCESS) {
+        fprintf(stderr, "ps4-present: %s failed (%d)\n", what, r);
+        return false;
+    }
+    return true;
+}
+
+void ImageBarrier(VkCommandBuffer cmd, VkImage image, VkImageLayout from, VkImageLayout to,
+                  VkAccessFlags srcAccess, VkAccessFlags dstAccess,
+                  VkPipelineStageFlags srcStage, VkPipelineStageFlags dstStage)
+{
+    VkImageMemoryBarrier b { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER };
+    b.srcAccessMask = srcAccess;
+    b.dstAccessMask = dstAccess;
+    b.oldLayout = from;
+    b.newLayout = to;
+    b.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.image = image;
+    b.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+    vkCmdPipelineBarrier(cmd, srcStage, dstStage, 0, 0, nullptr, 0, nullptr, 1, &b);
+}
+
+bool CreateSwapchain()
+{
+    VkHeadlessSurfaceCreateInfoEXT sci { VK_STRUCTURE_TYPE_HEADLESS_SURFACE_CREATE_INFO_EXT };
+    if (!Check(vkCreateHeadlessSurfaceEXT(P.dev.instance, &sci, nullptr, &P.surface),
+               "vkCreateHeadlessSurfaceEXT")) {
+        return false;
+    }
+
+    VkSwapchainCreateInfoKHR ci { VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR };
+    ci.surface = P.surface;
+    ci.minImageCount = 3;
+    ci.imageFormat = VK_FORMAT_R8G8B8A8_UNORM;
+    ci.imageColorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+    ci.imageExtent = { ps4wsi::kWidth, ps4wsi::kHeight };
+    ci.imageArrayLayers = 1;
+    ci.imageUsage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    ci.imageSharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    ci.preTransform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+    ci.compositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+    ci.presentMode = VK_PRESENT_MODE_FIFO_KHR;
+    ci.clipped = VK_TRUE;
+    if (!Check(vkCreateSwapchainKHR(P.dev.device, &ci, nullptr, &P.swapchain),
+               "vkCreateSwapchainKHR")) {
+        return false;
+    }
+    P.imageCount = kMaxImages;
+    if (!Check(vkGetSwapchainImagesKHR(P.dev.device, P.swapchain, &P.imageCount, P.images),
+               "vkGetSwapchainImagesKHR")) {
+        return false;
+    }
+
+    VkAttachmentDescription color {};
+    color.format = VK_FORMAT_R8G8B8A8_UNORM;
+    color.samples = VK_SAMPLE_COUNT_1_BIT;
+    color.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;      // the picture blitted before
+    color.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    color.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+    color.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+    color.initialLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    color.finalLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+    VkAttachmentReference ref { 0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL };
+    VkSubpassDescription sub {};
+    sub.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+    sub.colorAttachmentCount = 1;
+    sub.pColorAttachments = &ref;
+    VkRenderPassCreateInfo rpi { VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO };
+    rpi.attachmentCount = 1;
+    rpi.pAttachments = &color;
+    rpi.subpassCount = 1;
+    rpi.pSubpasses = &sub;
+    if (!Check(vkCreateRenderPass(P.dev.device, &rpi, nullptr, &P.renderPass),
+               "vkCreateRenderPass")) {
+        return false;
+    }
+
+    VkCommandPoolCreateInfo pci { VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO };
+    pci.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    pci.queueFamilyIndex = P.dev.queue_family;
+    if (!Check(vkCreateCommandPool(P.dev.device, &pci, nullptr, &P.pool), "vkCreateCommandPool")) {
+        return false;
+    }
+    VkCommandBufferAllocateInfo cai { VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO };
+    cai.commandPool = P.pool;
+    cai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    cai.commandBufferCount = P.imageCount;
+    if (!Check(vkAllocateCommandBuffers(P.dev.device, &cai, P.commands),
+               "vkAllocateCommandBuffers")) {
+        return false;
+    }
+
+    for (uint32_t i = 0; i < P.imageCount; i++) {
+        VkImageViewCreateInfo vi { VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+        vi.image = P.images[i];
+        vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        vi.format = VK_FORMAT_R8G8B8A8_UNORM;
+        vi.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+        if (!Check(vkCreateImageView(P.dev.device, &vi, nullptr, &P.views[i]),
+                   "vkCreateImageView")) {
+            return false;
+        }
+        VkFramebufferCreateInfo fi { VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO };
+        fi.renderPass = P.renderPass;
+        fi.attachmentCount = 1;
+        fi.pAttachments = &P.views[i];
+        fi.width = ps4wsi::kWidth;
+        fi.height = ps4wsi::kHeight;
+        fi.layers = 1;
+        if (!Check(vkCreateFramebuffer(P.dev.device, &fi, nullptr, &P.framebuffers[i]),
+                   "vkCreateFramebuffer")) {
+            return false;
+        }
+        VkFenceCreateInfo fci { VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+        fci.flags = VK_FENCE_CREATE_SIGNALED_BIT;
+        if (!Check(vkCreateFence(P.dev.device, &fci, nullptr, &P.fences[i]), "vkCreateFence")) {
+            return false;
+        }
+    }
+    fprintf(stderr, "ps4-present: swapchain of %u images %ux%u\n", P.imageCount,
+            ps4wsi::kWidth, ps4wsi::kHeight);
+    return true;
+}
+
+PFN_vkVoidFunction ImGuiLoader(const char *name, void *)
+{
+    PFN_vkVoidFunction fn = vkGetDeviceProcAddr(P.dev.device, name);
+    return fn ? fn : vkGetInstanceProcAddr(P.dev.instance, name);
+}
+
+bool InitImGui()
+{
+    IMGUI_CHECKVERSION();
+    ImGui::CreateContext();
+    ImGuiIO &io = ImGui::GetIO();
+    io.IniFilename = nullptr;
+    io.DisplaySize = ImVec2((float)ps4wsi::kWidth, (float)ps4wsi::kHeight);
+    io.ConfigFlags |= ImGuiConfigFlags_NavEnableGamepad;
+    // Roboto from the package (/app0/data, xemu's data/), sized for a TV across the room; the
+    // default font (doubled) when it is missing
+    // (ImGui asserts on a missing font file: look first)
+    ImFont *text = access("/app0/data/Roboto-Medium.ttf", R_OK) == 0 &&
+                           access("/app0/data/RobotoCondensed-Regular.ttf", R_OK) == 0
+                       ? io.Fonts->AddFontFromFileTTF("/app0/data/Roboto-Medium.ttf", 30.0f)
+                       : nullptr;
+    if (text) {
+        ps4_font_title = io.Fonts->AddFontFromFileTTF("/app0/data/Roboto-Medium.ttf", 54.0f);
+        ps4_font_small = io.Fonts->AddFontFromFileTTF("/app0/data/RobotoCondensed-Regular.ttf", 24.0f);
+        io.FontDefault = text;
+    } else {
+        io.FontGlobalScale = 2.0f;
+    }
+    ImGui::StyleColorsDark();
+    ImGui::GetStyle().ScaleAllSizes(2.0f);
+
+    if (!ImGui_ImplVulkan_LoadFunctions(ImGuiLoader)) {
+        fprintf(stderr, "ps4-present: ImGui_ImplVulkan_LoadFunctions failed\n");
+        return false;
+    }
+    ImGui_ImplVulkan_InitInfo info {};
+    info.Instance = P.dev.instance;
+    info.PhysicalDevice = P.dev.physical_device;
+    info.Device = P.dev.device;
+    info.QueueFamily = P.dev.queue_family;
+    info.Queue = P.dev.queue;
+    info.RenderPass = P.renderPass;
+    info.MinImageCount = 2;
+    info.ImageCount = P.imageCount;
+    info.MSAASamples = VK_SAMPLE_COUNT_1_BIT;
+    info.DescriptorPoolSize = 512;     // the font + one per cover (the launcher)
+    if (!ImGui_ImplVulkan_Init(&info)) {
+        fprintf(stderr, "ps4-present: ImGui_ImplVulkan_Init failed\n");
+        return false;
+    }
+    return true;
+}
+
+// The display image's rectangle on the screen (Settings > Picture): as large as fits at its own
+// aspect ratio, the whole screen, or the largest whole multiple of its size
+VkRect2D FitRect(uint32_t w, uint32_t h)
+{
+    const float sx = (float)ps4wsi::kWidth / w, sy = (float)ps4wsi::kHeight / h;
+    float s = std::min(sx, sy);
+    if (ps4_settings.scaling == PS4_SCALE_INTEGER && s >= 1.0f) {
+        s = (float)(int)s;
+    }
+    uint32_t dw = (uint32_t)(w * s), dh = (uint32_t)(h * s);
+    if (ps4_settings.scaling == PS4_SCALE_STRETCH) {
+        dw = ps4wsi::kWidth;
+        dh = ps4wsi::kHeight;
+    }
+    VkRect2D r;
+    r.offset = { (int32_t)(ps4wsi::kWidth - dw) / 2, (int32_t)(ps4wsi::kHeight - dh) / 2 };
+    r.extent = { dw, dh };
+    return r;
+}
+
+void Record(VkCommandBuffer cmd, uint32_t index, bool haveDisplay, ImDrawData *drawData)
+{
+    VkCommandBufferBeginInfo bi { VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+    bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    vkBeginCommandBuffer(cmd, &bi);
+
+    VkImage target = P.images[index];
+    ImageBarrier(cmd, target, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                 0, VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                 VK_PIPELINE_STAGE_TRANSFER_BIT);
+    VkClearColorValue black {};
+    VkImageSubresourceRange all { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+    vkCmdClearColorImage(cmd, target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &black, 1, &all);
+
+    // a new guest frame: copied out of the renderer's display image, which is the renderer's
+    // again once this command buffer has run (ps4_present_frame waits for that)
+    VkImage display = VK_NULL_HANDLE;
+    VkImageView view;
+    uint32_t w, h;
+    if (haveDisplay && nv2a_vk_ps4_get_display(&display, &view, &w, &h) && w == P.lastWidth &&
+        h == P.lastHeight && P.last != VK_NULL_HANDLE) {
+        ImageBarrier(cmd, display, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+                     VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                     VK_ACCESS_TRANSFER_READ_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                     VK_PIPELINE_STAGE_TRANSFER_BIT);
+        ImageBarrier(cmd, P.last,
+                     P.lastValid ? VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL : VK_IMAGE_LAYOUT_UNDEFINED,
+                     VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_ACCESS_TRANSFER_READ_BIT,
+                     VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                     VK_PIPELINE_STAGE_TRANSFER_BIT);
+        VkImageCopy copy {};
+        copy.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+        copy.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+        copy.extent = { w, h, 1 };
+        vkCmdCopyImage(cmd, display, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, P.last,
+                       VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+        // back to where the renderer left it
+        ImageBarrier(cmd, display, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                     VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_ACCESS_TRANSFER_READ_BIT, 0,
+                     VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT);
+        ImageBarrier(cmd, P.last, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                     VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT,
+                     VK_ACCESS_TRANSFER_READ_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                     VK_PIPELINE_STAGE_TRANSFER_BIT);
+        P.lastValid = true;
+    }
+
+    // the last guest frame, every presented frame, scaled to fit
+    if (P.lastValid) {
+        ImageBarrier(cmd, target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                     VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT,
+                     VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                     VK_PIPELINE_STAGE_TRANSFER_BIT);
+        const uint32_t lw = P.lastWidth, lh = P.lastHeight;
+        const VkRect2D dst = FitRect(lw, lh);
+        VkImageBlit blit {};
+        blit.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+        // the renderer stores the display bottom-up for the desktop's OpenGL presenter ("GL
+        // compat" in vk/display.c): read it from the last row up
+        blit.srcOffsets[0] = { 0, (int32_t)lh, 0 };
+        blit.srcOffsets[1] = { (int32_t)lw, 0, 1 };
+        blit.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+        blit.dstOffsets[0] = { dst.offset.x, dst.offset.y, 0 };
+        blit.dstOffsets[1] = { dst.offset.x + (int32_t)dst.extent.width,
+                               dst.offset.y + (int32_t)dst.extent.height, 1 };
+        vkCmdBlitImage(cmd, P.last, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, target,
+                       VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit,
+                       ps4_settings.filter == PS4_FILTER_NEAREST ? VK_FILTER_NEAREST : VK_FILTER_LINEAR);
+    }
+
+    ImageBarrier(cmd, target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                 VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT,
+                 VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                 VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT);
+
+    VkRenderPassBeginInfo rbi { VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO };
+    rbi.renderPass = P.renderPass;
+    rbi.framebuffer = P.framebuffers[index];
+    rbi.renderArea.extent = { ps4wsi::kWidth, ps4wsi::kHeight };
+    vkCmdBeginRenderPass(cmd, &rbi, VK_SUBPASS_CONTENTS_INLINE);
+    if (drawData) {
+        ImGui_ImplVulkan_RenderDrawData(drawData, cmd);
+    }
+    vkCmdEndRenderPass(cmd);
+    vkEndCommandBuffer(cmd);
+}
+} // namespace
+
+// An RGBA picture as an ImGui texture on the renderer's device (the launcher's covers): image,
+// upload through a staging buffer on the shared queue, view, and ImGui's descriptor set.
+extern "C" ImTextureID ps4_present_texture(const uint8_t *rgba, int w, int h)
+{
+    if (!P.ready || w <= 0 || h <= 0) {
+        return 0;
+    }
+    VkDevice dev = P.dev.device;
+    if (P.textureSampler == VK_NULL_HANDLE) {
+        VkSamplerCreateInfo si { VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO };
+        si.magFilter = si.minFilter = VK_FILTER_LINEAR;
+        si.addressModeU = si.addressModeV = si.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+        si.maxLod = 1.0f;
+        if (!Check(vkCreateSampler(dev, &si, nullptr, &P.textureSampler), "vkCreateSampler")) {
+            return 0;
+        }
+    }
+    VkImageCreateInfo ici { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+    ici.imageType = VK_IMAGE_TYPE_2D;
+    ici.format = VK_FORMAT_R8G8B8A8_UNORM;
+    ici.extent = { (uint32_t)w, (uint32_t)h, 1 };
+    ici.mipLevels = 1;
+    ici.arrayLayers = 1;
+    ici.samples = VK_SAMPLE_COUNT_1_BIT;
+    ici.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ici.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    VkImage image;
+    if (!Check(vkCreateImage(dev, &ici, nullptr, &image), "vkCreateImage (texture)")) {
+        return 0;
+    }
+    VkMemoryRequirements req;
+    vkGetImageMemoryRequirements(dev, image, &req);
+    VkMemoryAllocateInfo mai { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    mai.allocationSize = req.size;
+    mai.memoryTypeIndex = DeviceLocalMemoryType(req.memoryTypeBits);
+    VkDeviceMemory memory;
+    if (!Check(vkAllocateMemory(dev, &mai, nullptr, &memory), "vkAllocateMemory (texture)")) {
+        vkDestroyImage(dev, image, nullptr);
+        return 0;
+    }
+    vkBindImageMemory(dev, image, memory, 0);
+
+    // staging buffer, host visible
+    const VkDeviceSize bytes = (VkDeviceSize)w * h * 4;
+    VkBufferCreateInfo bci { VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO };
+    bci.size = bytes;
+    bci.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+    VkBuffer staging;
+    vkCreateBuffer(dev, &bci, nullptr, &staging);
+    vkGetBufferMemoryRequirements(dev, staging, &req);
+    VkPhysicalDeviceMemoryProperties props;
+    vkGetPhysicalDeviceMemoryProperties(P.dev.physical_device, &props);
+    uint32_t hostType = 0;
+    for (uint32_t i = 0; i < props.memoryTypeCount; i++) {
+        const VkMemoryPropertyFlags want =
+            VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+        if ((req.memoryTypeBits & (1u << i)) && (props.memoryTypes[i].propertyFlags & want) == want) {
+            hostType = i;
+            break;
+        }
+    }
+    mai.allocationSize = req.size;
+    mai.memoryTypeIndex = hostType;
+    VkDeviceMemory stagingMemory;
+    vkAllocateMemory(dev, &mai, nullptr, &stagingMemory);
+    vkBindBufferMemory(dev, staging, stagingMemory, 0);
+    void *map = nullptr;
+    vkMapMemory(dev, stagingMemory, 0, bytes, 0, &map);
+    memcpy(map, rgba, bytes);
+    vkUnmapMemory(dev, stagingMemory);
+
+    VkCommandBufferAllocateInfo cai { VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO };
+    cai.commandPool = P.pool;
+    cai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    cai.commandBufferCount = 1;
+    VkCommandBuffer cmd;
+    vkAllocateCommandBuffers(dev, &cai, &cmd);
+    VkCommandBufferBeginInfo bi { VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+    bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    vkBeginCommandBuffer(cmd, &bi);
+    ImageBarrier(cmd, image, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 0,
+                 VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                 VK_PIPELINE_STAGE_TRANSFER_BIT);
+    VkBufferImageCopy copy {};
+    copy.imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+    copy.imageExtent = { (uint32_t)w, (uint32_t)h, 1 };
+    vkCmdCopyBufferToImage(cmd, staging, image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+    ImageBarrier(cmd, image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                 VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT,
+                 VK_ACCESS_SHADER_READ_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                 VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT);
+    vkEndCommandBuffer(cmd);
+    VkFenceCreateInfo fci { VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+    VkFence fence;
+    vkCreateFence(dev, &fci, nullptr, &fence);
+    VkSubmitInfo si { VK_STRUCTURE_TYPE_SUBMIT_INFO };
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &cmd;
+    nv2a_vk_ps4_queue_lock();
+    VkResult r = vkQueueSubmit(P.dev.queue, 1, &si, fence);
+    nv2a_vk_ps4_queue_unlock();
+    if (r == VK_SUCCESS) {
+        vkWaitForFences(dev, 1, &fence, VK_TRUE, UINT64_MAX);
+    }
+    vkDestroyFence(dev, fence, nullptr);
+    vkFreeCommandBuffers(dev, P.pool, 1, &cmd);
+    vkDestroyBuffer(dev, staging, nullptr);
+    vkFreeMemory(dev, stagingMemory, nullptr);
+    if (r != VK_SUCCESS) {
+        vkDestroyImage(dev, image, nullptr);
+        vkFreeMemory(dev, memory, nullptr);
+        return 0;
+    }
+
+    VkImageViewCreateInfo vi { VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+    vi.image = image;
+    vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    vi.format = VK_FORMAT_R8G8B8A8_UNORM;
+    vi.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+    VkImageView view;
+    if (!Check(vkCreateImageView(dev, &vi, nullptr, &view), "vkCreateImageView (texture)")) {
+        return 0;
+    }
+    // (kept for the app's lifetime: covers are few and small)
+    return (ImTextureID)ImGui_ImplVulkan_AddTexture(P.textureSampler, view,
+                                                    VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+}
+
+extern "C" bool ps4_present_ready(void)
+{
+    return P.ready;
+}
+
+extern "C" bool ps4_present_init(const NV2AVkDevice *dev)
+{
+    static bool failed;
+    if (failed) {
+        return false;
+    }
+    P.dev = *dev;
+    if (!CreateSwapchain() || !InitImGui()) {
+        failed = true;
+        return false;
+    }
+    P.imguiReady = true;
+    P.ready = true;
+    return true;
+}
+
+extern "C" void ps4_present_frame(bool have_display)
+{
+    if (!P.ready) {
+        return;
+    }
+
+    // a new display size (the guest's video mode): the last-frame copy follows, once the GPU
+    // is done with the old one
+    if (have_display) {
+        VkImage display;
+        VkImageView view;
+        uint32_t w, h;
+        if (nv2a_vk_ps4_get_display(&display, &view, &w, &h) && w && h &&
+            (w != P.lastWidth || h != P.lastHeight)) {
+            nv2a_vk_ps4_queue_lock();
+            vkQueueWaitIdle(P.dev.queue);
+            nv2a_vk_ps4_queue_unlock();
+            EnsureLastFrame(w, h);
+        }
+    }
+
+    // the ImGui frame (its first NewFrame uploads the font texture through the shared queue)
+    nv2a_vk_ps4_queue_lock();
+    ImGui_ImplVulkan_NewFrame();
+    nv2a_vk_ps4_queue_unlock();
+    ImGui::NewFrame();
+    ps4_hud_draw();
+    ImGui::Render();
+
+    uint32_t index = 0;
+    nv2a_vk_ps4_queue_lock();
+    VkResult r = vkAcquireNextImageKHR(P.dev.device, P.swapchain, UINT64_MAX, VK_NULL_HANDLE,
+                                       VK_NULL_HANDLE, &index);
+    nv2a_vk_ps4_queue_unlock();
+    if (!Check(r, "vkAcquireNextImageKHR")) {
+        return;
+    }
+
+    vkWaitForFences(P.dev.device, 1, &P.fences[index], VK_TRUE, UINT64_MAX);
+    vkResetFences(P.dev.device, 1, &P.fences[index]);
+    VkCommandBuffer cmd = P.commands[index];
+    vkResetCommandBuffer(cmd, 0);
+    Record(cmd, index, have_display, ImGui::GetDrawData());
+
+    VkSubmitInfo si { VK_STRUCTURE_TYPE_SUBMIT_INFO };
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &cmd;
+    VkPresentInfoKHR pi { VK_STRUCTURE_TYPE_PRESENT_INFO_KHR };
+    pi.swapchainCount = 1;
+    pi.pSwapchains = &P.swapchain;
+    pi.pImageIndices = &index;
+
+    nv2a_vk_ps4_queue_lock();
+    r = vkQueueSubmit(P.dev.queue, 1, &si, P.fences[index]);
+    if (Check(r, "vkQueueSubmit")) {
+        Check(vkQueuePresentKHR(P.dev.queue, &pi), "vkQueuePresentKHR");
+    }
+    nv2a_vk_ps4_queue_unlock();
+
+    // the display image is the renderer's again once the blit has run
+    if (have_display) {
+        vkWaitForFences(P.dev.device, 1, &P.fences[index], VK_TRUE, UINT64_MAX);
+    }
+    P.displayFrames += have_display;
+    if (++P.frames == 1) {
+        fprintf(stderr, "ps4-present: first frame\n");
+    }
+}
+
+extern "C" void ps4_present_stats(uint64_t *frames, uint64_t *display_frames)
+{
+    *frames = P.frames;
+    *display_frames = P.displayFrames;
+}
+
+extern "C" void ps4_present_shutdown(void)
+{
+    if (!P.ready) {
+        return;
+    }
+    nv2a_vk_ps4_queue_lock();
+    vkQueueWaitIdle(P.dev.queue);
+    nv2a_vk_ps4_queue_unlock();
+    if (P.imguiReady) {
+        ImGui_ImplVulkan_Shutdown();
+        ImGui::DestroyContext();
+    }
+    for (uint32_t i = 0; i < P.imageCount; i++) {
+        vkDestroyFence(P.dev.device, P.fences[i], nullptr);
+        vkDestroyFramebuffer(P.dev.device, P.framebuffers[i], nullptr);
+        vkDestroyImageView(P.dev.device, P.views[i], nullptr);
+    }
+    DestroyLastFrame();
+    vkDestroyCommandPool(P.dev.device, P.pool, nullptr);
+    vkDestroyRenderPass(P.dev.device, P.renderPass, nullptr);
+    vkDestroySwapchainKHR(P.dev.device, P.swapchain, nullptr);
+    vkDestroySurfaceKHR(P.dev.instance, P.surface, nullptr);
+    P.ready = false;
+}
diff --git a/ui/ps4/ps4-settings.c b/ui/ps4/ps4-settings.c
new file mode 100644
index 0000000..bef3328
--- /dev/null
+++ b/ui/ps4/ps4-settings.c
@@ -0,0 +1,167 @@
+/*
+ * xemu-ps4: the PS4 frontend's own settings (ps4-settings.h), "key = value" lines in
+ * /data/xemu/ps4.ini. Unknown keys are ignored, missing ones keep their defaults.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "exec/aot.h"
+#include "ps4-settings.h"
+#include "ui/xemu-settings.h"
+
+#define PS4_SETTINGS_PATH "/data/xemu/ps4.ini"
+
+PS4Settings ps4_settings = {
+    .scaling = PS4_SCALE_FIT,
+    .filter = PS4_FILTER_LINEAR,
+    .show_fps = true,
+    .show_stats = true,
+    .cpu_layout = PS4_CPU_PINNED,
+    .voice_workers = 2,
+    .poll_spin_us = -1,
+    .audio_frames = 512,
+    .monitor_log = true,
+    .profiler = false,
+    .tlb_index = true,
+    .auto_profile = true,
+    .audio_resampler = 0,
+    .live_port = 4445,
+    .gdb_port = 0,
+    .boot_launcher = true,
+    .aot = true,
+    .aot_record = true,
+    .aot_direct = true,
+};
+
+typedef struct {
+    const char *key;
+    enum { T_INT, T_BOOL } type;
+    void *value;
+    int min, max;
+} Field;
+
+static const Field fields[] = {
+    { "scaling", T_INT, &ps4_settings.scaling, 0, 2 },
+    { "filter", T_INT, &ps4_settings.filter, 0, 1 },
+    { "show_fps", T_BOOL, &ps4_settings.show_fps, 0, 1 },
+    { "show_stats", T_BOOL, &ps4_settings.show_stats, 0, 1 },
+    { "cpu_layout", T_INT, &ps4_settings.cpu_layout, 0, 1 },
+    { "voice_workers", T_INT, &ps4_settings.voice_workers, 1, 4 },
+    { "poll_spin_us", T_INT, &ps4_settings.poll_spin_us, -1, 1250 },
+    { "audio_frames", T_INT, &ps4_settings.audio_frames, 256, 2048 },
+    { "monitor_log", T_BOOL, &ps4_settings.monitor_log, 0, 1 },
+    { "profiler", T_BOOL, &ps4_settings.profiler, 0, 1 },
+    { "tlb_index", T_BOOL, &ps4_settings.tlb_index, 0, 1 },
+    { "auto_profile", T_BOOL, &ps4_settings.auto_profile, 0, 1 },
+    { "audio_resampler", T_INT, &ps4_settings.audio_resampler, 0, 1 },
+    { "live_port", T_INT, &ps4_settings.live_port, 0, 65535 },
+    { "gdb_port", T_INT, &ps4_settings.gdb_port, 0, 65535 },
+    { "boot_launcher", T_BOOL, &ps4_settings.boot_launcher, 0, 1 },
+    { "aot", T_BOOL, &ps4_settings.aot, 0, 1 },
+    { "aot_record", T_BOOL, &ps4_settings.aot_record, 0, 1 },
+    { "aot_direct", T_BOOL, &ps4_settings.aot_direct, 0, 1 },
+};
+
+void ps4_settings_apply_aot(void)
+{
+    aot_use = ps4_settings.aot;
+    aot_record = ps4_settings.aot_record;
+    aot_direct = ps4_settings.aot_direct;
+}
+
+void ps4_settings_load(void)
+{
+    g_autofree char *text = NULL;
+    if (!g_file_get_contents(PS4_SETTINGS_PATH, &text, NULL, NULL)) {
+        return;
+    }
+    g_auto(GStrv) lines = g_strsplit(text, "\n", -1);
+    for (char **l = lines; *l; l++) {
+        char *eq = strchr(*l, '=');
+        if (**l == '#' || eq == NULL) {
+            continue;
+        }
+        *eq = '\0';
+        const char *key = g_strstrip(*l);
+        const char *val = g_strstrip(eq + 1);
+        for (size_t i = 0; i < ARRAY_SIZE(fields); i++) {
+            if (strcmp(key, fields[i].key) != 0) {
+                continue;
+            }
+            const int v = MAX(fields[i].min, MIN(fields[i].max, atoi(val)));
+            if (fields[i].type == T_BOOL) {
+                *(bool *)fields[i].value = v != 0;
+            } else {
+                *(int *)fields[i].value = v;
+            }
+        }
+    }
+}
+
+void ps4_settings_save(void)
+{
+    GString *s = g_string_new("# xemu-ps4 settings (the quick menu writes this file)\n");
+    for (size_t i = 0; i < ARRAY_SIZE(fields); i++) {
+        const int v = fields[i].type == T_BOOL ? *(bool *)fields[i].value : *(int *)fields[i].value;
+        g_string_append_printf(s, "%s = %d\n", fields[i].key, v);
+    }
+    g_file_set_contents(PS4_SETTINGS_PATH, s->str, s->len, NULL);
+    g_string_free(s, true);
+}
+
+void ps4_settings_describe(GString *out, const char *key)
+{
+    for (size_t i = 0; i < ARRAY_SIZE(fields); i++) {
+        if (key == NULL || strcmp(key, fields[i].key) == 0) {
+            const int v = fields[i].type == T_BOOL ? *(bool *)fields[i].value : *(int *)fields[i].value;
+            g_string_append_printf(out, "%s = %d\n", fields[i].key, v);
+        }
+    }
+    if (key == NULL || strcmp(key, "hrtf") == 0) {
+        g_string_append_printf(out, "hrtf = %d\n", g_config.audio.hrtf);
+    }
+}
+
+bool ps4_settings_set_text(const char *key, const char *value)
+{
+    const int v = atoi(value);
+    if (strcmp(key, "hrtf") == 0) {
+        g_config.audio.hrtf = v != 0;
+        xemu_settings_save();
+        return true;
+    }
+    for (size_t i = 0; i < ARRAY_SIZE(fields); i++) {
+        if (strcmp(key, fields[i].key) != 0) {
+            continue;
+        }
+        const int c = MAX(fields[i].min, MIN(fields[i].max, v));
+        if (fields[i].type == T_BOOL) {
+            *(bool *)fields[i].value = c != 0;
+        } else {
+            *(int *)fields[i].value = c;
+        }
+        if (strncmp(key, "aot", 3) == 0) {
+            ps4_settings_apply_aot();
+        }
+        if (strcmp(key, "poll_spin_us") == 0 && c >= 0) {
+            extern int64_t ps4_poll_spin_ns;
+            ps4_poll_spin_ns = (int64_t)c * 1000;
+        }
+        return true;
+    }
+    return false;
+}
+
+int ps4_voice_resampler(void)
+{
+    return ps4_settings.audio_resampler;
+}
+
+int ps4_voice_workers(void)
+{
+    return ps4_settings.voice_workers;
+}
diff --git a/ui/ps4/ps4-settings.h b/ui/ps4/ps4-settings.h
new file mode 100644
index 0000000..ccd0b88
--- /dev/null
+++ b/ui/ps4/ps4-settings.h
@@ -0,0 +1,74 @@
+/*
+ * xemu-ps4: the PS4 frontend's own settings (/data/xemu/ps4.ini), next to xemu's xemu.toml.
+ * Changed from the quick menu (ps4-hud.cc); "restart" ones apply at the next start.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#ifndef UI_PS4_PS4_SETTINGS_H
+#define UI_PS4_PS4_SETTINGS_H
+
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+    PS4_SCALE_FIT = 0,      /* the game's aspect ratio, as large as fits */
+    PS4_SCALE_STRETCH = 1,  /* the whole 16:9 screen */
+    PS4_SCALE_INTEGER = 2,  /* the largest whole multiple that fits (sharp pixels) */
+};
+
+enum {
+    PS4_FILTER_LINEAR = 0,
+    PS4_FILTER_NEAREST = 1,
+};
+
+enum {
+    PS4_CPU_PINNED = 0,     /* each busy emulation thread on a core of its own (ps4_thread_started) */
+    PS4_CPU_FLOATING = 1,   /* every thread on every core at the system's priority (as v00.15) */
+};
+
+typedef struct PS4Settings {
+    int scaling;            /* PS4_SCALE_* */
+    int filter;             /* PS4_FILTER_* */
+    bool show_fps;          /* frame rate in a corner */
+    bool show_stats;        /* plus GPU and thread load */
+    int cpu_layout;         /* PS4_CPU_* (restart) */
+    int voice_workers;      /* APU voice processing threads, 1..4 (restart) */
+    int poll_spin_us;       /* main loop: spin this long before a deadline; -1 = measured at start */
+    int audio_frames;       /* sound buffer, frames at 48 kHz: 256..2048 (restart) */
+    bool monitor_log;       /* the 5 s monitor line in boot-trace.log */
+    bool profiler;          /* the 1 kHz sampler (samples.log) (restart) */
+    bool tlb_index;         /* TLB dirty index (accel/tcg/cputlb.c) (restart) */
+    bool auto_profile;      /* an 8 s CPU profile when the game runs slowly (profiles/) */
+    int audio_resampler;    /* the APU's voices: 0 linear, 1 sinc (xemu's default) (restart) */
+    int live_port;          /* the live console's TCP port, 0 = off (ps4-live.c) (restart) */
+    int gdb_port;           /* QEMU's GDB stub for the guest CPU, 0 = off (restart) */
+    bool boot_launcher;     /* start in the game library (ps4-launcher.cc) */
+    bool aot;               /* run a game's translated code (/data/xemu/aot/<ID>.aot) (next game) */
+    bool aot_record;        /* write the blocks a game runs as C for the PC's build (next game) */
+    bool aot_direct;        /* translated blocks run the next one without the main loop (live) */
+} PS4Settings;
+
+extern PS4Settings ps4_settings;
+
+void ps4_settings_load(void);
+void ps4_settings_save(void);
+/* the live console (ps4-live.c): "key = value" lines of one or all settings; one set from text
+ * (also "hrtf", xemu's own) - false if there is no such key */
+struct _GString;
+void ps4_settings_describe(struct _GString *out, const char *key);
+bool ps4_settings_set_text(const char *key, const char *value);
+/* aot / aot_record to the translator (accel/tcg/aot.c); they apply at the next game */
+void ps4_settings_apply_aot(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
