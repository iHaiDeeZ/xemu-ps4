+++ b/ui/ps4/ps4-pad.c
@@ -0,0 +1,184 @@
+/*
+ * xemu-ps4: the DualShock 4 as an SDL gamepad. SDL has no PS4 joystick driver; its virtual
+ * gamepad stands in, fed from ScePad each time SDL updates its joysticks, so xemu-input.c binds,
+ * maps and rumbles it like any desktop gamepad (auto-bound to the first free Xbox port).
+ *
+ *   Cross/Circle/Square/Triangle   A/B/X/Y
+ *   L1/R1                          white/black (SDL's shoulders, as xemu maps them)
+ *   L2/R2                          left/right trigger (analog)
+ *   Options                        Start
+ *   touchpad click                 Back
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "ps4-frontend.h"
+
+#include <SDL3/SDL.h>
+#include <orbis/Pad.h>
+#include <orbis/UserService.h>
+
+void ps4_boot_trace(const char *line); /* port/ps4_crashlog.cpp */
+
+typedef struct PS4Pad {
+    int user;
+    int handle;
+    SDL_JoystickID id;
+    SDL_Joystick *joystick;
+    /* reads since start: for the monitor (v00.12: SDL stopped seeing the pad change) */
+    unsigned reads, failures, disconnected, reopens;
+    int last_error;
+    uint32_t last_buttons;
+    unsigned failures_in_a_row;
+} PS4Pad;
+
+static PS4Pad pad = { .user = -1, .handle = -1 };
+
+static const struct {
+    uint32_t ps4;
+    SDL_GamepadButton sdl;
+} button_map[] = {
+    { ORBIS_PAD_BUTTON_CROSS, SDL_GAMEPAD_BUTTON_SOUTH },
+    { ORBIS_PAD_BUTTON_CIRCLE, SDL_GAMEPAD_BUTTON_EAST },
+    { ORBIS_PAD_BUTTON_SQUARE, SDL_GAMEPAD_BUTTON_WEST },
+    { ORBIS_PAD_BUTTON_TRIANGLE, SDL_GAMEPAD_BUTTON_NORTH },
+    { ORBIS_PAD_BUTTON_TOUCH_PAD, SDL_GAMEPAD_BUTTON_BACK },
+    { ORBIS_PAD_BUTTON_OPTIONS, SDL_GAMEPAD_BUTTON_START },
+    { ORBIS_PAD_BUTTON_L3, SDL_GAMEPAD_BUTTON_LEFT_STICK },
+    { ORBIS_PAD_BUTTON_R3, SDL_GAMEPAD_BUTTON_RIGHT_STICK },
+    { ORBIS_PAD_BUTTON_L1, SDL_GAMEPAD_BUTTON_LEFT_SHOULDER },
+    { ORBIS_PAD_BUTTON_R1, SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER },
+    { ORBIS_PAD_BUTTON_UP, SDL_GAMEPAD_BUTTON_DPAD_UP },
+    { ORBIS_PAD_BUTTON_DOWN, SDL_GAMEPAD_BUTTON_DPAD_DOWN },
+    { ORBIS_PAD_BUTTON_LEFT, SDL_GAMEPAD_BUTTON_DPAD_LEFT },
+    { ORBIS_PAD_BUTTON_RIGHT, SDL_GAMEPAD_BUTTON_DPAD_RIGHT },
+};
+
+/* 0..255, centre 128 -> SDL's -32768..32767 */
+static Sint16 stick_axis(uint8_t v)
+{
+    int a = ((int)v - 128) * 256;
+    return (Sint16)MAX(-32768, MIN(32767, a));
+}
+
+/* 0..255 -> SDL's trigger range 0..32767 */
+static Sint16 trigger_axis(uint8_t v)
+{
+    return (Sint16)(v * 32767 / 255);
+}
+
+static void SDLCALL pad_update(void *userdata)
+{
+    OrbisPadData data;
+    memset(&data, 0, sizeof(data));
+    if (pad.joystick == NULL) {
+        return;
+    }
+    int r = scePadReadState(pad.handle, &data);
+    if (r != 0) {
+        pad.failures++;
+        pad.last_error = r;
+        /* a handle gone bad (the pad reconnected, ...): open it again after a second */
+        if (++pad.failures_in_a_row >= 60) {
+            scePadClose(pad.handle);
+            pad.handle = scePadOpen(pad.user, ORBIS_PAD_PORT_TYPE_STANDARD, 0, NULL);
+            if (pad.handle < 0) {
+                pad.handle = scePadGetHandle(pad.user, ORBIS_PAD_PORT_TYPE_STANDARD, 0);
+            }
+            pad.reopens++;
+            pad.failures_in_a_row = 0;
+        }
+        return;
+    }
+    pad.failures_in_a_row = 0;
+    pad.reads++;
+    pad.last_buttons = data.buttons;
+    if (!data.connected) {
+        pad.disconnected++;
+        data.buttons = 0;
+        data.leftStick.x = data.leftStick.y = 128;
+        data.rightStick.x = data.rightStick.y = 128;
+        data.analogButtons.l2 = data.analogButtons.r2 = 0;
+    }
+    for (size_t i = 0; i < ARRAY_SIZE(button_map); i++) {
+        SDL_SetJoystickVirtualButton(pad.joystick, button_map[i].sdl,
+                                     (data.buttons & button_map[i].ps4) != 0);
+    }
+    SDL_SetJoystickVirtualAxis(pad.joystick, SDL_GAMEPAD_AXIS_LEFTX, stick_axis(data.leftStick.x));
+    SDL_SetJoystickVirtualAxis(pad.joystick, SDL_GAMEPAD_AXIS_LEFTY, stick_axis(data.leftStick.y));
+    SDL_SetJoystickVirtualAxis(pad.joystick, SDL_GAMEPAD_AXIS_RIGHTX, stick_axis(data.rightStick.x));
+    SDL_SetJoystickVirtualAxis(pad.joystick, SDL_GAMEPAD_AXIS_RIGHTY, stick_axis(data.rightStick.y));
+    SDL_SetJoystickVirtualAxis(pad.joystick, SDL_GAMEPAD_AXIS_LEFT_TRIGGER,
+                               trigger_axis(data.analogButtons.l2));
+    SDL_SetJoystickVirtualAxis(pad.joystick, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER,
+                               trigger_axis(data.analogButtons.r2));
+}
+
+static bool SDLCALL pad_rumble(void *userdata, Uint16 low, Uint16 high)
+{
+    OrbisPadVibeParam param = { .lgMotor = low >> 8, .smMotor = high >> 8 };
+    return scePadSetVibration(pad.handle, &param) == 0;
+}
+
+void ps4_pad_init(void)
+{
+    char line[128];
+    sceUserServiceInitialize(NULL);
+    scePadInit();
+    int user = -1;
+    if (sceUserServiceGetInitialUser(&user) != 0 || user < 0) {
+        ps4_boot_trace("pad: no initial user");
+        return;
+    }
+    pad.user = user;
+    pad.handle = scePadOpen(user, ORBIS_PAD_PORT_TYPE_STANDARD, 0, NULL);
+    if (pad.handle < 0) {
+        snprintf(line, sizeof(line), "pad: scePadOpen(user %x) failed (%x)", user,
+                 (unsigned)pad.handle);
+        ps4_boot_trace(line);
+        return;
+    }
+
+    SDL_VirtualJoystickDesc desc;
+    SDL_INIT_INTERFACE(&desc);
+    desc.type = SDL_JOYSTICK_TYPE_GAMEPAD;
+    desc.vendor_id = 0x054c;    /* Sony */
+    desc.product_id = 0x09cc;   /* DualShock 4 (v2) */
+    desc.naxes = SDL_GAMEPAD_AXIS_COUNT;
+    desc.nbuttons = SDL_GAMEPAD_BUTTON_DPAD_RIGHT + 1;
+    /* every button and axis the pad has, in SDL's gamepad order: index == SDL_GamepadButton */
+    desc.button_mask = (1u << (SDL_GAMEPAD_BUTTON_DPAD_RIGHT + 1)) - 1;
+    desc.axis_mask = (1u << SDL_GAMEPAD_AXIS_COUNT) - 1;
+    desc.name = "DualShock 4";
+    desc.Update = pad_update;
+    desc.Rumble = pad_rumble;
+
+    pad.id = SDL_AttachVirtualJoystick(&desc);
+    if (pad.id == 0) {
+        snprintf(line, sizeof(line), "pad: SDL_AttachVirtualJoystick: %s", SDL_GetError());
+        ps4_boot_trace(line);
+        return;
+    }
+    /* the gamepad layer opens it for xemu-input; this keeps the virtual device's state */
+    pad.joystick = SDL_OpenJoystick(pad.id);
+    snprintf(line, sizeof(line),
+             "pad: DualShock 4 of user %x (handle %d) as SDL joystick %u, gamepad: %s",
+             user, pad.handle, (unsigned)pad.id, SDL_IsGamepad(pad.id) ? "yes" : "NO");
+    ps4_boot_trace(line);
+}
+
+SDL_JoystickID ps4_pad_joystick_id(void)
+{
+    return pad.id;
+}
+
+void ps4_pad_stats(char *out, size_t size)
+{
+    snprintf(out, size, "pad: %u reads, %u failed (last %x), %u disconnected, %u reopens, "
+             "buttons %x", pad.reads, pad.failures, (unsigned)pad.last_error, pad.disconnected,
+             pad.reopens, pad.last_buttons);
+}
diff --git a/ui/ps4/ps4-present.cc b/ui/ps4/ps4-present.cc
new file mode 100644
index 0000000000..2629a7ba42
--- /dev/null
+++ b/ui/ps4/ps4-present.cc
@@ -0,0 +1,508 @@
+/*
+ * xemu-ps4: presents the emulated display on VideoOut, on the Vulkan renderer's own device and
+ * queue (the PS4 has no OpenGL to hand the picture to, as the desktop frontends do).
+ *
+ * Each frame: clear the swapchain image, blit the renderer's display image into it scaled to
+ * fit, draw the HUD with ImGui's Vulkan backend, present (ps4-wsi.cc: a VideoOut flip behind
+ * the GPU work). The display image belongs to the renderer again once the frame's commands have
+ * finished, so the frame waits for its fence before returning.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "ps4-frontend.h"
+#include "ps4-wsi.h"
+
+#include <volk.h>
+#include "imgui.h"
+#include "backends/imgui_impl_vulkan.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+
+namespace
+{
+constexpr uint32_t kMaxImages = 4;
+
+struct Presenter
+{
+    bool ready = false;
+    NV2AVkDevice dev {};
+    VkSurfaceKHR surface = VK_NULL_HANDLE;
+    VkSwapchainKHR swapchain = VK_NULL_HANDLE;
+    uint32_t imageCount = 0;
+    VkImage images[kMaxImages] {};
+    VkImageView views[kMaxImages] {};
+    VkFramebuffer framebuffers[kMaxImages] {};
+    VkCommandBuffer commands[kMaxImages] {};
+    VkFence fences[kMaxImages] {};
+    VkRenderPass renderPass = VK_NULL_HANDLE;
+    VkCommandPool pool = VK_NULL_HANDLE;
+    bool imguiReady = false;
+    uint64_t frames = 0;
+    uint64_t displayFrames = 0;
+    // the last finished guest frame (a copy of the renderer's display image), shown until the
+    // next: the renderer is asked for the display only when the guest has flipped
+    VkImage last = VK_NULL_HANDLE;
+    VkDeviceMemory lastMemory = VK_NULL_HANDLE;
+    uint32_t lastWidth = 0, lastHeight = 0;
+    bool lastValid = false;
+} P;
+
+bool Check(VkResult r, const char *what);
+
+uint32_t DeviceLocalMemoryType(uint32_t typeBits)
+{
+    VkPhysicalDeviceMemoryProperties props;
+    vkGetPhysicalDeviceMemoryProperties(P.dev.physical_device, &props);
+    for (uint32_t i = 0; i < props.memoryTypeCount; i++) {
+        if ((typeBits & (1u << i)) &&
+            (props.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) {
+            return i;
+        }
+    }
+    return 0;
+}
+
+void DestroyLastFrame()
+{
+    if (P.last != VK_NULL_HANDLE) {
+        vkDestroyImage(P.dev.device, P.last, nullptr);
+        vkFreeMemory(P.dev.device, P.lastMemory, nullptr);
+    }
+    P.last = VK_NULL_HANDLE;
+    P.lastMemory = VK_NULL_HANDLE;
+    P.lastWidth = P.lastHeight = 0;
+    P.lastValid = false;
+}
+
+// The copy of the guest's frame, at the display image's size (made again when that changes;
+// the caller has waited for the GPU)
+bool EnsureLastFrame(uint32_t w, uint32_t h)
+{
+    if (P.last != VK_NULL_HANDLE && P.lastWidth == w && P.lastHeight == h) {
+        return true;
+    }
+    DestroyLastFrame();
+    VkImageCreateInfo ici { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+    ici.imageType = VK_IMAGE_TYPE_2D;
+    ici.format = VK_FORMAT_R8G8B8A8_UNORM;
+    ici.extent = { w, h, 1 };
+    ici.mipLevels = 1;
+    ici.arrayLayers = 1;
+    ici.samples = VK_SAMPLE_COUNT_1_BIT;
+    ici.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ici.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    ici.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (!Check(vkCreateImage(P.dev.device, &ici, nullptr, &P.last), "vkCreateImage (last frame)")) {
+        P.last = VK_NULL_HANDLE;
+        return false;
+    }
+    VkMemoryRequirements req;
+    vkGetImageMemoryRequirements(P.dev.device, P.last, &req);
+    VkMemoryAllocateInfo mai { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    mai.allocationSize = req.size;
+    mai.memoryTypeIndex = DeviceLocalMemoryType(req.memoryTypeBits);
+    if (!Check(vkAllocateMemory(P.dev.device, &mai, nullptr, &P.lastMemory),
+               "vkAllocateMemory (last frame)")) {
+        vkDestroyImage(P.dev.device, P.last, nullptr);
+        P.last = VK_NULL_HANDLE;
+        return false;
+    }
+    vkBindImageMemory(P.dev.device, P.last, P.lastMemory, 0);
+    P.lastWidth = w;
+    P.lastHeight = h;
+    P.lastValid = false;
+    return true;
+}
+
+bool Check(VkResult r, const char *what)
+{
+    if (r != VK_SUCCESS) {
+        fprintf(stderr, "ps4-present: %s failed (%d)\n", what, r);
+        return false;
+    }
+    return true;
+}
+
+void ImageBarrier(VkCommandBuffer cmd, VkImage image, VkImageLayout from, VkImageLayout to,
+                  VkAccessFlags srcAccess, VkAccessFlags dstAccess,
+                  VkPipelineStageFlags srcStage, VkPipelineStageFlags dstStage)
+{
+    VkImageMemoryBarrier b { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER };
+    b.srcAccessMask = srcAccess;
+    b.dstAccessMask = dstAccess;
+    b.oldLayout = from;
+    b.newLayout = to;
+    b.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.image = image;
+    b.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+    vkCmdPipelineBarrier(cmd, srcStage, dstStage, 0, 0, nullptr, 0, nullptr, 1, &b);
+}
+
+bool CreateSwapchain()
+{
+    VkHeadlessSurfaceCreateInfoEXT sci { VK_STRUCTURE_TYPE_HEADLESS_SURFACE_CREATE_INFO_EXT };
+    if (!Check(vkCreateHeadlessSurfaceEXT(P.dev.instance, &sci, nullptr, &P.surface),
+               "vkCreateHeadlessSurfaceEXT")) {
+        return false;
+    }
+
+    VkSwapchainCreateInfoKHR ci { VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR };
+    ci.surface = P.surface;
+    ci.minImageCount = 3;
+    ci.imageFormat = VK_FORMAT_R8G8B8A8_UNORM;
+    ci.imageColorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+    ci.imageExtent = { ps4wsi::kWidth, ps4wsi::kHeight };
+    ci.imageArrayLayers = 1;
+    ci.imageUsage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    ci.imageSharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    ci.preTransform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+    ci.compositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+    ci.presentMode = VK_PRESENT_MODE_FIFO_KHR;
+    ci.clipped = VK_TRUE;
+    if (!Check(vkCreateSwapchainKHR(P.dev.device, &ci, nullptr, &P.swapchain),
+               "vkCreateSwapchainKHR")) {
+        return false;
+    }
+    P.imageCount = kMaxImages;
+    if (!Check(vkGetSwapchainImagesKHR(P.dev.device, P.swapchain, &P.imageCount, P.images),
+               "vkGetSwapchainImagesKHR")) {
+        return false;
+    }
+
+    VkAttachmentDescription color {};
+    color.format = VK_FORMAT_R8G8B8A8_UNORM;
+    color.samples = VK_SAMPLE_COUNT_1_BIT;
+    color.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;      // the picture blitted before
+    color.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    color.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+    color.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+    color.initialLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    color.finalLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+    VkAttachmentReference ref { 0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL };
+    VkSubpassDescription sub {};
+    sub.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+    sub.colorAttachmentCount = 1;
+    sub.pColorAttachments = &ref;
+    VkRenderPassCreateInfo rpi { VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO };
+    rpi.attachmentCount = 1;
+    rpi.pAttachments = &color;
+    rpi.subpassCount = 1;
+    rpi.pSubpasses = &sub;
+    if (!Check(vkCreateRenderPass(P.dev.device, &rpi, nullptr, &P.renderPass),
+               "vkCreateRenderPass")) {
+        return false;
+    }
+
+    VkCommandPoolCreateInfo pci { VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO };
+    pci.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    pci.queueFamilyIndex = P.dev.queue_family;
+    if (!Check(vkCreateCommandPool(P.dev.device, &pci, nullptr, &P.pool), "vkCreateCommandPool")) {
+        return false;
+    }
+    VkCommandBufferAllocateInfo cai { VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO };
+    cai.commandPool = P.pool;
+    cai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    cai.commandBufferCount = P.imageCount;
+    if (!Check(vkAllocateCommandBuffers(P.dev.device, &cai, P.commands),
+               "vkAllocateCommandBuffers")) {
+        return false;
+    }
+
+    for (uint32_t i = 0; i < P.imageCount; i++) {
+        VkImageViewCreateInfo vi { VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+        vi.image = P.images[i];
+        vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        vi.format = VK_FORMAT_R8G8B8A8_UNORM;
+        vi.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+        if (!Check(vkCreateImageView(P.dev.device, &vi, nullptr, &P.views[i]),
+                   "vkCreateImageView")) {
+            return false;
+        }
+        VkFramebufferCreateInfo fi { VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO };
+        fi.renderPass = P.renderPass;
+        fi.attachmentCount = 1;
+        fi.pAttachments = &P.views[i];
+        fi.width = ps4wsi::kWidth;
+        fi.height = ps4wsi::kHeight;
+        fi.layers = 1;
+        if (!Check(vkCreateFramebuffer(P.dev.device, &fi, nullptr, &P.framebuffers[i]),
+                   "vkCreateFramebuffer")) {
+            return false;
+        }
+        VkFenceCreateInfo fci { VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+        fci.flags = VK_FENCE_CREATE_SIGNALED_BIT;
+        if (!Check(vkCreateFence(P.dev.device, &fci, nullptr, &P.fences[i]), "vkCreateFence")) {
+            return false;
+        }
+    }
+    fprintf(stderr, "ps4-present: swapchain of %u images %ux%u\n", P.imageCount,
+            ps4wsi::kWidth, ps4wsi::kHeight);
+    return true;
+}
+
+PFN_vkVoidFunction ImGuiLoader(const char *name, void *)
+{
+    PFN_vkVoidFunction fn = vkGetDeviceProcAddr(P.dev.device, name);
+    return fn ? fn : vkGetInstanceProcAddr(P.dev.instance, name);
+}
+
+bool InitImGui()
+{
+    IMGUI_CHECKVERSION();
+    ImGui::CreateContext();
+    ImGuiIO &io = ImGui::GetIO();
+    io.IniFilename = nullptr;
+    io.DisplaySize = ImVec2((float)ps4wsi::kWidth, (float)ps4wsi::kHeight);
+    io.ConfigFlags |= ImGuiConfigFlags_NavEnableGamepad;
+    io.FontGlobalScale = 2.0f;      // sized for a TV across the room
+    ImGui::StyleColorsDark();
+    ImGui::GetStyle().ScaleAllSizes(2.0f);
+
+    if (!ImGui_ImplVulkan_LoadFunctions(ImGuiLoader)) {
+        fprintf(stderr, "ps4-present: ImGui_ImplVulkan_LoadFunctions failed\n");
+        return false;
+    }
+    ImGui_ImplVulkan_InitInfo info {};
+    info.Instance = P.dev.instance;
+    info.PhysicalDevice = P.dev.physical_device;
+    info.Device = P.dev.device;
+    info.QueueFamily = P.dev.queue_family;
+    info.Queue = P.dev.queue;
+    info.RenderPass = P.renderPass;
+    info.MinImageCount = 2;
+    info.ImageCount = P.imageCount;
+    info.MSAASamples = VK_SAMPLE_COUNT_1_BIT;
+    info.DescriptorPoolSize = 64;
+    if (!ImGui_ImplVulkan_Init(&info)) {
+        fprintf(stderr, "ps4-present: ImGui_ImplVulkan_Init failed\n");
+        return false;
+    }
+    return true;
+}
+
+// The display image's rectangle on the screen: as large as fits, its own aspect ratio
+VkRect2D FitRect(uint32_t w, uint32_t h)
+{
+    const float sx = (float)ps4wsi::kWidth / w, sy = (float)ps4wsi::kHeight / h;
+    const float s = std::min(sx, sy);
+    const uint32_t dw = (uint32_t)(w * s), dh = (uint32_t)(h * s);
+    VkRect2D r;
+    r.offset = { (int32_t)(ps4wsi::kWidth - dw) / 2, (int32_t)(ps4wsi::kHeight - dh) / 2 };
+    r.extent = { dw, dh };
+    return r;
+}
+
+void Record(VkCommandBuffer cmd, uint32_t index, bool haveDisplay, ImDrawData *drawData)
+{
+    VkCommandBufferBeginInfo bi { VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+    bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    vkBeginCommandBuffer(cmd, &bi);
+
+    VkImage target = P.images[index];
+    ImageBarrier(cmd, target, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                 0, VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                 VK_PIPELINE_STAGE_TRANSFER_BIT);
+    VkClearColorValue black {};
+    VkImageSubresourceRange all { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+    vkCmdClearColorImage(cmd, target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &black, 1, &all);
+
+    // a new guest frame: copied out of the renderer's display image, which is the renderer's
+    // again once this command buffer has run (ps4_present_frame waits for that)
+    VkImage display = VK_NULL_HANDLE;
+    VkImageView view;
+    uint32_t w, h;
+    if (haveDisplay && nv2a_vk_ps4_get_display(&display, &view, &w, &h) && w == P.lastWidth &&
+        h == P.lastHeight && P.last != VK_NULL_HANDLE) {
+        ImageBarrier(cmd, display, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+                     VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                     VK_ACCESS_TRANSFER_READ_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                     VK_PIPELINE_STAGE_TRANSFER_BIT);
+        ImageBarrier(cmd, P.last,
+                     P.lastValid ? VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL : VK_IMAGE_LAYOUT_UNDEFINED,
+                     VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_ACCESS_TRANSFER_READ_BIT,
+                     VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                     VK_PIPELINE_STAGE_TRANSFER_BIT);
+        VkImageCopy copy {};
+        copy.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+        copy.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+        copy.extent = { w, h, 1 };
+        vkCmdCopyImage(cmd, display, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, P.last,
+                       VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+        // back to where the renderer left it
+        ImageBarrier(cmd, display, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                     VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_ACCESS_TRANSFER_READ_BIT, 0,
+                     VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT);
+        ImageBarrier(cmd, P.last, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                     VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT,
+                     VK_ACCESS_TRANSFER_READ_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                     VK_PIPELINE_STAGE_TRANSFER_BIT);
+        P.lastValid = true;
+    }
+
+    // the last guest frame, every presented frame, scaled to fit
+    if (P.lastValid) {
+        ImageBarrier(cmd, target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                     VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT,
+                     VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                     VK_PIPELINE_STAGE_TRANSFER_BIT);
+        const uint32_t lw = P.lastWidth, lh = P.lastHeight;
+        const VkRect2D dst = FitRect(lw, lh);
+        VkImageBlit blit {};
+        blit.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+        // the renderer stores the display bottom-up for the desktop's OpenGL presenter ("GL
+        // compat" in vk/display.c): read it from the last row up
+        blit.srcOffsets[0] = { 0, (int32_t)lh, 0 };
+        blit.srcOffsets[1] = { (int32_t)lw, 0, 1 };
+        blit.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+        blit.dstOffsets[0] = { dst.offset.x, dst.offset.y, 0 };
+        blit.dstOffsets[1] = { dst.offset.x + (int32_t)dst.extent.width,
+                               dst.offset.y + (int32_t)dst.extent.height, 1 };
+        vkCmdBlitImage(cmd, P.last, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, target,
+                       VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, VK_FILTER_LINEAR);
+    }
+
+    ImageBarrier(cmd, target, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                 VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT,
+                 VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                 VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT);
+
+    VkRenderPassBeginInfo rbi { VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO };
+    rbi.renderPass = P.renderPass;
+    rbi.framebuffer = P.framebuffers[index];
+    rbi.renderArea.extent = { ps4wsi::kWidth, ps4wsi::kHeight };
+    vkCmdBeginRenderPass(cmd, &rbi, VK_SUBPASS_CONTENTS_INLINE);
+    if (drawData) {
+        ImGui_ImplVulkan_RenderDrawData(drawData, cmd);
+    }
+    vkCmdEndRenderPass(cmd);
+    vkEndCommandBuffer(cmd);
+}
+} // namespace
+
+extern "C" bool ps4_present_ready(void)
+{
+    return P.ready;
+}
+
+extern "C" bool ps4_present_init(const NV2AVkDevice *dev)
+{
+    static bool failed;
+    if (failed) {
+        return false;
+    }
+    P.dev = *dev;
+    if (!CreateSwapchain() || !InitImGui()) {
+        failed = true;
+        return false;
+    }
+    P.imguiReady = true;
+    P.ready = true;
+    return true;
+}
+
+extern "C" void ps4_present_frame(bool have_display)
+{
+    if (!P.ready) {
+        return;
+    }
+
+    // a new display size (the guest's video mode): the last-frame copy follows, once the GPU
+    // is done with the old one
+    if (have_display) {
+        VkImage display;
+        VkImageView view;
+        uint32_t w, h;
+        if (nv2a_vk_ps4_get_display(&display, &view, &w, &h) && w && h &&
+            (w != P.lastWidth || h != P.lastHeight)) {
+            nv2a_vk_ps4_queue_lock();
+            vkQueueWaitIdle(P.dev.queue);
+            nv2a_vk_ps4_queue_unlock();
+            EnsureLastFrame(w, h);
+        }
+    }
+
+    // the ImGui frame (its first NewFrame uploads the font texture through the shared queue)
+    nv2a_vk_ps4_queue_lock();
+    ImGui_ImplVulkan_NewFrame();
+    nv2a_vk_ps4_queue_unlock();
+    ImGui::NewFrame();
+    ps4_hud_draw();
+    ImGui::Render();
+
+    uint32_t index = 0;
+    nv2a_vk_ps4_queue_lock();
+    VkResult r = vkAcquireNextImageKHR(P.dev.device, P.swapchain, UINT64_MAX, VK_NULL_HANDLE,
+                                       VK_NULL_HANDLE, &index);
+    nv2a_vk_ps4_queue_unlock();
+    if (!Check(r, "vkAcquireNextImageKHR")) {
+        return;
+    }
+
+    vkWaitForFences(P.dev.device, 1, &P.fences[index], VK_TRUE, UINT64_MAX);
+    vkResetFences(P.dev.device, 1, &P.fences[index]);
+    VkCommandBuffer cmd = P.commands[index];
+    vkResetCommandBuffer(cmd, 0);
+    Record(cmd, index, have_display, ImGui::GetDrawData());
+
+    VkSubmitInfo si { VK_STRUCTURE_TYPE_SUBMIT_INFO };
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &cmd;
+    VkPresentInfoKHR pi { VK_STRUCTURE_TYPE_PRESENT_INFO_KHR };
+    pi.swapchainCount = 1;
+    pi.pSwapchains = &P.swapchain;
+    pi.pImageIndices = &index;
+
+    nv2a_vk_ps4_queue_lock();
+    r = vkQueueSubmit(P.dev.queue, 1, &si, P.fences[index]);
+    if (Check(r, "vkQueueSubmit")) {
+        Check(vkQueuePresentKHR(P.dev.queue, &pi), "vkQueuePresentKHR");
+    }
+    nv2a_vk_ps4_queue_unlock();
+
+    // the display image is the renderer's again once the blit has run
+    if (have_display) {
+        vkWaitForFences(P.dev.device, 1, &P.fences[index], VK_TRUE, UINT64_MAX);
+    }
+    P.displayFrames += have_display;
+    if (++P.frames == 1) {
+        fprintf(stderr, "ps4-present: first frame\n");
+    }
+}
+
+extern "C" void ps4_present_stats(uint64_t *frames, uint64_t *display_frames)
+{
+    *frames = P.frames;
+    *display_frames = P.displayFrames;
+}
+
+extern "C" void ps4_present_shutdown(void)
+{
+    if (!P.ready) {
+        return;
+    }
+    nv2a_vk_ps4_queue_lock();
+    vkQueueWaitIdle(P.dev.queue);
+    nv2a_vk_ps4_queue_unlock();
+    if (P.imguiReady) {
+        ImGui_ImplVulkan_Shutdown();
+        ImGui::DestroyContext();
+    }
+    for (uint32_t i = 0; i < P.imageCount; i++) {
+        vkDestroyFence(P.dev.device, P.fences[i], nullptr);
+        vkDestroyFramebuffer(P.dev.device, P.framebuffers[i], nullptr);
+        vkDestroyImageView(P.dev.device, P.views[i], nullptr);
+    }
+    DestroyLastFrame();
+    vkDestroyCommandPool(P.dev.device, P.pool, nullptr);
+    vkDestroyRenderPass(P.dev.device, P.renderPass, nullptr);
+    vkDestroySwapchainKHR(P.dev.device, P.swapchain, nullptr);
+    vkDestroySurfaceKHR(P.dev.instance, P.surface, nullptr);
+    P.ready = false;
+}
