diff --git a/target/i386/tcg/aot-i386.c b/target/i386/tcg/aot-i386.c
new file mode 100644
index 0000000..9c28d62
--- /dev/null
+++ b/target/i386/tcg/aot-i386.c
@@ -0,0 +1,216 @@
+/*
+ * xemu-ps4: the x86 side of the ahead-of-time translator (include/exec/aot.h).
+ *
+ * - aot_abi.h: the offsets the generated C uses (scripts/aot_rt.h includes it), and
+ *   a key over them that a .aot must match to be loaded;
+ * - the helpers by name, for the .aot's imports;
+ * - the trampoline TB: a block of the guest's code that the .aot has (same flags,
+ *   same bytes) becomes one TB whose code calls helper_aot_run, then looks up the
+ *   next TB at whatever eip the compiled code left.
+ *
+ * This program is free software; you can redistribute it and/or modify it under
+ * the terms of the GNU General Public License as published by the Free Software
+ * Foundation; either version 2 of the License, or (at your option) any later
+ * version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/fast-hash.h"
+#include "cpu.h"
+#include "exec/aot.h"
+#include "exec/translation-block.h"
+#include "exec/translator.h"
+#include "exec/target_page.h"
+#include "exec/tlb-common.h"
+#include "tcg/tcg.h"
+#include "tcg/tcg-op.h"
+#include "tcg/tcg-ldst.h"
+#include "exec/helper-proto.h"
+#include "exec/helper-gen-common.h"
+#include "helper-tcg.h"
+#include "aot-i386.h"
+
+/* --- helpers by name ----------------------------------------------------------------------- */
+
+#undef DEF_HELPER_FLAGS_0
+#undef DEF_HELPER_FLAGS_1
+#undef DEF_HELPER_FLAGS_2
+#undef DEF_HELPER_FLAGS_3
+#undef DEF_HELPER_FLAGS_4
+#undef DEF_HELPER_FLAGS_5
+#undef DEF_HELPER_FLAGS_6
+#undef DEF_HELPER_FLAGS_7
+#define AOT_H_ENTRY(name) { stringify(name), (void *)HELPER(name) },
+#define DEF_HELPER_FLAGS_0(name, f, r) AOT_H_ENTRY(name)
+#define DEF_HELPER_FLAGS_1(name, f, r, a) AOT_H_ENTRY(name)
+#define DEF_HELPER_FLAGS_2(name, f, r, a, b) AOT_H_ENTRY(name)
+#define DEF_HELPER_FLAGS_3(name, f, r, a, b, c) AOT_H_ENTRY(name)
+#define DEF_HELPER_FLAGS_4(name, f, r, a, b, c, d) AOT_H_ENTRY(name)
+#define DEF_HELPER_FLAGS_5(name, f, r, a, b, c, d, e) AOT_H_ENTRY(name)
+#define DEF_HELPER_FLAGS_6(name, f, r, a, b, c, d, e, g) AOT_H_ENTRY(name)
+#define DEF_HELPER_FLAGS_7(name, f, r, a, b, c, d, e, g, h) AOT_H_ENTRY(name)
+
+/* plain .data: in .data.rel.ro it made PacBrew create-fself emit the data segment twice */
+static AotHelperName aot_i386_helpers[] = {
+#include "helper.h"
+#include "accel/tcg/tcg-runtime.h"
+    /* the TLB-miss paths of guest loads and stores (tcg/tcg-ldst.h) */
+    { "ldub_mmu", (void *)helper_ldub_mmu },
+    { "lduw_mmu", (void *)helper_lduw_mmu },
+    { "ldul_mmu", (void *)helper_ldul_mmu },
+    { "ldq_mmu", (void *)helper_ldq_mmu },
+    { "ld16_mmu", (void *)helper_ld16_mmu },
+    { "stb_mmu", (void *)helper_stb_mmu },
+    { "stw_mmu", (void *)helper_stw_mmu },
+    { "stl_mmu", (void *)helper_stl_mmu },
+    { "stq_mmu", (void *)helper_stq_mmu },
+    { "st16_mmu", (void *)helper_st16_mmu },
+};
+
+/* --- the ABI the generated C was written against -------------------------------------------- */
+
+static AotTarget aot_i386;
+
+static void aot_i386_restore(CPUState *cpu, uint32_t pc, int cc_op)
+{
+    CPUX86State *env = cpu_env(cpu);
+
+    env->eip = pc;                  /* translated blocks run with a flat CS (base 0) */
+    if (cc_op >= 0 && cc_op < CC_OP_DYNAMIC) {
+        env->cc_op = cc_op;
+    }
+}
+
+static int aot_i386_flags_ok(uint32_t flags)
+{
+    return (flags & HF_PE_MASK) && (flags & HF_CS32_MASK) && (flags & HF_SS32_MASK) &&
+           !(flags & HF_VM_MASK);
+}
+
+void aot_i386_register(void)
+{
+    GString *h = g_string_new(NULL);
+    const char *regs[8] = { "EAX", "ECX", "EDX", "EBX", "ESP", "EBP", "ESI", "EDI" };
+    const int reg_idx[8] = { R_EAX, R_ECX, R_EDX, R_EBX, R_ESP, R_EBP, R_ESI, R_EDI };
+
+    g_string_append(h, "/* written by xemu-ps4 (target/i386/tcg/aot-i386.c): this build's layout */\n");
+    for (int i = 0; i < 8; i++) {
+        g_string_append_printf(h, "#define AOT_OFF_%s %zu\n", regs[i],
+                               offsetof(CPUX86State, regs[reg_idx[i]]));
+    }
+    g_string_append_printf(h, "#define AOT_OFF_EIP %zu\n", offsetof(CPUX86State, eip));
+    g_string_append_printf(h, "#define AOT_OFF_CC_DST %zu\n", offsetof(CPUX86State, cc_dst));
+    g_string_append_printf(h, "#define AOT_OFF_CC_SRC %zu\n", offsetof(CPUX86State, cc_src));
+    g_string_append_printf(h, "#define AOT_OFF_CC_OP %zu\n", offsetof(CPUX86State, cc_op));
+    g_string_append_printf(h, "#define AOT_PAGE_BITS %d\n", TARGET_PAGE_BITS);
+    g_string_append_printf(h, "#define AOT_TLB_ENTRY_BITS %d\n", CPU_TLB_ENTRY_BITS);
+    g_string_append_printf(h, "#define AOT_TLBF_MASK %zu\n", offsetof(CPUTLBDescFast, mask));
+    g_string_append_printf(h, "#define AOT_TLBF_TABLE %zu\n", offsetof(CPUTLBDescFast, table));
+    g_string_append_printf(h, "#define AOT_TLBE_READ %zu\n", offsetof(CPUTLBEntry, addr_read));
+    g_string_append_printf(h, "#define AOT_TLBE_WRITE %zu\n", offsetof(CPUTLBEntry, addr_write));
+    g_string_append_printf(h, "#define AOT_TLBE_ADDEND %zu\n", offsetof(CPUTLBEntry, addend));
+    g_string_append_printf(h, "#define AOT_CC_OP_DYNAMIC %d\n", CC_OP_DYNAMIC);
+    /* not used by the C, but any change to them changes the env offsets the C embeds */
+    g_string_append_printf(h, "#define AOT_SIZEOF_ENV %zu\n", sizeof(CPUX86State));
+    g_string_append_printf(h, "#define AOT_OFF_XMM %zu\n", offsetof(CPUX86State, xmm_regs));
+    g_string_append_printf(h, "#define AOT_OFF_FPREGS %zu\n", offsetof(CPUX86State, fpregs));
+    g_string_append_printf(h, "#define AOT_OFF_FPSTT %zu\n", offsetof(CPUX86State, fpstt));
+    g_string_append_printf(h, "#define AOT_OFF_MXCSR %zu\n", offsetof(CPUX86State, mxcsr));
+    g_string_append_printf(h, "#define AOT_OFF_SEGS %zu\n", offsetof(CPUX86State, segs));
+    g_string_append_printf(h, "#define AOT_OFF_ENV %zu\n", offsetof(X86CPU, env));
+    g_string_append_printf(h, "#define AOT_NEG_SIZE %zu\n", sizeof(CPUNegativeOffsetState));
+    g_string_append_printf(h, "#define AOT_FORMAT 1\n");
+    aot_i386.abi_key = fast_hash((const uint8_t *)h->str, h->len);
+    g_string_append_printf(h, "#define AOT_ABI_KEY 0x%016" PRIx64 "ull\n", aot_i386.abi_key);
+
+    aot_i386.abi_header = g_string_free(h, false);
+    aot_i386.helpers = aot_i386_helpers;
+    aot_i386.nb_helpers = ARRAY_SIZE(aot_i386_helpers);
+    aot_i386.restore = aot_i386_restore;
+    aot_i386.title_flags_ok = aot_i386_flags_ok;
+    aot_register_target(&aot_i386);
+}
+
+/* --- the trampoline TB ------------------------------------------------------------------------ */
+
+typedef struct AotDisas {
+    DisasContextBase base;
+    int id;
+    uint16_t size;
+} AotDisas;
+
+static void aot_tr_init(DisasContextBase *db, CPUState *cpu)
+{
+}
+
+static void aot_tr_tb_start(DisasContextBase *db, CPUState *cpu)
+{
+}
+
+static void aot_tr_insn_start(DisasContextBase *db, CPUState *cpu)
+{
+    target_ulong pc_arg = db->pc_next;
+
+    if (tb_cflags(db->tb) & CF_PCREL) {
+        pc_arg &= ~TARGET_PAGE_MASK;
+    }
+    tcg_gen_insn_start(pc_arg, CC_OP_DYNAMIC);
+}
+
+static void aot_tr_translate_insn(DisasContextBase *db, CPUState *cpu)
+{
+    AotDisas *d = container_of(db, AotDisas, base);
+    CPUX86State *env = cpu_env(cpu);
+
+    /* read the block's bytes the way the decoder would: the TB covers them all */
+    for (unsigned i = 0; i < d->size; i++) {
+        translator_ldub(env, db, db->pc_first + i);
+    }
+    db->pc_next = db->pc_first + d->size;
+    db->is_jmp = DISAS_NORETURN;
+}
+
+static void aot_tr_tb_stop(DisasContextBase *db, CPUState *cpu)
+{
+    AotDisas *d = container_of(db, AotDisas, base);
+
+    gen_helper_aot_run(tcg_env, tcg_constant_i32(d->id));
+    /*
+     * Back to the main loop, not straight to the next TB (lookup_and_goto_ptr): translated code
+     * leaves when a block ends with exit_tb(0) - after STI, MOV SS, POPF and the like, so that
+     * cpu_handle_interrupt delivers what became deliverable - or on an exit request. Going on
+     * without the main loop starved the Xbox kernel's idle loop (STI; NOP; NOP; CLI) of its
+     * timer interrupt: Crash never left it (v00.24).
+     */
+    tcg_gen_exit_tb(NULL, 0);
+}
+
+static const TranslatorOps aot_tr_ops = {
+    .init_disas_context = aot_tr_init,
+    .tb_start = aot_tr_tb_start,
+    .insn_start = aot_tr_insn_start,
+    .translate_insn = aot_tr_translate_insn,
+    .tb_stop = aot_tr_tb_stop,
+};
+
+bool aot_i386_translate(CPUState *cpu, TranslationBlock *tb, int *max_insns, vaddr pc,
+                        void *host_pc)
+{
+    AotDisas d = { 0 };
+    uint16_t size = 0;
+    int id;
+
+    tb->aot_id = 0;
+    if (*max_insns < TCG_MAX_INSNS) {
+        return false;       /* a limited TB (I/O, an exception's retry): the JIT's */
+    }
+    id = aot_find(cpu, tb, pc, &size);
+    if (!id) {
+        return false;
+    }
+    d.id = id;
+    d.size = size;
+    tb->aot_id = id;
+    translator_loop(cpu, tb, max_insns, pc, host_pc, &aot_tr_ops, &d.base);
+    return true;
+}
