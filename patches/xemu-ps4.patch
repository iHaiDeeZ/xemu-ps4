diff --git a/include/exec/aot.h b/include/exec/aot.h
new file mode 100644
index 0000000..4f897ed
--- /dev/null
+++ b/include/exec/aot.h
@@ -0,0 +1,92 @@
+/*
+ * xemu-ps4: the ahead-of-time translator ("translated game code").
+ *
+ * While a game runs, every block the JIT translates is also written out as C
+ * (tcg/tcg-aot.c.inc) into /data/xemu/aot/<title ID>/. A PC compiles those files
+ * with clang (scripts/aot-build.py) into /data/xemu/aot/<title ID>.aot, which the
+ * next start of that game loads: a block found there with the same code bytes runs
+ * the compiled code (a "trampoline" TB that calls it) instead of the JIT's.
+ *
+ * This program is free software; you can redistribute it and/or modify it under
+ * the terms of the GNU General Public License as published by the Free Software
+ * Foundation; either version 2 of the License, or (at your option) any later
+ * version.
+ */
+
+#ifndef EXEC_AOT_H
+#define EXEC_AOT_H
+
+#include "exec/vaddr.h"
+
+typedef struct TCGContext TCGContext;
+typedef struct TranslationBlock TranslationBlock;
+typedef struct CPUState CPUState;
+
+/* settings (ui/ps4/ps4-settings.c): run a loaded .aot, record blocks */
+extern bool aot_use;
+extern bool aot_record;
+/* the next translated block straight from the last one's return when nothing is pending */
+extern bool aot_direct;
+
+/* set while blocks are written (tcg_gen_code calls aot_record_tb) / a .aot is loaded */
+extern bool aot_recording;
+extern bool aot_loaded;
+
+/*
+ * The game that starts now (its XBE's title ID; 0 = none): loads its .aot and opens
+ * its recording folder. Call with the machine not running code (before a reset/start).
+ */
+void aot_set_title(uint32_t title_id);
+
+/* tcg_gen_code, after liveness: write this TB as C (if it qualifies) */
+void aot_record_tb(TCGContext *s, TranslationBlock *tb, vaddr pc);
+/* tcg/tcg-aot.c.inc: the TB's ops as C; false with *why if they can't be */
+bool tcg_aot_emit_tb(TCGContext *s, const TranslationBlock *tb, uint64_t pc,
+                     GString *out, const char **why);
+
+/* The translated block for this TB (pc, flags, cflags, code bytes), or 0. */
+int aot_find(CPUState *cpu, const TranslationBlock *tb, vaddr pc, uint16_t *size);
+/* x86_translate_code: called for the trampoline TB's helper */
+void aot_entered(int id);
+
+/* invalidation: a trampoline TB went away; the TLB or the TB cache was flushed */
+void aot_tb_invalidated(int id);
+void aot_tlb_flushed(void);
+void aot_tlb_flushed_page(vaddr addr);
+void aot_tlb_flushed_range(vaddr addr, vaddr len);
+void aot_tb_flushed(void);
+
+/* cpu_restore_state / cpu_unwind_state_data for a host pc inside translated code */
+bool aot_restore_state(CPUState *cpu, uintptr_t host_pc);
+bool aot_unwind_state_data(CPUState *cpu, uintptr_t host_pc, uint64_t *data);
+
+/* the live console: drop the loaded file, or load the current game's again (machine stopped) */
+const char *aot_switch(bool load);
+
+/* one line for the monitor / the live console's "aot" command */
+void aot_stats(GString *out, bool verbose);
+
+/* the live console's "aot exits [on|off|clear]": why translated code returns to the main loop */
+void aot_exits(GString *out, const char *args);
+
+/*
+ * The target's part (target/i386/tcg/aot-i386.c): the ABI header the generated C
+ * includes, its key, the helpers by name, and how env's eip / cc_op are restored.
+ */
+typedef struct AotHelperName {
+    const char *name;
+    void *func;
+} AotHelperName;
+
+typedef struct AotTarget {
+    const char *abi_header;          /* aot_abi.h's text */
+    uint64_t abi_key;
+    const AotHelperName *helpers;
+    size_t nb_helpers;
+    void (*restore)(CPUState *cpu, uint32_t pc, int cc_op);
+    int (*title_flags_ok)(uint32_t flags);   /* blocks worth recording (protected mode) */
+} AotTarget;
+
+void aot_register_target(const AotTarget *t);
+
+#endif
