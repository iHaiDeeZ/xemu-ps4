+    int poll_spin_us;       /* main loop: spin this long before a deadline; -1 = measured at start */
+    int audio_frames;       /* sound buffer, frames at 48 kHz: 256..2048 (restart) */
+    bool monitor_log;       /* the 5 s monitor line in boot-trace.log */
+    bool profiler;          /* the 1 kHz sampler (samples.log) (restart) */
+    bool tlb_index;         /* TLB dirty index (accel/tcg/cputlb.c) (restart) */
+    bool auto_profile;      /* an 8 s CPU profile when the game runs slowly (profiles/) */
