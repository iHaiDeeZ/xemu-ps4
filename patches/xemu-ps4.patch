  * otherwise identical to g_poll
  */
+#ifdef __PS4__
+/*
+ * xemu-ps4: the PS4's libkernel has no ppoll, and the XBOX busy-wait below (for Windows' coarse
+ * sleeps) spins on every deadline under 1.25 ms: with the Xbox kernel's 1 kHz timer tick that is
+ * nearly always, so QEMU's main loop kept a whole core busy (v00.15) - and the PS4 gives threads of
+ * one priority no turns, so whatever shared that core waited. pselect takes nanoseconds: sleep until
+ * shortly before the deadline, then spin only the margin the PS4's sleeps overshoot by, which the
+ * frontend measures at start (ui/ps4/xemu-ps4.c sets ps4_poll_spin_ns).
+ */
+#include <sys/select.h>
+
+int64_t ps4_poll_spin_ns = 300000;
+/*
+ * Waits shorter than this are slept with ps4_poll_short_sleep instead of pselect, whose timeouts
+ * the PS4 rounds to its scheduler tick (~1 ms: a 300 us pselect took ~950 us in v00.16): the fds
+ * are polled before and after it. 0: pselect always. Both set by the frontend's measurement.
+ */
+int64_t ps4_poll_short_ns;
+void (*ps4_poll_short_sleep)(int64_t ns);
+/* for the frontend's monitor: waits, of them slept in pselect, ns spun */
+uint64_t ps4_poll_waits, ps4_poll_sleeps, ps4_poll_spin_total_ns;
+
+static int ps4_poll_ns(GPollFD *fds, guint nfds, int64_t timeout)
+{
+    if (timeout == 0) {
+        return g_poll(fds, nfds, 0);
+    }
+    if (timeout < 0) {
+        return g_poll(fds, nfds, -1);
+    }
+    const int64_t start = get_clock();
+    const int64_t deadline = start + timeout;
+    const int64_t sleep_ns = timeout - qatomic_read(&ps4_poll_spin_ns);
+    ps4_poll_waits++;
+    if (sleep_ns > 0 && sleep_ns < ps4_poll_short_ns && ps4_poll_short_sleep != NULL) {
+        int r = g_poll(fds, nfds, 0);
+        if (r != 0) {
+            return r;
+        }
+        ps4_poll_sleeps++;
+        ps4_poll_short_sleep(sleep_ns);
+    } else if (sleep_ns > 0) {
+        fd_set rd, wr, ex;
+        int maxfd = -1;
+        FD_ZERO(&rd);
+        FD_ZERO(&wr);
+        FD_ZERO(&ex);
+        for (guint i = 0; i < nfds; i++) {
+            const int fd = fds[i].fd;
+            fds[i].revents = 0;
+            if (fd < 0 || fd >= FD_SETSIZE) {
+                continue;
+            }
+            if (fds[i].events & (G_IO_IN | G_IO_HUP | G_IO_ERR)) {
+                FD_SET(fd, &rd);
+            }
+            if (fds[i].events & G_IO_OUT) {
+                FD_SET(fd, &wr);
+            }
+            if (fds[i].events & G_IO_PRI) {
+                FD_SET(fd, &ex);
+            }
+            maxfd = MAX(maxfd, fd);
+        }
+        struct timespec ts = {
+            .tv_sec = sleep_ns / 1000000000LL,
+            .tv_nsec = sleep_ns % 1000000000LL,
+        };
+        ps4_poll_sleeps++;
+        int r = pselect(maxfd + 1, &rd, &wr, &ex, &ts, NULL);
+        if (r > 0) {
+            int ready = 0;
+            for (guint i = 0; i < nfds; i++) {
+                const int fd = fds[i].fd;
+                if (fd < 0 || fd >= FD_SETSIZE) {
+                    continue;
+                }
+                if (FD_ISSET(fd, &rd)) {
+                    fds[i].revents |= fds[i].events & G_IO_IN ? G_IO_IN
+                                                              : fds[i].events & (G_IO_HUP | G_IO_ERR);
+                }
+                if (FD_ISSET(fd, &wr)) {
+                    fds[i].revents |= G_IO_OUT;
+                }
+                if (FD_ISSET(fd, &ex)) {
+                    fds[i].revents |= G_IO_PRI;
+                }
+                ready += fds[i].revents != 0;
+            }
