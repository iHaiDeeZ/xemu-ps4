+int main(int argc, char **argv)
+{
+    QemuThread thread;
+
+    load_system_modules();
+    mkdir(XEMU_DATA, 0777);
+    mkdir(XEMU_DATA "/bios", 0777);
+    mkdir(XEMU_DATA "/hdd", 0777);
+    mkdir(XEMU_DATA "/games", 0777);
+    /* no /tmp on the PS4 (glib's temporary files, QEMU's fallbacks) */
+    mkdir(XEMU_DATA "/tmp", 0777);
+    setenv("TMPDIR", XEMU_DATA "/tmp", 1);
+    redirect_output();
+    atexit(trace_exit);
+    setlocale(LC_NUMERIC, "C");
+    ps4_settings_load();
+    ps4_settings_save();    /* every key in the file, for editing by hand */
+
+    /*
+     * Threads: stacks from the kit's heap (direct memory) rather than the shared flexible pool;
+     * new threads on the shared cores, pinned ones move themselves (ps4_thread_started). This
+     * thread presents and polls the pads: a shared core, above the background threads.
+     */
+    ps4_kit_set_thread_stacks_from_heap(1);
+    app_cores = ps4_new_thread_cores ? ps4_new_thread_cores : 0x3f;
+    shared_cores = app_cores & ~0xfull;
+    if (shared_cores == 0 || ps4_settings.cpu_layout == PS4_CPU_FLOATING) {
+        shared_cores = app_cores;
+    }
+    ps4_kit_set_new_thread_cores(shared_cores);
+    ps4x_set_affinity(pthread_self(), shared_cores);
+    if (ps4_settings.cpu_layout == PS4_CPU_PINNED) {
+        ps4x_set_priority(pthread_self(), 660);
+    }
+    /* RADV's shader cache: compiled pipelines kept between runs (ps4-kit Mesa patches 0023-0025) */
+    mkdir(XEMU_DATA "/cache", 0777);
+    setenv("MESA_SHADER_CACHE_DIR", XEMU_DATA "/cache/mesa", 1);
+    profiling = ps4_settings.profiler || access(XEMU_DATA "/profile.txt", F_OK) == 0;
+    tlb_dirty_index_enabled = ps4_settings.tlb_index;
+    if (profiling) {
+        ps4_sampler_start();
+        ps4_sampler_register_thread("main (display)");
+    }
+
+    trace("xemu-ps4 %s (%s %s) starting", xemu_version, xemu_commit, xemu_date);
+    trace("CPU: %s, OS: %s", xemu_get_cpu_info(), xemu_get_os_info());
+    trace("CPU: %s at %u MHz, OS: %s; cores %#llx, layout %s", xemu_get_cpu_info(), ps4_kit_cpu_mhz(),
+          xemu_get_os_info(), (unsigned long long)app_cores,
+          ps4_settings.cpu_layout == PS4_CPU_PINNED ? "pinned" : "floating");
+    calibrate_main_loop_waits();
+
+    xemu_settings_set_path(XEMU_DATA "/xemu.toml");
+    if (!xemu_settings_load()) {
+        trace("xemu.toml: %s", xemu_settings_get_error_message());
+    }
+    apply_ps4_settings();
+    xemu_settings_save();
+    atexit(xemu_settings_save);
+
+    /* One subsystem at a time: SDL_Init stops at the first that fails. Sound: SDL's PS4 driver
+     * (port/sdl3: sceAudioOut, 48 kHz stereo), its buffer from Settings (ps4.ini audio_frames). */
+    char frames[16];
+    snprintf(frames, sizeof(frames), "%d", ps4_settings.audio_frames);
+    SDL_SetHint(SDL_HINT_AUDIO_DEVICE_SAMPLE_FRAMES, frames);
+    static const struct {
+        SDL_InitFlags flag;
+        const char *name;
+    } subsystems[] = {
+        { SDL_INIT_EVENTS, "events" },
+        { SDL_INIT_GAMEPAD, "gamepad" },
+        { SDL_INIT_AUDIO, "audio" },
+    };
+    for (size_t i = 0; i < ARRAY_SIZE(subsystems); i++) {
+        if (!SDL_InitSubSystem(subsystems[i].flag)) {
+            trace("SDL %s: %s", subsystems[i].name, SDL_GetError());
+        }
+    }
+    trace("SDL audio driver: %s", SDL_GetCurrentAudioDriver() ? SDL_GetCurrentAudioDriver() : "none");
+    ps4_pad_init();
+
+    /* QEMU parses no command line here: the machine comes from xemu.toml (system/vl.c). Extra
+     * QEMU options, one per line, from /data/xemu/qemu-args.txt (e.g. -d in_asm,int -D file). */
+    GPtrArray *args = g_ptr_array_new();
+    g_ptr_array_add(args, (char *)"xemu");
+    g_autofree char *extra = NULL;
+    if (g_file_get_contents(XEMU_DATA "/qemu-args.txt", &extra, NULL, NULL)) {
+        for (char **line = g_strsplit(extra, "\n", -1), **l = line; *l; l++) {
+            g_strstrip(*l);
+            if (**l != '\0' && **l != '#') {
+                trace("extra QEMU argument: %s", *l);
+                g_ptr_array_add(args, *l);
+            }
+        }
+    }
+    g_ptr_array_add(args, NULL);
+    g_argc = args->len - 1;
+    g_argv = (char **)args->pdata;
+
+    nv2a_context_init();
+
+    qemu_sem_init(&display_init_sem, 0);
+    qemu_sem_init(&display_shutdown_sem, 0);
+    trace("starting the emulator");
+    qemu_thread_create(&thread, "qemu_main", qemu_main, NULL, QEMU_THREAD_JOINABLE);
+    qemu_sem_wait(&display_init_sem);
+
+    tcg_register_init_ctx();
+    qemu_set_current_aio_context(qemu_get_aio_context());
+
+    xemu_main_loop_lock();
+    xemu_input_init();
+    xemu_main_loop_unlock();
+
+    QemuThread monitor;
+    qemu_thread_create(&monitor, "ps4-monitor", monitor_thread, NULL, QEMU_THREAD_DETACHED);
+
+    trace("main loop");
+    while (!qatomic_read(&qemu_exiting)) {
+        poll_events();
+        render_frame();
+    }
+    trace("exiting (%d)", exit_status);
+    qemu_sem_post(&display_shutdown_sem);
+    qemu_thread_join(&thread);
+    qemu_thread_join(&vblank_thread);
+    ps4_present_shutdown();
+    SDL_Quit();
+    return exit_status;
+}
+
+bool ps4_load_disc(const char *path)
+{
+    Error *err = NULL;
+    xemu_load_disc(path, &err);
+    if (err) {
+        trace("load disc %s: %s", path, error_get_pretty(err));
+        error_free(err);
+        return false;
+    }
+    trace("disc: %s", path);
+    xemu_settings_save();
+    return true;
+}
+
+void ps4_eject_disc(void)
+{
+    Error *err = NULL;
+    xemu_eject_disc(&err);
+    if (err) {
+        error_free(err);
+    }
+    xemu_settings_save();
+}
+
+void ps4_request_reset(void)
+{
+    qemu_system_reset_request(SHUTDOWN_CAUSE_HOST_UI);
+}
+
+void ps4_request_quit(void)
+{
+    qemu_system_shutdown_request(SHUTDOWN_CAUSE_HOST_UI);
+}
+
+void xemu_eject_disc(Error **errp)
+{
+    Error *error = NULL;
+
+    xbox_smc_eject_button();
+    xemu_settings_set_string(&g_config.sys.files.dvd_path, "");
+
+    /* Xbox software may request that the drive open, but do it now anyway */
+    qmp_eject("ide0-cd1", NULL, true, false, &error);
+    if (error) {
+        error_propagate(errp, error);
+    }
+
+    xbox_smc_update_tray_state();
+}
+
+void xemu_load_disc(const char *path, Error **errp)
+{
+    Error *error = NULL;
+
+    /* Ensure an eject sequence is always triggered so Xbox software reloads */
+    xbox_smc_eject_button();
+    xemu_settings_set_string(&g_config.sys.files.dvd_path, "");
+
+    qmp_blockdev_change_medium("ide0-cd1", NULL, path, "raw", false, false,
+                               false, 0, &error);
+    if (error) {
+        error_propagate(errp, error);
+    } else {
+        xemu_settings_set_string(&g_config.sys.files.dvd_path, path);
+    }
+
+    xbox_smc_update_tray_state();
+}
