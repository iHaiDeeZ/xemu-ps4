+static void aot_emit_call(AotEmit *e, TCGOp *op)
+{
+    const TCGHelperInfo *info = tcg_call_info(op);
+    void *func = tcg_call_func(op);
+    int nb_oargs = TCGOP_CALLO(op), nb_iargs = TCGOP_CALLI(op);
+    unsigned flags = info->flags;
+    unsigned tm = info->typemask;
+    static const char *ctypes[8] = { "void", "void", "uint32_t", "int32_t", "uint64_t",
+                                     "int64_t", "uintptr_t", NULL };
+    const char *rt;
+    int nargs = 0;
+    GString *o = e->o;
+
+    if (func != info->func || !info->name) {
+        aot_failf(e, "call to a plugin");
+        return;
+    }
+    if (!strcmp(info->name, "lookup_tb_ptr")) {
+        /* the goto_ptr that follows becomes the translated code's own lookup */
+        e->lookup_ptr = arg_temp(op->args[0]);
+        e->lookup_pending = true;
+        return;
+    }
+    if (nb_oargs > 1) {
+        aot_failf(e, "helper %s returns two values", info->name);
+        return;
+    }
+    for (int i = 1; i < 8 && (tm >> (3 * i)) & 7; i++) {
+        if (!ctypes[(tm >> (3 * i)) & 7]) {
+            aot_failf(e, "helper %s takes Int128", info->name);
+            return;
+        }
+        nargs++;
+    }
+    if (nargs != nb_iargs) {
+        aot_failf(e, "helper %s: %d args, op has %d", info->name, nargs, nb_iargs);
+        return;
+    }
+    rt = ctypes[tm & 7];
+    if (!rt) {
+        aot_failf(e, "helper %s returns Int128", info->name);
+        return;
+    }
+
+    if (!(flags & TCG_CALL_NO_READ_GLOBALS)) {
+        aot_cur(e);
+        aot_sync(e, false);
+    }
+    g_string_append_printf(o, " ");
+    if (nb_oargs) {
+        g_string_append_printf(o, "%s = (%s)", aot_t(e, op->args[0]),
+                               aot_ctype(arg_temp(op->args[0])->type));
+    }
+    g_string_append_printf(o, "((%s (*)(", rt);
+    for (int i = 0; i < nargs; i++) {
+        g_string_append_printf(o, "%s%s", i ? ", " : "", ctypes[(tm >> (3 * (i + 1))) & 7]);
+    }
+    if (!nargs) {
+        g_string_append(o, "void");
+    }
+    g_string_append_printf(o, "))AOT_H(%s))(", info->name);
+    for (int i = 0; i < nargs; i++) {
+        unsigned tc = (tm >> (3 * (i + 1))) & 7;
+        g_string_append_printf(o, "%s(%s)%s", i ? ", " : "", ctypes[tc],
+                               aot_t(e, op->args[nb_oargs + i]));
+    }
+    g_string_append(o, ");");
+    if (flags & TCG_CALL_NO_RETURN) {
+        g_string_append(o, " __builtin_unreachable();");
+        return;
+    }
+    if (!(flags & (TCG_CALL_NO_READ_GLOBALS | TCG_CALL_NO_WRITE_GLOBALS))) {
+        aot_reload(e);
+        e->x87_csr_set = 0;
+    }
+}
+
+/* A branch to a label: remember eip's static value there. */
+static void aot_lab_note(AotEmit *e, int id)
+{
+    if (id < 0 || id > e->nb_labels) {
+        return;
+    }
+    if (!e->eip_known) {
+        e->lab_seen[id] = -1;
+    } else if (e->lab_seen[id] == 0) {
+        e->lab_seen[id] = 1;
+        e->lab_val[id] = e->eip_val;
+    } else if (e->lab_seen[id] == 1 && e->lab_val[id] != e->eip_val) {
+        e->lab_seen[id] = -1;
+    }
+}
+
+/* Before a jump to another block: the globals that are not parameters go to env. */
+static void aot_sync_np(AotEmit *e)
+{
+    for (int i = 0; i < e->nb_temps; i++) {
+        TCGTemp *ts = &e->s->temps[i];
+        if (ts->kind != TEMP_GLOBAL || e->passed[i] || ts == e->eip || !e->dirty[i]) {
+            continue;
+        }
+        g_string_append_printf(e->o, " AOT_ST_%s(%" PRIdPTR ", g_%s);",
+                               ts->type == TCG_TYPE_I32 ? "I32" : "I64",
+                               ts->mem_offset, ts->name);
+        e->dirty[i] = 0;
+    }
+}
+
+/*
+ * A jump to the block at eip. Where eip is known here the target is named (the build
+ * makes it a tail call to that block's function, still checked against eip at run
+ * time); otherwise the translated code looks eip up in its own table.
+ */
+static void aot_emit_jump(AotEmit *e)
+{
+    if (e->eip_known) {
+        g_string_append_printf(e->o, " AOT_GOTO_PC(0x%08" PRIx32 "u);", e->eip_val);
+    } else {
+        g_string_append(e->o, " AOT_IND();");
+    }
+}
+
+/* After each op: globals it wrote, eip's static value, whether control falls through. */
+static void aot_after_op(AotEmit *e, TCGOp *op)
+{
+    TCGOpcode c = op->opc;
+    const TCGOpDef *def = &tcg_op_defs[c];
+    int no = c == INDEX_op_call ? TCGOP_CALLO(op) : def->nb_oargs;
+    bool wrote_eip = false;
+
+    if (c == INDEX_op_discard) {
+        no = 0;
+    }
+    for (int i = 0; i < no; i++) {
+        TCGTemp *ts = arg_temp(op->args[i]);
+        if (ts->kind == TEMP_GLOBAL) {
+            e->dirty[temp_idx(ts)] = 1;
+            if (ts == e->eip) {
+                wrote_eip = true;
+            }
+        }
+    }
+    if (wrote_eip) {
+        TCGTemp *a1 = def->nb_iargs >= 1 ? arg_temp(op->args[no]) : NULL;
+        TCGTemp *a2 = def->nb_iargs >= 2 ? arg_temp(op->args[no + 1]) : NULL;
+        if (c == INDEX_op_mov && a1 && a1->kind == TEMP_CONST) {
+            e->eip_known = true;
+            e->eip_val = (uint32_t)a1->val;
+        } else if (e->eip_known && a1 == e->eip && a2 && a2->kind == TEMP_CONST &&
+                   (c == INDEX_op_add || c == INDEX_op_sub || c == INDEX_op_and)) {
+            uint32_t v = (uint32_t)a2->val;
+            e->eip_val = c == INDEX_op_add ? e->eip_val + v :
+                         c == INDEX_op_sub ? e->eip_val - v : e->eip_val & v;
+        } else {
+            e->eip_known = false;
+        }
+    }
+    e->flow_ends = c == INDEX_op_br || c == INDEX_op_exit_tb || c == INDEX_op_goto_ptr ||
+                   (c == INDEX_op_call && (tcg_call_flags(op) & TCG_CALL_NO_RETURN));
+}
+
+/* The ops of the current TB as the body of a C function; false (and *why) if it can't be. */
+bool tcg_aot_emit_tb(TCGContext *s, const TranslationBlock *tb, uint64_t pc, GString *out,
+                     const char **why)
+{
+    AotEmit e = { .s = s, .tb_pc = pc, .cur_pc = pc, .cur_cc = -1 };
+    TCGOp *op;
+    GString *body = g_string_sized_new(4096);
+    static char whybuf[96];
+    int n = s->nb_temps;
+
+    e.nb_temps = n;
+    e.passed = g_new0(uint8_t, n);
+    e.used = g_new0(uint8_t, n);
+    e.written = g_new0(uint8_t, n);
+    e.dirty = g_new0(uint8_t, n);
+    e.declared = g_new0(uint8_t, n);
+    e.o = body;
+    e.nb_labels = s->nb_labels;
+    e.lab_seen = g_new0(int8_t, e.nb_labels + 1);
+    e.lab_val = g_new0(uint32_t, e.nb_labels + 1);
+    e.eip_known = true;          /* a block is entered with eip == its pc */
+    e.eip_val = (uint32_t)pc;
+
+    for (int i = 0; i < s->nb_globals; i++) {
+        TCGTemp *ts = &s->temps[i];
+        if (ts->kind != TEMP_GLOBAL || !ts->name) {
+            continue;
+        }
+        for (int k = 0; k < ARRAY_SIZE(aot_passed_names); k++) {
+            if (!strcmp(ts->name, aot_passed_names[k])) {
+                e.passed[i] = k + 1;
+            }
+        }
+        if (!strcmp(ts->name, "eip")) {
+            e.eip = ts;
+        }
+    }
+    if (!e.eip) {
+        aot_failf(&e, "no eip global");
+    }
+
+    /* pass 1: what is used and written, and anything unsupported */
+    QTAILQ_FOREACH(op, &s->ops, link) {
+        TCGOpcode c = op->opc;
+        const TCGOpDef *def = &tcg_op_defs[c];
+        int no, ni;
+        if (c == INDEX_op_insn_start || c == INDEX_op_set_label || c == INDEX_op_br ||
+            c == INDEX_op_mb || c == INDEX_op_exit_tb || c == INDEX_op_goto_tb) {
+            continue;
+        }
+        if (c == INDEX_op_call) {
+            no = TCGOP_CALLO(op);
+            ni = TCGOP_CALLI(op);
+        } else {
+            no = def->nb_oargs;
+            ni = def->nb_iargs;
+        }
+        switch (c) {
+        case INDEX_op_plugin_cb: case INDEX_op_plugin_mem_cb:
+        case INDEX_op_brcond2_i32: case INDEX_op_setcond2_i32: case INDEX_op_dup2_vec:
+            aot_failf(&e, "op %s", def->name);
+            break;
+        default:
+            break;
+        }
+        if (c == INDEX_op_discard) {
+            continue;       /* the value is dead: not a write the block must store back */
+        }
+        for (int i = 0; i < no + ni; i++) {
+            aot_note_temp(&e, op->args[i], i < no);
+        }
+        if (e.fail) {
+            break;
+        }
+    }
+
+    /* every global the block keeps: passed ones are always there; eip always */
+    for (int i = 0; i < n && !e.fail; i++) {
+        TCGTemp *ts = &s->temps[i];
+        if (ts->kind == TEMP_GLOBAL && (e.passed[i] || ts == e.eip)) {
+            e.used[i] = 1;
+            e.dirty[i] = 1;      /* env is not current at entry (chained from another block) */
+        }
+    }
+
+    /* pass 2: the statements */
+    if (!e.fail) {
+        aot_mark_all_dirty(&e);
+    }
+    QTAILQ_FOREACH(op, &s->ops, link) {
+        TCGOpcode c = op->opc;
+        const TCGOpDef *def = &tcg_op_defs[c];
+        TCGType t;
+        const char *ct, *st;
+        int w;
+        GString *o = body;
+
+        if (e.fail) {
+            break;
+        }
+        if (e.skip_exit_tb && c != INDEX_op_exit_tb) {
+            aot_failf(&e, "goto_tb not followed by exit_tb");
+            break;
+        }
+        t = (def->flags & (TCG_OPF_INT | TCG_OPF_VECTOR)) ? TCGOP_TYPE(op) : TCG_TYPE_I32;
+        ct = aot_ctype(t);
+        st = aot_stype(t);
+        w = aot_bits(t);
+#define A(i) aot_t(&e, op->args[i])
+        if (def->flags & TCG_OPF_VECTOR) {
+            aot_emit_vec(&e, op);
+            g_string_append_c(o, '\n');
+            aot_after_op(&e, op);
+            continue;
+        }
+        if (def->flags & TCG_OPF_FP) {
+            aot_emit_fp(&e, op);
+            g_string_append_c(o, '\n');
+            aot_after_op(&e, op);
+            continue;
+        }
+        if ((def->flags & TCG_OPF_INT) && c != INDEX_op_qemu_ld2 && c != INDEX_op_qemu_st2) {
+            if (t != TCG_TYPE_I32 && t != TCG_TYPE_I64) {
+                aot_failf(&e, "%s of type %d", def->name, t);
+                break;
+            }
+        }
+        switch (c) {
+        case INDEX_op_insn_start: {
+            uint64_t p0 = tcg_get_insn_start_param(op, 0);
+            uint64_t cc = tcg_get_insn_start_param(op, 1);
+            if (tb_cflags(tb) & CF_PCREL) {
+                e.cur_pc = (pc & TARGET_PAGE_MASK) | p0;
+                if (e.cur_pc < pc) {     /* the TB crossed into the next page */
+                    e.cur_pc += TARGET_PAGE_SIZE;
+                }
+            } else {
+                e.cur_pc = p0;
+            }
+            e.cur_cc = (int)cc;
+            e.have_insn = true;
+            g_string_append_printf(o, "/* %08" PRIx64 " */", e.cur_pc);
+            break;
+        }
+        case INDEX_op_discard:
+            break;
+        case INDEX_op_mb:
+            g_string_append(o, " AOT_BARRIER();");
+            break;
+        case INDEX_op_set_label: {
+            int id = arg_label(op->args[0])->id;
+            g_string_append_printf(o, "L%d: ;", id);
+            aot_mark_all_dirty(&e);
+            /* eip where the paths meet: known only if every way in agrees */
+            if (e.flow_ends) {
+                e.eip_known = e.lab_seen[id] == 1;
+                e.eip_val = e.lab_val[id];
+            } else if (e.lab_seen[id] == -1 ||
+                       (e.lab_seen[id] == 1 && (!e.eip_known || e.lab_val[id] != e.eip_val))) {
+                e.eip_known = false;
+            }
+            break;
+        }
+        case INDEX_op_br:
+            aot_lab_note(&e, arg_label(op->args[0])->id);
+            g_string_append_printf(o, " goto L%d;", arg_label(op->args[0])->id);
+            break;
+        case INDEX_op_brcond:
+            aot_lab_note(&e, arg_label(op->args[3])->id);
+            g_string_append_printf(o, " if (%s) goto L%d;",
+                                   aot_cond(&e, op->args[2], t, A(0), A(1)),
+                                   arg_label(op->args[3])->id);
+            break;
+        case INDEX_op_mov:
+            g_string_append_printf(o, " %s = %s;", A(0), A(1));
+            break;
+        case INDEX_op_add: g_string_append_printf(o, " %s = (%s)(%s + %s);", A(0), ct, A(1), A(2)); break;
+        case INDEX_op_sub: g_string_append_printf(o, " %s = (%s)(%s - %s);", A(0), ct, A(1), A(2)); break;
+        case INDEX_op_mul: g_string_append_printf(o, " %s = (%s)(%s * %s);", A(0), ct, A(1), A(2)); break;
+        case INDEX_op_and: g_string_append_printf(o, " %s = %s & %s;", A(0), A(1), A(2)); break;
+        case INDEX_op_or: g_string_append_printf(o, " %s = %s | %s;", A(0), A(1), A(2)); break;
+        case INDEX_op_xor: g_string_append_printf(o, " %s = %s ^ %s;", A(0), A(1), A(2)); break;
+        case INDEX_op_andc: g_string_append_printf(o, " %s = %s & ~%s;", A(0), A(1), A(2)); break;
+        case INDEX_op_orc: g_string_append_printf(o, " %s = %s | ~%s;", A(0), A(1), A(2)); break;
+        case INDEX_op_eqv: g_string_append_printf(o, " %s = ~(%s ^ %s);", A(0), A(1), A(2)); break;
+        case INDEX_op_nand: g_string_append_printf(o, " %s = ~(%s & %s);", A(0), A(1), A(2)); break;
+        case INDEX_op_nor: g_string_append_printf(o, " %s = ~(%s | %s);", A(0), A(1), A(2)); break;
+        case INDEX_op_not: g_string_append_printf(o, " %s = ~%s;", A(0), A(1)); break;
+        case INDEX_op_neg: g_string_append_printf(o, " %s = (%s)(0 - %s);", A(0), ct, A(1)); break;
+        case INDEX_op_shl:
+            g_string_append_printf(o, " %s = (%s)(%s << (%s & %d));", A(0), ct, A(1), A(2), w - 1);
+            break;
+        case INDEX_op_shr:
+            g_string_append_printf(o, " %s = %s >> (%s & %d);", A(0), A(1), A(2), w - 1);
+            break;
+        case INDEX_op_sar:
+            g_string_append_printf(o, " %s = (%s)((%s)%s >> (%s & %d));", A(0), ct, st, A(1), A(2),
+                                   w - 1);
+            break;
+        case INDEX_op_rotl:
+            g_string_append_printf(o, " %s = AOT_ROTL%d(%s, %s);", A(0), w, A(1), A(2));
+            break;
+        case INDEX_op_rotr:
+            g_string_append_printf(o, " %s = AOT_ROTR%d(%s, %s);", A(0), w, A(1), A(2));
+            break;
+        case INDEX_op_clz:
+            g_string_append_printf(o, " %s = %s ? (%s)__builtin_clz%s(%s) : %s;", A(0), A(1), ct,
+                                   w == 64 ? "ll" : "", A(1), A(2));
+            break;
+        case INDEX_op_ctz:
+            g_string_append_printf(o, " %s = %s ? (%s)__builtin_ctz%s(%s) : %s;", A(0), A(1), ct,
+                                   w == 64 ? "ll" : "", A(1), A(2));
+            break;
+        case INDEX_op_ctpop:
+            g_string_append_printf(o, " %s = (%s)__builtin_popcount%s(%s);", A(0), ct,
+                                   w == 64 ? "ll" : "", A(1));
+            break;
+        case INDEX_op_bswap16: {
+            unsigned f = op->args[2];
+            g_string_append_printf(o, " %s = (%s)%s(uint16_t)__builtin_bswap16((uint16_t)%s);",
+                                   A(0), ct, (f & TCG_BSWAP_OS) ? "(int16_t)" : "", A(1));
+            break;
+        }
+        case INDEX_op_bswap32: {
+            unsigned f = op->args[2];
+            g_string_append_printf(o, " %s = (%s)%s__builtin_bswap32((uint32_t)%s);", A(0), ct,
+                                   (f & TCG_BSWAP_OS) ? "(int32_t)" : "", A(1));
+            break;
+        }
+        case INDEX_op_bswap64:
+            g_string_append_printf(o, " %s = __builtin_bswap64(%s);", A(0), A(1));
+            break;
+        case INDEX_op_deposit: {
+            unsigned pos = op->args[3], len = op->args[4];
+            uint64_t m = len >= 64 ? ~0ull : (1ull << len) - 1;
+            if (w == 32) {
+                m &= 0xffffffffull;
+            }
+            g_string_append_printf(o, " %s = (%s)((%s & ~((%s)0x%" PRIx64 "ull << %u)) |"
+                                   " (((%s)%s & 0x%" PRIx64 "ull) << %u));", A(0), ct, A(1), ct, m,
+                                   pos, ct, A(2), m, pos);
+            break;
+        }
+        case INDEX_op_extract: {
+            unsigned pos = op->args[2], len = op->args[3];
+            uint64_t m = len >= 64 ? ~0ull : (1ull << len) - 1;
+            g_string_append_printf(o, " %s = (%s)((%s >> %u) & 0x%" PRIx64 "ull);", A(0), ct, A(1),
+                                   pos, m);
+            break;
+        }
+        case INDEX_op_sextract: {
+            unsigned pos = op->args[2], len = op->args[3];
+            g_string_append_printf(o, " %s = (%s)((%s)(%s << %u) >> %u);", A(0), ct, st, A(1),
+                                   w - pos - len, w - len);
+            break;
+        }
+        case INDEX_op_extract2: {
+            unsigned pos = op->args[3];
+            if (pos == 0) {
+                g_string_append_printf(o, " %s = %s;", A(0), A(1));
+            } else {
+                g_string_append_printf(o, " %s = (%s)((%s >> %u) | (%s << %u));", A(0), ct, A(1),
+                                       pos, A(2), w - pos);
+            }
+            break;
+        }
+        case INDEX_op_divs:
+            g_string_append_printf(o, " %s = (%s)((%s)%s / (%s)%s);", A(0), ct, st, A(1), st, A(2));
+            break;
+        case INDEX_op_divu:
+            g_string_append_printf(o, " %s = %s / %s;", A(0), A(1), A(2));
+            break;
+        case INDEX_op_rems:
+            g_string_append_printf(o, " %s = (%s)((%s)%s %% (%s)%s);", A(0), ct, st, A(1), st, A(2));
+            break;
+        case INDEX_op_remu:
+            g_string_append_printf(o, " %s = %s %% %s;", A(0), A(1), A(2));
+            break;
+        case INDEX_op_divs2:
+        case INDEX_op_divu2: {
+            bool sg = c == INDEX_op_divs2;
+            const char *wide = w == 32 ? (sg ? "int64_t" : "uint64_t")
+                                       : (sg ? "__int128" : "unsigned __int128");
+            const char *nt = w == 32 ? (sg ? "int32_t" : "uint32_t") : (sg ? "int64_t" : "uint64_t");
+            g_string_append_printf(o, " { %s _n = ((%s)(%s)%s << %d) | %s; %s _d = (%s)%s;"
+                                   " %s = (%s)(_n / _d); %s = (%s)(_n %% _d); }",
+                                   wide, wide, nt, A(3), w, A(2), wide, nt, A(4), A(0), ct, A(1), ct);
+            break;
+        }
+        case INDEX_op_mulu2:
+        case INDEX_op_muls2: {
+            bool sg = c == INDEX_op_muls2;
+            const char *wide = w == 32 ? (sg ? "int64_t" : "uint64_t")
+                                       : (sg ? "__int128" : "unsigned __int128");
+            g_string_append_printf(o, " { %s _p = (%s)(%s)%s * (%s)(%s)%s; %s = (%s)_p;"
+                                   " %s = (%s)((unsigned __int128)_p >> %d); }",
+                                   wide, wide, sg ? st : ct, A(2), wide, sg ? st : ct, A(3), A(0),
+                                   ct, A(1), ct, w);
+            break;
+        }
+        case INDEX_op_muluh:
+        case INDEX_op_mulsh: {
+            bool sg = c == INDEX_op_mulsh;
+            const char *wide = w == 32 ? (sg ? "int64_t" : "uint64_t")
+                                       : (sg ? "__int128" : "unsigned __int128");
+            g_string_append_printf(o, " %s = (%s)(((%s)(%s)%s * (%s)(%s)%s) >> %d);", A(0), ct,
+                                   wide, sg ? st : ct, A(1), wide, sg ? st : ct, A(2), w);
+            break;
+        }
+        case INDEX_op_setcond:
+            g_string_append_printf(o, " %s = (%s)%s;", A(0), ct,
+                                   aot_cond(&e, op->args[3], t, A(1), A(2)));
+            break;
+        case INDEX_op_negsetcond:
+            g_string_append_printf(o, " %s = (%s)(0 - (%s)%s);", A(0), ct, ct,
+                                   aot_cond(&e, op->args[3], t, A(1), A(2)));
+            break;
+        case INDEX_op_movcond:
+            g_string_append_printf(o, " %s = %s ? %s : %s;", A(0),
+                                   aot_cond(&e, op->args[5], t, A(1), A(2)), A(3), A(4));
+            break;
+        case INDEX_op_addco:
+            g_string_append_printf(o, " { %s _r = %s + %s; aot_c = _r < %s; %s = _r; }", ct, A(1),
+                                   A(2), A(1), A(0));
+            break;
+        case INDEX_op_addci:
+            g_string_append_printf(o, " %s = (%s)(%s + %s + (%s)aot_c);", A(0), ct, A(1), A(2), ct);
+            break;
+        case INDEX_op_addcio:
+            g_string_append_printf(o, " { %s _s = %s + %s, _r = _s + (%s)aot_c;"
+                                   " aot_c = (_s < %s) | (_r < _s); %s = _r; }",
+                                   ct, A(1), A(2), ct, A(1), A(0));
+            break;
+        case INDEX_op_addc1o:
+            g_string_append_printf(o, " { %s _r = %s + %s + 1; aot_c = _r <= %s; %s = _r; }", ct,
+                                   A(1), A(2), A(1), A(0));
+            break;
+        case INDEX_op_subbo:
+            g_string_append_printf(o, " { %s _r = %s - %s; aot_c = %s < %s; %s = _r; }", ct, A(1),
+                                   A(2), A(1), A(2), A(0));
+            break;
+        case INDEX_op_subbi:
+            g_string_append_printf(o, " %s = (%s)(%s - %s - (%s)aot_c);", A(0), ct, A(1), A(2), ct);
+            break;
+        case INDEX_op_subbio:
+            g_string_append_printf(o, " { %s _s = %s - %s, _r = _s - (%s)aot_c;"
+                                   " aot_c = (%s < %s) | (_s < (%s)aot_c); %s = _r; }",
+                                   ct, A(1), A(2), ct, A(1), A(2), ct, A(0));
+            break;
+        case INDEX_op_subb1o:
+            g_string_append_printf(o, " { %s _r = %s - %s - 1; aot_c = %s <= %s; %s = _r; }", ct,
+                                   A(1), A(2), A(1), A(2), A(0));
+            break;
+        case INDEX_op_ext_i32_i64:
+            g_string_append_printf(o, " %s = (uint64_t)(int64_t)(int32_t)%s;", A(0), A(1));
+            break;
+        case INDEX_op_extu_i32_i64:
+            g_string_append_printf(o, " %s = (uint64_t)(uint32_t)%s;", A(0), A(1));
+            break;
+        case INDEX_op_extrl_i64_i32:
+            g_string_append_printf(o, " %s = (uint32_t)%s;", A(0), A(1));
+            break;
+        case INDEX_op_extrh_i64_i32:
+            g_string_append_printf(o, " %s = (uint32_t)(%s >> 32);", A(0), A(1));
+            break;
+        case INDEX_op_ld8u: case INDEX_op_ld8s: case INDEX_op_ld16u: case INDEX_op_ld16s:
+        case INDEX_op_ld32u: case INDEX_op_ld32s: case INDEX_op_ld: {
+            const char *lt;
+            int64_t off = op->args[2];
+            TCGTemp *base = arg_temp(op->args[1]);
+            switch (c) {
+            case INDEX_op_ld8u: lt = "uint8_t"; break;
+            case INDEX_op_ld8s: lt = "int8_t"; break;
+            case INDEX_op_ld16u: lt = "uint16_t"; break;
+            case INDEX_op_ld16s: lt = "int16_t"; break;
+            case INDEX_op_ld32u: lt = "uint32_t"; break;
+            case INDEX_op_ld32s: lt = "int32_t"; break;
+            default: lt = ct; break;
+            }
+            /* a global's slot in env is stale while the C variable holds it */
+            if (base->kind == TEMP_FIXED) {
+                for (int i = 0; i < n; i++) {
+                    TCGTemp *g = &s->temps[i];
+                    if (g->kind == TEMP_GLOBAL && g->mem_offset == off &&
+                        (e.used[i] || e.passed[i])) {
+                        aot_failf(&e, "load from global %s's slot", g->name);
+                    }
+                }
+            }
+            /* env fields before env (icount_decr, can_do_io) change behind our back */
+            g_string_append_printf(o, " %s = (%s)AOT_LDM%s(%s, %s, %" PRId64 ");", A(0), ct,
+                                   (base->kind == TEMP_FIXED && off < 0) ? "V" : "", lt,
+                                   aot_base(&e, op->args[1]), off);
+            break;
+        }
+        case INDEX_op_st8: case INDEX_op_st16: case INDEX_op_st32: case INDEX_op_st: {
+            const char *lt = c == INDEX_op_st8 ? "uint8_t" : c == INDEX_op_st16 ? "uint16_t" :
+                             c == INDEX_op_st32 ? "uint32_t" : ct;
+            TCGTemp *base = arg_temp(op->args[1]);
+            int64_t off = op->args[2];
+            /*
+             * can_do_io = false before a block's first insn (translator_loop): QEMU
+             * then retranslates any TB doing I/O before its last insn so that the I/O
+             * ends it (cpu_io_recompile), which needs a TB for the host pc. The
+             * translated code leaves I/O allowed instead, as QEMU did before 8.2 without
+             * icount: a device's interrupt is taken at the next block, not right after.
+             */
+            if (base->kind == TEMP_FIXED && c == INDEX_op_st8 &&
+                off == (int64_t)(offsetof(CPUState, neg.can_do_io) - sizeof(CPUState))) {
+                break;      /* stays 1 (the trampoline's single insn set it) */
+            }
+            /* a store into a global's env slot would be undone by a later sync */
+            if (base->kind == TEMP_FIXED) {
+                for (int i = 0; i < n; i++) {
+                    TCGTemp *g = &s->temps[i];
+                    if (g->kind == TEMP_GLOBAL && g->mem_offset == off && e.used[i]) {
+                        aot_failf(&e, "store to global %s's slot", g->name);
+                    }
+                }
+            }
+            g_string_append_printf(o, " AOT_STM%s(%s, %s, %" PRId64 ", %s);",
+                                   (base->kind == TEMP_FIXED && off < 0) ? "V" : "", lt,
+                                   aot_base(&e, op->args[1]), off, A(0));
+            break;
+        }
+        case INDEX_op_qemu_ld: case INDEX_op_qemu_st:
+        case INDEX_op_qemu_ld2: case INDEX_op_qemu_st2:
+            aot_emit_qemu_ldst(&e, op);
+            break;
+        case INDEX_op_call:
+            aot_emit_call(&e, op);
+            break;
+        case INDEX_op_goto_tb:
+            /* direct jump to the block at eip: a tail call when it is translated too */
+            aot_sync_np(&e);
+            aot_emit_jump(&e);
+            e.skip_exit_tb = true;
+            break;
+        case INDEX_op_exit_tb:
+            if (e.skip_exit_tb) {
+                e.skip_exit_tb = false;
+                break;
+            }
+            aot_sync(&e, true);
+            if ((op->args[0] & TB_EXIT_MASK) == TB_EXIT_REQUESTED) {
+                g_string_append(o, " AOT_EXIT_REQ();");
+            } else {
+                g_string_append(o, " AOT_EXIT();");
+            }
+            break;
+        case INDEX_op_goto_ptr:
+            if (!e.lookup_pending || arg_temp(op->args[0]) != e.lookup_ptr) {
+                aot_failf(&e, "goto_ptr without lookup_tb_ptr");
+                break;
+            }
+            e.lookup_pending = false;
+            aot_sync_np(&e);
+            aot_emit_jump(&e);
+            break;
+        default:
+            aot_failf(&e, "op %s", def->name);
+            break;
+        }
+#undef A
+        g_string_append_c(o, '\n');
+        aot_after_op(&e, op);
+    }
+
+    if (!e.fail) {
+        /* declarations: temps, the non-passed globals (from env), the per-block sync */
+        g_string_append_printf(out, "//@aot pc=%08" PRIx64 " cs=%" PRIx64 " fl=%08x cf=%08x"
+                               " sz=%u ic=%u h=%016" PRIx64 "\n", pc, (uint64_t)tb->cs_base,
+                               tb->flags, tb_cflags(tb) & ~CF_INVALID, tb->size, tb->icount,
+                               tb->ihash);
+        g_string_append(out, "#define AOT_SYNC_NP()");
+        for (int i = 0; i < n; i++) {
+            TCGTemp *ts = &s->temps[i];
+            if (ts->kind == TEMP_GLOBAL && e.written[i] && !e.passed[i] && ts != e.eip) {
+                g_string_append_printf(out, " AOT_ST_%s(%" PRIdPTR ", g_%s);",
+                                       ts->type == TCG_TYPE_I32 ? "I32" : "I64",
+                                       ts->mem_offset, ts->name);
+            }
+        }
+        g_string_append(out, "\n");
+        for (int i = 0; i < n; i++) {
+            TCGTemp *ts = &s->temps[i];
+            if (!e.used[i] || e.passed[i] || ts == e.eip) {
+                continue;
+            }
+            if (ts->kind == TEMP_GLOBAL) {
+                g_string_append_printf(out, " %s g_%s = AOT_LD_%s(%" PRIdPTR ");\n",
+                                       aot_ctype(ts->type), ts->name,
+                                       ts->type == TCG_TYPE_I32 ? "I32" : "I64", ts->mem_offset);
+            } else if (ts->kind == TEMP_TB || ts->kind == TEMP_EBB) {
+                g_string_append_printf(out, " %s t%d;\n", aot_ctype(ts->type), i);
+            }
+        }
+        g_string_append_len(out, body->str, body->len);
+        g_string_append(out, "#undef AOT_SYNC_NP\n//@end\n");
+    } else {
+        snprintf(whybuf, sizeof(whybuf), "%s", e.fail);
+        *why = whybuf;
+    }
+
+    g_free(e.passed);
+    g_free(e.used);
+    g_free(e.written);
+    g_free(e.dirty);
+    g_free(e.declared);
+    g_free(e.lab_seen);
+    g_free(e.lab_val);
+    g_string_free(body, true);
+    return e.fail == NULL;
+}
