+}
+
+static void load_system_modules(void)
+{
+    /* calling into a system library whose module isn't loaded kills the app silently */
+    static const struct {
+        const char *name;
+        uint32_t id;
+    } modules[] = {
+        { "SystemService", 0x80000010 }, { "UserService", 0x80000011 },
+        { "VideoOut", 0x80000022 },      { "AudioOut", 0x80000001 },
+        { "Pad", 0x80000024 },           { "Net", 0x8000001C },
+    };
+    for (size_t i = 0; i < ARRAY_SIZE(modules); i++) {
+        int r = sceSysmoduleLoadModuleInternal(modules[i].id);
+        if (r != 0) {
+            trace("loading system module %s failed (%x)", modules[i].name,
+                  (unsigned)r);
+        }
+    }
+}
+
+/* stdout/stderr into /data/xemu/xemu.log: QEMU and xemu report everything there. Not
+ * freopen: OpenOrbis' calls dup3, an ENOSYS stub, and then closes the stream. */
+static void redirect_output(void)
+{
+    int fd = open(XEMU_DATA "/xemu.log", O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (fd < 0) {
+        return;
+    }
+    dup2(fd, STDERR_FILENO);
+    dup2(fd, STDOUT_FILENO);
+    close(fd);
+    setvbuf(stderr, NULL, _IONBF, 0);
+    setvbuf(stdout, NULL, _IOLBF, 0);
+}
+
+/* QEMU leaves on fatal errors with exit(): the reason is in xemu.log, the fact here */
+static void trace_exit(void)
+{
+    ps4_boot_trace(qatomic_read(&qemu_exiting) ? "exit (emulator shut down)"
+                                               : "exit() called: see xemu.log");
+}
+
+/* The first file in /data/xemu/bios whose size matches, for a setting left empty */
+static void find_bios_file(const char **setting, const char *what,
+                           const off_t *sizes, int num_sizes)
+{
+    if ((*setting)[0] != '\0' && access(*setting, R_OK) == 0) {
+        return;
+    }
+    DIR *dir = opendir(XEMU_DATA "/bios");
+    if (dir == NULL) {
+        return;
+    }
+    struct dirent *e;
+    while ((e = readdir(dir)) != NULL) {
+        if (e->d_name[0] == '.') {
+            continue;
+        }
+        g_autofree char *path = g_strdup_printf(XEMU_DATA "/bios/%s", e->d_name);
+        struct stat st;
+        if (stat(path, &st) != 0 || !S_ISREG(st.st_mode)) {
+            continue;
+        }
+        for (int i = 0; i < num_sizes; i++) {
+            if (st.st_size == sizes[i]) {
+                xemu_settings_set_string(setting, path);
+                trace("%s: %s", what, path);
+                closedir(dir);
+                return;
+            }
+        }
+    }
+    closedir(dir);
+    trace("%s: none in " XEMU_DATA "/bios", what);
+}
+
+/* Why the Xbox can't start, for the HUD (ps4-frontend.h); NULL when nothing is known wrong */
+const char *ps4_setup_problem;
+
+#define MCPX_1_0_MD5 "d49c52a4102f6df7bcf8d0617ac475ed"
+
+/*
+ * Does this flash BIOS boot with the MCPX 1.0 boot ROM? The ROM RC4-decrypts the 2BL from flash
+ * 0xffff9e00 (0x6000 bytes, key at ROM offset 0x1a5) to RAM 0x90000 and checks the dword at
+ * 0x95fe4 for 0x7854794a; on a mismatch it hides itself and the CPU runs off into empty memory
+ * (a black screen). BIOS images for later Xbox revisions (MCPX 1.1, e.g. kernel 5838) fail it.
+ */
+static bool flash_boots_with_mcpx_1_0(const uint8_t *rom, const uint8_t *flash, size_t flash_size)
+{
+    const uint8_t *key = rom + 0x1a5;
+    const size_t src = (0xffff9e00u - 0xff000000u) % flash_size;
+    if (src + 0x6000 > flash_size) {
+        return false;
+    }
+    uint8_t s[256];
+    for (int i = 0; i < 256; i++) {
+        s[i] = i;
+    }
+    for (int i = 0, j = 0; i < 256; i++) {
+        j = (j + s[i] + key[i % 16]) & 0xff;
+        uint8_t t = s[i];
+        s[i] = s[j];
+        s[j] = t;
+    }
+    uint32_t magic = 0;
+    for (int n = 0, i = 0, j = 0; n < 0x5fe8; n++) {
+        i = (i + 1) & 0xff;
+        j = (j + s[i]) & 0xff;
+        uint8_t t = s[i];
+        s[i] = s[j];
+        s[j] = t;
+        uint8_t b = flash[src + n] ^ s[(s[i] + s[j]) & 0xff];
+        if (n >= 0x5fe4) {
+            magic |= (uint32_t)b << (8 * (n - 0x5fe4));
+        }
+    }
+    return magic == 0x7854794a;
+}
+
+/* With an MCPX 1.0 boot ROM: a flash BIOS that boots with it, the configured one if it does */
+static void check_bios_pair(void)
+{
+    g_autofree char *rom = NULL;
+    gsize rom_size = 0;
+    if (!g_file_get_contents(g_config.sys.files.bootrom_path, &rom, &rom_size, NULL) ||
+        rom_size != 512) {
+        return;
+    }
+    g_autofree char *md5 = g_compute_checksum_for_data(G_CHECKSUM_MD5, (const guchar *)rom, 512);
+    if (strcmp(md5, MCPX_1_0_MD5) != 0) {
+        trace("MCPX boot ROM %s isn't 1.0 (md5 %s): BIOS pairing not checked",
+              g_config.sys.files.bootrom_path, md5);
+        return;
+    }
+
+    g_autoptr(GPtrArray) candidates = g_ptr_array_new_with_free_func(g_free);
+    if (g_config.sys.files.flashrom_path[0] != '\0') {
+        g_ptr_array_add(candidates, g_strdup(g_config.sys.files.flashrom_path));
+    }
+    DIR *dir = opendir(XEMU_DATA "/bios");
+    struct dirent *e;
+    while (dir != NULL && (e = readdir(dir)) != NULL) {
+        if (e->d_name[0] != '.') {
+            g_ptr_array_add(candidates, g_strdup_printf(XEMU_DATA "/bios/%s", e->d_name));
+        }
+    }
+    if (dir != NULL) {
+        closedir(dir);
+    }
+
+    for (guint i = 0; i < candidates->len; i++) {
+        const char *path = g_ptr_array_index(candidates, i);
+        g_autofree char *flash = NULL;
+        gsize size = 0;
+        if (!g_file_get_contents(path, &flash, &size, NULL) ||
+            (size != 256 * 1024 && size != 1024 * 1024)) {
+            continue;
+        }
+        if (flash_boots_with_mcpx_1_0((const uint8_t *)rom, (const uint8_t *)flash, size)) {
+            if (strcmp(path, g_config.sys.files.flashrom_path) != 0) {
+                trace("flash BIOS: %s (boots with the MCPX 1.0 boot ROM)", path);
+                xemu_settings_set_string(&g_config.sys.files.flashrom_path, path);
+            }
+            return;
+        }
+        trace("flash BIOS %s doesn't boot with the MCPX 1.0 boot ROM", path);
+    }
+    ps4_setup_problem =
+        "The flash BIOS doesn't work with the MCPX 1.0 boot ROM: it is for a later Xbox "
+        "(v1.1-1.6, e.g. kernel 5838). Put a BIOS for the v1.0 Xbox (kernel 3944, 4034, 4132 "
+        "or 4627, e.g. the \"Complex 4627\" image) in /data/xemu/bios and restart.";
+}
+
+/* PS4 defaults: the renderer that can run here, files where the user puts them */
+static void apply_ps4_settings(void)
+{
+    g_config.display.renderer = CONFIG_DISPLAY_RENDERER_VULKAN;
+    /* native resolution: the renderer's buffers are sized for it on the PS4 (vk/buffer.c) */
+    g_config.display.quality.surface_scale = 1;
+    /* the welcome screen is the desktop GUI's; the PS4 home screen explains instead */
+    g_config.general.show_welcome = false;
+
+    static const off_t bootrom_sizes[] = { 512 };
+    static const off_t flash_sizes[] = { 256 * 1024, 1024 * 1024 };
+    find_bios_file(&g_config.sys.files.bootrom_path, "MCPX boot ROM",
+                   bootrom_sizes, ARRAY_SIZE(bootrom_sizes));
+    find_bios_file(&g_config.sys.files.flashrom_path, "flash BIOS",
+                   flash_sizes, ARRAY_SIZE(flash_sizes));
+    check_bios_pair();
+    if (g_config.sys.files.hdd_path[0] == '\0') {
+        xemu_settings_set_string(&g_config.sys.files.hdd_path,
+                                 XEMU_DATA "/hdd/xbox_hdd.qcow2");
+    }
+}
