+/* x87 ops on host SSE (xemu's hard FPU), as tcg/i386/tcg-target.c.inc emits them. */
+static void aot_emit_fp(AotEmit *e, TCGOp *op)
+{
+    TCGOpcode c = op->opc;
+    GString *o = e->o;
+#define A(i) aot_t(e, op->args[i])
+    switch (c) {
+    case INDEX_op_flcr:
+        g_string_append_printf(o, " AOT_SETCSR(%s);", A(0));
+        e->x87_csr_set = 1;
+        break;
+    case INDEX_op_ld80f_f32:
+        g_string_append_printf(o, " %s = AOT_LD80_F32(%s);", A(0), aot_base(e, op->args[1]));
+        break;
+    case INDEX_op_ld80f_f64:
+        g_string_append_printf(o, " %s = AOT_LD80_F64(%s);", A(0), aot_base(e, op->args[1]));
+        break;
+    case INDEX_op_st80f_f32:
+    case INDEX_op_st80f_f64:
+        g_string_append_printf(o, " AOT_ST80(%s, %s);", aot_base(e, op->args[1]), A(0));
+        break;
+    case INDEX_op_abs_f32: g_string_append_printf(o, " %s = __builtin_fabsf(%s);", A(0), A(1)); break;
+    case INDEX_op_abs_f64: g_string_append_printf(o, " %s = __builtin_fabs(%s);", A(0), A(1)); break;
+    case INDEX_op_chs_f32: case INDEX_op_chs_f64:
+        g_string_append_printf(o, " %s = -%s;", A(0), A(1));
+        break;
+    case INDEX_op_add_f32: case INDEX_op_add_f64:
+        g_string_append_printf(o, " %s = %s + %s;", A(0), A(1), A(2));
+        break;
+    case INDEX_op_sub_f32: case INDEX_op_sub_f64:
+        g_string_append_printf(o, " %s = %s - %s;", A(0), A(1), A(2));
+        break;
+    case INDEX_op_mul_f32: case INDEX_op_mul_f64:
+        g_string_append_printf(o, " %s = %s * %s;", A(0), A(1), A(2));
+        break;
+    case INDEX_op_div_f32: case INDEX_op_div_f64:
+        g_string_append_printf(o, " %s = %s / %s;", A(0), A(1), A(2));
+        break;
+    case INDEX_op_sqrt_f32:
+        g_string_append_printf(o, " %s = __builtin_sqrtf(%s);", A(0), A(1));
+        break;
+    case INDEX_op_sqrt_f64:
+        g_string_append_printf(o, " %s = __builtin_sqrt(%s);", A(0), A(1));
+        break;
+    case INDEX_op_com_f32:
+        g_string_append_printf(o, " %s = AOT_COMISS(%s, %s);", A(0), A(1), A(2));
+        break;
+    case INDEX_op_com_f64:
+        g_string_append_printf(o, " %s = AOT_COMISD(%s, %s);", A(0), A(1), A(2));
+        break;
+    case INDEX_op_sin_f32: g_string_append_printf(o, " %s = AOT_FSIN32(%s);", A(0), A(1)); break;
+    case INDEX_op_sin_f64: g_string_append_printf(o, " %s = AOT_FSIN64(%s);", A(0), A(1)); break;
+    case INDEX_op_cos_f32: g_string_append_printf(o, " %s = AOT_FCOS32(%s);", A(0), A(1)); break;
+    case INDEX_op_cos_f64: g_string_append_printf(o, " %s = AOT_FCOS64(%s);", A(0), A(1)); break;
+    case INDEX_op_cvt32f_f64: g_string_append_printf(o, " %s = (double)%s;", A(0), A(1)); break;
+    case INDEX_op_cvt64f_f32: g_string_append_printf(o, " %s = (float)%s;", A(0), A(1)); break;
+    case INDEX_op_cvt32f_i32: g_string_append_printf(o, " %s = AOT_CVTSS2SI(%s);", A(0), A(1)); break;
+    case INDEX_op_cvt32f_i64: g_string_append_printf(o, " %s = AOT_CVTSS2SI64(%s);", A(0), A(1)); break;
+    case INDEX_op_cvt64f_i32: g_string_append_printf(o, " %s = AOT_CVTSD2SI(%s);", A(0), A(1)); break;
+    case INDEX_op_cvt64f_i64: g_string_append_printf(o, " %s = AOT_CVTSD2SI64(%s);", A(0), A(1)); break;
+    case INDEX_op_cvt32i_f32: g_string_append_printf(o, " %s = (float)(int32_t)%s;", A(0), A(1)); break;
+    case INDEX_op_cvt32i_f64: g_string_append_printf(o, " %s = (double)(int32_t)%s;", A(0), A(1)); break;
+    case INDEX_op_cvt64i_f32: g_string_append_printf(o, " %s = (float)(int64_t)%s;", A(0), A(1)); break;
+    case INDEX_op_cvt64i_f64: g_string_append_printf(o, " %s = (double)(int64_t)%s;", A(0), A(1)); break;
+    case INDEX_op_mov32f_i32: g_string_append_printf(o, " %s = AOT_F2U(%s);", A(0), A(1)); break;
+    case INDEX_op_mov32i_f32: g_string_append_printf(o, " %s = AOT_U2F(%s);", A(0), A(1)); break;
+    case INDEX_op_mov64f_i64: g_string_append_printf(o, " %s = AOT_D2U(%s);", A(0), A(1)); break;
+    case INDEX_op_mov64i_f64: g_string_append_printf(o, " %s = AOT_U2D(%s);", A(0), A(1)); break;
+    case INDEX_op_mov_f32: case INDEX_op_mov_f64:
+        g_string_append_printf(o, " %s = %s;", A(0), A(1));
+        break;
+    default:
+        aot_failf(e, "op %s", tcg_op_defs[c].name);
+        break;
+    }
+#undef A
+}
