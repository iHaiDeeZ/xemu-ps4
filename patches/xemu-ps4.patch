+void ps4_thread_busy_report(char *out, size_t size, int min_percent); /* port/ps4_sampler.cpp */
+void ps4_watch_thread(const char *name);
+void ps4_sampler_register_thread(const char *name);
+void ps4_sampler_start(void);
+
+/* /data/xemu/profile.txt exists: the sampling profiler writes /data/xemu/samples.log */
+static bool profiling;
+
+/*
+ * Every QEMU thread, first thing (util/qemu-thread-posix.c). The emulation's busy threads go
+ * to the sampler when profiling (it keeps the name pointer: a copy; QEMU starts its threads
+ * with every signal blocked, the sampler's SIGPROF must come through).
+ */
+void ps4_thread_started(const char *name)
+{
+    static const char *const sampled[] = { "ALL CPUs/TCG", "nv2a.pfifo_thread",
+                                           "mcpx.apu_thread", "qemu_main" };
+    bool sample = false;
+    for (size_t i = 0; i < ARRAY_SIZE(sampled); i++) {
+        sample |= profiling && strcmp(name, sampled[i]) == 0;
+    }
+    if (!sample) {
+        ps4_watch_thread(name);
+        return;
+    }
+    sigset_t prof;
+    sigemptyset(&prof);
+    sigaddset(&prof, SIGPROF);
+    pthread_sigmask(SIG_UNBLOCK, &prof, NULL);
+    ps4_sampler_register_thread(g_strdup(name));
+}
+
+/* the busiest threads over the last 5 s, for the HUD's overlay (ps4-frontend.h) */
+char ps4_perf_threads[256];
+
+/*
+ * Every 5 s in boot-trace.log: frames presented (and with the emulated display in them),
+ * frames the guest flipped on the NV2A, the guest's clock and where its CPU is, and each named
+ * thread at 5% or more (one near 100% limits the speed). Racy reads, for diagnosis only.
+ */
+static void *monitor_thread(void *opaque)
+{
+    uint64_t last_frames = 0, last_display = 0;
+    unsigned int last_flips = 0;
+    int64_t last_guest_ns = 0;
+    while (!qatomic_read(&qemu_exiting)) {
+        g_usleep(5 * G_USEC_PER_SEC);
+        uint64_t frames, display;
+        ps4_present_stats(&frames, &display);
+        unsigned int flips = g_nv2a_stats.frame_count;
+        int64_t guest_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        CPUState *cpu = first_cpu;
+        uint64_t pc = 0;
+        if (cpu != NULL && CPU_GET_CLASS(cpu)->get_pc) {
+            pc = CPU_GET_CLASS(cpu)->get_pc(cpu);
+        }
+        char threads[sizeof(ps4_perf_threads)];
+        ps4_thread_busy_report(threads, sizeof(threads), 5);
+        memcpy(ps4_perf_threads, threads, sizeof(threads));
+        char pad_stats[160];
+        ps4_pad_stats(pad_stats, sizeof(pad_stats));
+        trace("monitor: presented %.1f/s (display in %.1f/s), guest flips %.1f/s, "
+              "guest clock +%.2f s, runstate %s, cpu pc 0x%08" PRIx64 "%s | %s | %s",
+              (frames - last_frames) / 5.0, (display - last_display) / 5.0,
+              (flips - last_flips) / 5.0, (guest_ns - last_guest_ns) / 1e9,
+              RunState_str(runstate_get()), pc,
+              cpu != NULL && cpu->halted ? " (halted)" : "", threads, pad_stats);
+        /* (no cpu_dump_state here: from this thread, with the guest kernel running, it took
+         * the process down in v00.07) */
+        last_frames = frames;
+        last_display = display;
+        last_flips = flips;
+        last_guest_ns = guest_ns;
+    }
+    return NULL;
+}
+
+static int g_argc;
+static char **g_argv;
+
+static void *qemu_main(void *opaque)
+{
+    qemu_init(g_argc, g_argv);
+    exit_status = qemu_main_loop();
+    qatomic_set(&qemu_exiting, true);
+    bql_unlock();
+    qemu_mutex_unlock_main_loop();
+
+    qemu_sem_wait(&display_shutdown_sem);
+    bql_lock();
+    qemu_cleanup(exit_status);
+    bql_unlock();
+    return NULL;
+}
+
+/*
+ * The DualShock 4 on Xbox port 1. xemu-input binds a gamepad when SDL reports it added; in
+ * v00.10 that never showed in the log. If the pad isn't among xemu's controllers a second
+ * after start, hand xemu-input the "added" event; if port 1 holds the keyboard (no use on the
+ * PS4), the pad takes it.
+ */
+static void ensure_pad_bound(void)
+{
+    static int64_t start_ns;
+    static bool done;
+    const SDL_JoystickID id = ps4_pad_joystick_id();
+    const int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    if (done || id == 0) {
+        return;
+    }
+    if (start_ns == 0) {
+        start_ns = now;
+    }
+    if (now - start_ns < NANOSECONDS_PER_SECOND) {
+        return;
+    }
+    done = true;
+
+    ControllerState *con = NULL, *iter;
+    QTAILQ_FOREACH (iter, &available_controllers, entry) {
+        if (iter->type == INPUT_DEVICE_SDL_GAMEPAD && iter->sdl_joystick_id == id) {
+            con = iter;
+        }
+    }
+    if (con == NULL) {
+        trace("pad: not among xemu's controllers after 1 s: adding it");
+        SDL_Event added = { 0 };
+        added.type = SDL_EVENT_GAMEPAD_ADDED;
+        added.gdevice.which = id;
+        xemu_input_process_sdl_events(&added);
+        QTAILQ_FOREACH (iter, &available_controllers, entry) {
+            if (iter->type == INPUT_DEVICE_SDL_GAMEPAD && iter->sdl_joystick_id == id) {
+                con = iter;
+            }
+        }
+    }
+    if (con == NULL) {
+        trace("pad: xemu couldn't open it as a gamepad (%s)", SDL_GetError());
+        return;
+    }
+    ControllerState *port1 = xemu_input_get_bound(0);
+    if (con->bound < 0 && (port1 == NULL || port1->type == INPUT_DEVICE_SDL_KEYBOARD)) {
+        xemu_input_bind(0, con, 1);
+    }
+    trace("pad: '%s' on Xbox port %d", con->name ? con->name : "?", con->bound + 1);
+}
+
+static void poll_events(void)
+{
+    SDL_Event ev;
+    static int logged;
+    while (SDL_PollEvent(&ev)) {
+        if (logged < 16 && ev.type >= SDL_EVENT_JOYSTICK_AXIS_MOTION &&
+            ev.type < SDL_EVENT_FINGER_DOWN && ev.type != SDL_EVENT_JOYSTICK_AXIS_MOTION &&
+            ev.type != SDL_EVENT_GAMEPAD_AXIS_MOTION) {
+            trace("SDL event 0x%x (device %u)", ev.type, (unsigned)ev.jdevice.which);
+            logged++;
+        }
+        xemu_main_loop_lock();
+        ps4_hud_process_sdl_event(&ev);
+        xemu_input_process_sdl_events(&ev);
+        xemu_main_loop_unlock();
+    }
+    xemu_main_loop_lock();
+    ensure_pad_bound();
+    xemu_input_update_controllers();
+    xemu_main_loop_unlock();
+}
+
+static void render_frame(void)
+{
+    /* the device appears once the machine's NV2A has brought the Vulkan renderer up */
+    if (!ps4_present_ready()) {
+        NV2AVkDevice dev;
+        if (!nv2a_vk_ps4_get_device(&dev) || !ps4_present_init(&dev)) {
+            SDL_Delay(10);
+            return;
+        }
+        trace("presenting on VideoOut");
+    }
+
+    /*
+     * The renderer's display image (frames the guest draws without the GPU, through the VGA
+     * framebuffer, are not shown yet) - but only when the guest has flipped since, or a quarter
+     * second has passed (screens drawn without flips). Each request flushes the renderer's
+     * pending work and waits for it if the displayed surface was drawn into: 60 times a second
+     * on the PS4 that cost speed and showed half-drawn frames (flashing, v00.10). In between,
+     * the presenter shows its copy of the last frame.
+     */
+    static unsigned int last_flips;
+    static int64_t last_fetch_ns;
+    const unsigned int flips = g_nv2a_stats.frame_count;
+    const int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    const bool fetch = flips != last_flips || now - last_fetch_ns > 250 * SCALE_MS;
+    bool have_display = false;
+    if (fetch) {
+        have_display = nv2a_get_framebuffer_surface() != 0;
+        last_flips = flips;
+        last_fetch_ns = now;
+    }
+
+    xemu_main_loop_lock();
+    ps4_hud_update();
+    xemu_main_loop_unlock();
+
+    ps4_present_frame(have_display);
+    if (fetch) {
+        nv2a_release_framebuffer_surface();
+    }
+}
+
+int main(int argc, char **argv)
+{
+    QemuThread thread;
+
+    load_system_modules();
+    mkdir(XEMU_DATA, 0777);
+    mkdir(XEMU_DATA "/bios", 0777);
+    mkdir(XEMU_DATA "/hdd", 0777);
+    mkdir(XEMU_DATA "/games", 0777);
+    /* no /tmp on the PS4 (glib's temporary files, QEMU's fallbacks) */
+    mkdir(XEMU_DATA "/tmp", 0777);
+    setenv("TMPDIR", XEMU_DATA "/tmp", 1);
+    redirect_output();
+    atexit(trace_exit);
+    setlocale(LC_NUMERIC, "C");
+    profiling = access(XEMU_DATA "/profile.txt", F_OK) == 0;
+    if (profiling) {
+        ps4_sampler_start();
+        ps4_sampler_register_thread("main (display)");
+    }
+
+    trace("xemu-ps4 %s (%s %s) starting", xemu_version, xemu_commit, xemu_date);
+    trace("CPU: %s, OS: %s", xemu_get_cpu_info(), xemu_get_os_info());
+
+    xemu_settings_set_path(XEMU_DATA "/xemu.toml");
+    if (!xemu_settings_load()) {
+        trace("xemu.toml: %s", xemu_settings_get_error_message());
+    }
+    apply_ps4_settings();
+    xemu_settings_save();
+    atexit(xemu_settings_save);
+
+    /* One subsystem at a time: SDL_Init stops at the first that fails. No PS4 audio driver in
+     * SDL yet: the dummy one keeps xemu's audio streams working, silently. */
+    SDL_SetHint(SDL_HINT_AUDIO_DRIVER, "dummy");
+    static const struct {
+        SDL_InitFlags flag;
+        const char *name;
+    } subsystems[] = {
+        { SDL_INIT_EVENTS, "events" },
+        { SDL_INIT_GAMEPAD, "gamepad" },
+        { SDL_INIT_AUDIO, "audio" },
+    };
+    for (size_t i = 0; i < ARRAY_SIZE(subsystems); i++) {
+        if (!SDL_InitSubSystem(subsystems[i].flag)) {
+            trace("SDL %s: %s", subsystems[i].name, SDL_GetError());
+        }
+    }
+    ps4_pad_init();
+
+    /* QEMU parses no command line here: the machine comes from xemu.toml (system/vl.c). Extra
+     * QEMU options, one per line, from /data/xemu/qemu-args.txt (e.g. -d in_asm,int -D file). */
+    GPtrArray *args = g_ptr_array_new();
+    g_ptr_array_add(args, (char *)"xemu");
+    g_autofree char *extra = NULL;
+    if (g_file_get_contents(XEMU_DATA "/qemu-args.txt", &extra, NULL, NULL)) {
+        for (char **line = g_strsplit(extra, "\n", -1), **l = line; *l; l++) {
+            g_strstrip(*l);
+            if (**l != '\0' && **l != '#') {
+                trace("extra QEMU argument: %s", *l);
+                g_ptr_array_add(args, *l);
+            }
+        }
+    }
+    g_ptr_array_add(args, NULL);
+    g_argc = args->len - 1;
+    g_argv = (char **)args->pdata;
+
+    nv2a_context_init();
+
+    qemu_sem_init(&display_init_sem, 0);
+    qemu_sem_init(&display_shutdown_sem, 0);
+    trace("starting the emulator");
+    qemu_thread_create(&thread, "qemu_main", qemu_main, NULL, QEMU_THREAD_JOINABLE);
+    qemu_sem_wait(&display_init_sem);
+
+    tcg_register_init_ctx();
+    qemu_set_current_aio_context(qemu_get_aio_context());
+
+    xemu_main_loop_lock();
+    xemu_input_init();
+    xemu_main_loop_unlock();
+
+    QemuThread monitor;
+    qemu_thread_create(&monitor, "ps4-monitor", monitor_thread, NULL, QEMU_THREAD_DETACHED);
+
+    trace("main loop");
+    while (!qatomic_read(&qemu_exiting)) {
+        poll_events();
+        render_frame();
+    }
+    trace("exiting (%d)", exit_status);
+    qemu_sem_post(&display_shutdown_sem);
+    qemu_thread_join(&thread);
+    qemu_thread_join(&vblank_thread);
+    ps4_present_shutdown();
+    SDL_Quit();
+    return exit_status;
+}
+
+void xemu_eject_disc(Error **errp)
+{
+    Error *error = NULL;
+
+    xbox_smc_eject_button();
+    xemu_settings_set_string(&g_config.sys.files.dvd_path, "");
+
+    /* Xbox software may request that the drive open, but do it now anyway */
+    qmp_eject("ide0-cd1", NULL, true, false, &error);
+    if (error) {
+        error_propagate(errp, error);
+    }
+
+    xbox_smc_update_tray_state();
+}
+
+void xemu_load_disc(const char *path, Error **errp)
+{
+    Error *error = NULL;
+
+    /* Ensure an eject sequence is always triggered so Xbox software reloads */
+    xbox_smc_eject_button();
+    xemu_settings_set_string(&g_config.sys.files.dvd_path, "");
+
+    qmp_blockdev_change_medium("ide0-cd1", NULL, path, "raw", false, false,
+                               false, 0, &error);
+    if (error) {
+        error_propagate(errp, error);
+    } else {
+        xemu_settings_set_string(&g_config.sys.files.dvd_path, path);
+    }
+
+    xbox_smc_update_tray_state();
+}
