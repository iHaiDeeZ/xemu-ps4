+#define XEMU_DATA "/data/xemu"
+
+/* port/ps4_crashlog.cpp, after the host stacks: the emulator's view of the crash. No
+ * allocation or locks here. (The guest CPU's registers are for later: they live in target
+ * code this file doesn't see.) */
+void ps4_crash_guest_info(void)
+{
+    int fd = open(XEMU_DATA "/crash.log", O_WRONLY | O_CREAT | O_APPEND, 0666);
+    if (fd < 0) {
+        return;
+    }
+    char line[512];
+    int n = snprintf(line, sizeof(line), "\n== xemu at the crash: disc %s\n",
+                     g_config.sys.files.dvd_path ? g_config.sys.files.dvd_path : "");
+    if (n > 0) {
+        write(fd, line, MIN(n, (int)sizeof(line) - 1));
+    }
+    close(fd);
+}
