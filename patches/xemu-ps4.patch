+/* --- the loaded file (layouts shared with scripts/aot_rt.h) ------------------------------- */
+
+typedef struct AotEntry {
+    uint32_t pc, cs_base, flags, cflags;
+    uint16_t size, icount;
+    uint32_t pad;
+    uint64_t hash;
+} AotEntry;
+
+typedef struct AotHeader {
+    uint64_t magic;
+    uint32_t version;
+    uint32_t nb_entries;          /* blocks 1..n (entry 0 unused) */
+    uint64_t abi_key;
+    uint32_t title_id;
+    uint32_t nb_imports;
+    const AotEntry *entries;
+    uint32_t *valid;              /* [n + 1]: == *gen when valid */
+    uint32_t *gen;
+    void **imports;               /* filled here, by name */
+    const char *const *import_names;
+    void (*enter)(void *env, uint32_t id);
+    uint32_t *cur;                /* [0] the insn's pc, [1] its cc_op, before a call */
+    const char *built;
+} AotHeader;
+
+static AotHeader *hdr;
+static uint8_t *map_base;
+static size_t map_size;
+static uint32_t *index_head;      /* hash of (pc, flags) -> first block, chained by index_next */
+static uint32_t *index_next;
+static uint32_t index_mask;
+static unsigned long *valid_pages;   /* virtual 4 KiB pages holding blocks entered this generation */
+static uint32_t loaded_title;
+static uint32_t current_title;     /* the game started last (aot_set_title) */
+static char loaded_path[128];
+
+/* counters (read by the monitor thread without locks) */
+static uint64_t st_runs, st_trampolines, st_gens, st_misses_hash, st_direct;
+
+/*
+ * Why translated code returns to the main loop (live console "aot exits"): each return from a
+ * trampoline's run is classified by where the guest stopped. Off unless asked for: one branch in
+ * helper_aot_run.
+ */
+enum {
+    EXIT_REQUEST,       /* an interrupt or exit request was pending: the blocks stopped for it */
+    EXIT_NOT_IN_FILE,   /* the next code isn't in the file: the JIT runs it */
+    EXIT_FLAGS,         /* in the file, but compiled for other CPU flags */
+    EXIT_NOT_VALID,     /* in the file, not entered through its trampoline this generation */
+    EXIT_VALID,         /* in the file and valid: a block ended with exit_tb (STI, POPF, ...) */
+    EXIT_ENTRY,         /* (not an exit: the trampolines entered) */
+    EXIT_KINDS
+};
+static const char *const exit_names[EXIT_KINDS] = {
+    "interrupt/exit request", "not in the file (JIT)", "other flags", "not valid yet",
+    "valid (block exited on purpose)", "entered",
+};
+typedef struct AotExitSlot {
+    uint32_t pc;
+    uint32_t kind;
+    uint64_t n;
+} AotExitSlot;
+#define EXIT_SLOTS 8192
+static bool exit_watch;
+static AotExitSlot *exit_slots;
+static GHashTable *exit_pcs;            /* every block's pc (any flags) */
+static uint64_t exit_totals[EXIT_KINDS], exit_dropped, exit_longjmps, exit_runs0;
+static int64_t exit_since_ns;
+
+static inline uint32_t index_hash(uint32_t pc, uint32_t flags)
+{
+    return ((pc * 0x9E3779B1u) ^ (flags * 0x85EBCA77u)) >> 7;
+}
+
+/* --- executable memory for the file -------------------------------------------------------- */
+
+#ifdef __PS4__
+/*
+ * Direct memory mapped RWX, as Crema's recompiled code (port/ps4_runtime.cpp mapDirectExecutable):
+ * a game's translated code is 100+ MiB and the system flexible pool, where the kit puts executable
+ * mmaps, holds the heap (256 MiB) and the JIT's buffer (64 MiB) with ~70 MiB left. Probed once with
+ * a "ret" under a SIGSEGV/SIGBUS handler: a console whose jailbreak maps it but won't run it
+ * leaves the translated code off instead of crashing.
+ */
+int32_t sceKernelAllocateDirectMemory(off_t start, off_t end, size_t len, size_t align, int type,
+                                      off_t *phys);
+int32_t sceKernelMapDirectMemory(void **addr, size_t len, int prot, int flags, off_t phys,
+                                 size_t align);
+int32_t sceKernelReleaseDirectMemory(off_t phys, size_t len);
+size_t sceKernelGetDirectMemorySize(void);
+int32_t sceKernelMunmap(void *addr, size_t len);
+
+static off_t map_phys;
+static volatile uintptr_t probe_code;
+static volatile int probe_faulted;
+static struct sigaction probe_old_segv, probe_old_bus;
+
+static void aot_probe_handler(int sig, siginfo_t *si, void *context)
+{
+    /* PS4 ucontext: mcontext at 0x40, rip and rsp as registers 20 and 23 (Crema's crash log) */
+    uint64_t *regs = (uint64_t *)((char *)context + 0x40);
+    if (probe_code && regs[20] == probe_code) {
+        regs[20] = *(uint64_t *)regs[23];   /* as if the ret ran */
+        regs[23] += 8;
+        probe_faulted = 1;
+        return;
+    }
+    sigaction(SIGSEGV, &probe_old_segv, NULL);
+    sigaction(SIGBUS, &probe_old_bus, NULL);
+}
+
+static bool aot_runs_code(void *code)
+{
+    struct sigaction sa;
+    void (*volatile fn)(void) = (void (*)(void))code;
+
+    *(volatile uint8_t *)code = 0xC3;   /* ret */
+    memset(&sa, 0, sizeof(sa));
+    sa.sa_sigaction = aot_probe_handler;
+    sa.sa_flags = SA_SIGINFO;
+    sigemptyset(&sa.sa_mask);
+    probe_faulted = 0;
+    probe_code = (uintptr_t)code;
+    sigaction(SIGSEGV, &sa, &probe_old_segv);
+    sigaction(SIGBUS, &sa, &probe_old_bus);
+    fn();
+    sigaction(SIGSEGV, &probe_old_segv, NULL);
+    sigaction(SIGBUS, &probe_old_bus, NULL);
+    probe_code = 0;
+    return !probe_faulted;
+}
+
+int32_t sceKernelReserveVirtualRange(void **addr, size_t len, int flags, size_t align);
+
+/* Direct memory as Crema's mapDirectExecutable: a reserved range, the memory mapped over it. */
+static void *aot_map_direct(size_t size)
+{
+    void *base = NULL;
+    off_t phys = 0;
+    int32_t r;
+
+    r = sceKernelAllocateDirectMemory(0, sceKernelGetDirectMemorySize(), size, 16 * KiB, 0, &phys);
+    if (r != 0) {
+        fprintf(stderr, "aot: no %zu MiB of direct memory (0x%x)\n", size >> 20, (unsigned)r);
+        return NULL;
+    }
+    r = sceKernelReserveVirtualRange(&base, size, 0, 16 * KiB);
+    if (r == 0) {
+        r = sceKernelMapDirectMemory(&base, size, 0x7 /* CPU read, write, execute */,
+                                     0x10 /* fixed */, phys, 16 * KiB);
+    }
+    if (r != 0) {
+        /* v00.21 on 13.52: 0x80020016 (EINVAL) - the kernel won't make direct memory executable */
+        fprintf(stderr, "aot: direct memory can't be mapped executable (0x%x)\n", (unsigned)r);
+        if (base) {
+            sceKernelMunmap(base, size);
+        }
+        sceKernelReleaseDirectMemory(phys, size);
+        return NULL;
+    }
+    if (!aot_runs_code(base)) {
+        fprintf(stderr, "aot: executable direct memory does not run code\n");
+        sceKernelMunmap(base, size);
+        sceKernelReleaseDirectMemory(phys, size);
+        return NULL;
+    }
+    map_phys = phys;
+    return base;
+}
+
+/*
+ * Executable memory for the file: direct memory if the kernel allows it, else flexible memory
+ * through mmap (ps4-kit's wrap: the system pool, as the JIT's buffer; the app's regular pool when
+ * the system pool is short), each probed with a "ret" before use.
+ */
+static void *aot_exec_alloc(size_t size)
+{
+    void *base;
+
+    size = ROUND_UP(size, 16 * KiB);
+    map_phys = -1;
+    base = aot_map_direct(size);
+    if (!base) {
+        base = mmap(NULL, size, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS,
+                    -1, 0);
+        if (base == MAP_FAILED) {
+            fprintf(stderr, "aot: no %zu MiB of executable flexible memory either (errno %d)\n",
+                    size >> 20, errno);
+            return NULL;
+        }
+        if (!aot_runs_code(base)) {
+            fprintf(stderr, "aot: executable flexible memory does not run code\n");
+            munmap(base, size);
+            return NULL;
+        }
+        fprintf(stderr, "aot: %zu MiB of executable flexible memory at %p\n", size >> 20, base);
+    } else {
+        fprintf(stderr, "aot: %zu MiB of executable direct memory at %p\n", size >> 20, base);
+    }
+    map_size = size;
+    return base;
+}
+
+static void aot_exec_free(void *base, size_t size)
+{
+    if (map_phys >= 0) {
+        sceKernelMunmap(base, size);
+        sceKernelReleaseDirectMemory(map_phys, size);
+    } else {
+        munmap(base, size);
+    }
+}
+#else
+static void *aot_exec_alloc(size_t size)
+{
+    void *p = mmap(NULL, size, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    map_size = size;
+    return p == MAP_FAILED ? NULL : p;
+}
+
+static void aot_exec_free(void *base, size_t size)
+{
+    munmap(base, size);
+}
+#endif
+
+static void aot_unload(void)
+{
+    if (map_base) {
+        aot_loaded = false;
+        smp_mb();
+        aot_exec_free(map_base, map_size);
+    }
+    map_base = NULL;
+    hdr = NULL;
+    g_free(index_head);
+    g_free(index_next);
+    index_head = index_next = NULL;
+    g_free(valid_pages);
+    valid_pages = NULL;
+    loaded_title = 0;
+    loaded_path[0] = '\0';
+}
+
+/* accel/tcg/cputlb.c: the flat page tables */
+extern int aft_mmu;
+extern uintptr_t *aft_rd, *aft_wr;
+extern uint64_t aft_fills, aft_clears;
+bool aft_enable(int mmu_idx);
+void aft_refill(CPUState *cpu, int mmu_idx, vaddr addr);
+
+/* the translated code's slow loads and stores: QEMU's, then the flat tables refilled */
+static uint64_t aot_slow_ld(CPUArchState *env, uint64_t addr, uint32_t oi, uintptr_t ra)
+{
+    uint64_t v;
+    switch (get_memop(oi) & MO_SIZE) {
+    case MO_8: v = helper_ldub_mmu(env, addr, oi, ra); break;
+    case MO_16: v = helper_lduw_mmu(env, addr, oi, ra); break;
+    case MO_32: v = helper_ldul_mmu(env, addr, oi, ra); break;
+    default: v = helper_ldq_mmu(env, addr, oi, ra); break;
+    }
+    aft_refill(env_cpu(env), get_mmuidx(oi), addr);
+    return v;
+}
+
+static void aot_slow_st(CPUArchState *env, uint64_t addr, uint64_t val, uint32_t oi, uintptr_t ra)
+{
+    switch (get_memop(oi) & MO_SIZE) {
+    case MO_8: helper_stb_mmu(env, addr, val, oi, ra); break;
+    case MO_16: helper_stw_mmu(env, addr, val, oi, ra); break;
+    case MO_32: helper_stl_mmu(env, addr, val, oi, ra); break;
+    default: helper_stq_mmu(env, addr, val, oi, ra); break;
+    }
+    aft_refill(env_cpu(env), get_mmuidx(oi), addr);
+}
+
+static void *aot_import(const char *name)
+{
+    int mmu;
+    if (!strcmp(name, "aot_slow_ld")) {
+        return (void *)aot_slow_ld;
+    }
+    if (!strcmp(name, "aot_slow_st")) {
+        return (void *)aot_slow_st;
+    }
+    /* "aot_fast_rd_<mmu>" / "aot_fast_wr_<mmu>": the flat tables' addresses */
+    if ((sscanf(name, "aot_fast_rd_%d", &mmu) == 1 || sscanf(name, "aot_fast_wr_%d", &mmu) == 1) &&
+        aft_enable(mmu)) {
+        return name[9] == 'r' ? (void *)aft_rd : (void *)aft_wr;
+    }
+    for (size_t i = 0; i < target->nb_helpers; i++) {
+        if (!strcmp(target->helpers[i].name, name)) {
+            return target->helpers[i].func;
+        }
+    }
+    return NULL;
+}
+
+static bool aot_pread(int fd, void *buf, size_t len, uint64_t off)
+{
+    while (len) {
+        ssize_t n = pread(fd, buf, len, off);
+        if (n <= 0) {
+            return false;
+        }
+        buf = (char *)buf + n;
+        len -= n;
+        off += n;
+    }
+    return true;
+}
+
+/*
+ * Map an ELF64 shared object made by scripts/aot-build.py: its segments are read from the file
+ * straight into executable memory (the file is 100+ MiB: not through the heap first).
+ */
+static bool aot_map(const char *path, int fd, uint64_t len)
+{
+    Elf64_Ehdr ehs, *eh = &ehs;
+    g_autofree Elf64_Phdr *ph = NULL;
+    g_autofree Elf64_Shdr *sh = NULL;
+    g_autofree Elf64_Sym *symtab = NULL;
+    g_autofree char *strtab = NULL;
+    uint64_t lo = UINT64_MAX, hi = 0;
+    const Elf64_Dyn *dyn = NULL;
+    uint64_t rela = 0, relasz = 0, relaent = sizeof(Elf64_Rela);
+    size_t nsyms = 0;
+    AotHeader *h = NULL;
+
+    if (len < sizeof(*eh) || !aot_pread(fd, eh, sizeof(*eh), 0) ||
+        memcmp(eh->e_ident, ELFMAG, SELFMAG) != 0 ||
+        eh->e_ident[EI_CLASS] != ELFCLASS64 || eh->e_machine != EM_X86_64 ||
+        eh->e_type != ET_DYN || eh->e_phoff + (uint64_t)eh->e_phnum * sizeof(*ph) > len ||
+        eh->e_shoff + (uint64_t)eh->e_shnum * sizeof(*sh) > len) {
+        fprintf(stderr, "aot: %s is not an x86-64 shared object\n", path);
+        return false;
+    }
+    ph = g_new(Elf64_Phdr, eh->e_phnum);
+    sh = g_new(Elf64_Shdr, eh->e_shnum);
+    if (!aot_pread(fd, ph, eh->e_phnum * sizeof(*ph), eh->e_phoff) ||
+        !aot_pread(fd, sh, eh->e_shnum * sizeof(*sh), eh->e_shoff)) {
+        fprintf(stderr, "aot: %s: can't read its headers\n", path);
+        return false;
+    }
+    for (int i = 0; i < eh->e_phnum; i++) {
+        if (ph[i].p_type == PT_LOAD) {
+            lo = MIN(lo, ph[i].p_vaddr & ~0xfffull);
+            hi = MAX(hi, ph[i].p_vaddr + ph[i].p_memsz);
+        }
+    }
+    if (lo != 0 || hi == 0 || hi > 1024 * MiB) {
+        fprintf(stderr, "aot: %s: odd load layout\n", path);
+        return false;
+    }
+    map_base = aot_exec_alloc(ROUND_UP(hi, 16 * KiB));
+    if (!map_base) {
+        fprintf(stderr, "aot: %s: no %" PRIu64 " MiB of executable memory\n", path, hi >> 20);
+        return false;
+    }
+    memset(map_base, 0, hi);
+    for (int i = 0; i < eh->e_phnum; i++) {
+        if (ph[i].p_type != PT_LOAD) {
+            continue;
+        }
+        if (ph[i].p_offset + ph[i].p_filesz > len ||
+            !aot_pread(fd, map_base + ph[i].p_vaddr, ph[i].p_filesz, ph[i].p_offset)) {
+            fprintf(stderr, "aot: %s: truncated\n", path);
+            return false;
+        }
+        /* the rest (bss) was zeroed above */
+    }
+    for (int i = 0; i < eh->e_phnum; i++) {
+        if (ph[i].p_type == PT_DYNAMIC) {
+            dyn = (const void *)(map_base + ph[i].p_vaddr);
+        }
+    }
+    for (; dyn && dyn->d_tag != DT_NULL; dyn++) {
+        switch (dyn->d_tag) {
+        case DT_RELA: rela = dyn->d_un.d_ptr; break;
+        case DT_RELASZ: relasz = dyn->d_un.d_val; break;
+        case DT_RELAENT: relaent = dyn->d_un.d_val; break;
+        default: break;
+        }
+    }
+    for (uint64_t off = 0; rela && off + sizeof(Elf64_Rela) <= relasz; off += relaent) {
+        const Elf64_Rela *r = (const void *)(map_base + rela + off);
+        if (ELF64_R_TYPE(r->r_info) == R_X86_64_NONE) {
+            continue;
+        }
+        if (ELF64_R_TYPE(r->r_info) != R_X86_64_RELATIVE || r->r_offset + 8 > map_size) {
+            fprintf(stderr, "aot: %s: relocation type %u (only relative ones are expected)\n",
+                    path, (unsigned)ELF64_R_TYPE(r->r_info));
+            return false;
+        }
+        *(uint64_t *)(map_base + r->r_offset) = (uint64_t)(uintptr_t)map_base + r->r_addend;
+    }
+    /* the header: the one exported symbol, found through the section headers */
+    for (int i = 0; i < eh->e_shnum && !symtab; i++) {
+        const Elf64_Shdr *st = &sh[sh[i].sh_link < eh->e_shnum ? sh[i].sh_link : 0];
+        if (sh[i].sh_type == SHT_DYNSYM && sh[i].sh_link < eh->e_shnum &&
+            sh[i].sh_offset + sh[i].sh_size <= len && st->sh_offset + st->sh_size <= len &&
+            sh[i].sh_size < 16 * MiB && st->sh_size < 16 * MiB) {
+            symtab = g_malloc(sh[i].sh_size);
+            strtab = g_malloc0(st->sh_size + 1);
+            if (!aot_pread(fd, symtab, sh[i].sh_size, sh[i].sh_offset) ||
+                !aot_pread(fd, strtab, st->sh_size, st->sh_offset)) {
+                fprintf(stderr, "aot: %s: can't read its symbols\n", path);
+                return false;
+            }
+            nsyms = sh[i].sh_size / sizeof(Elf64_Sym);
+        }
+    }
+    for (size_t i = 0; i < nsyms; i++) {
+        if (!strcmp(strtab + symtab[i].st_name, "aot_header") && symtab[i].st_value < map_size) {
+            h = (AotHeader *)(map_base + symtab[i].st_value);
+        }
+    }
+    if (!h) {
+        fprintf(stderr, "aot: %s has no aot_header\n", path);
+        return false;
+    }
+    if (h->magic != AOT_MAGIC || h->version != AOT_VERSION) {
+        fprintf(stderr, "aot: %s: format %u, this build reads %u\n", path, h->version, AOT_VERSION);
+        return false;
+    }
+    if (h->abi_key != target->abi_key) {
+        fprintf(stderr, "aot: %s was recorded by another build (ABI %016" PRIx64 ", this %016"
+                PRIx64 "): record again\n", path, h->abi_key, target->abi_key);
+        return false;
+    }
+    for (uint32_t i = 0; i < h->nb_imports; i++) {
+        h->imports[i] = aot_import(h->import_names[i]);
+        if (!h->imports[i]) {
+            fprintf(stderr, "aot: %s calls helper %s, which this build lacks\n", path,
+                    h->import_names[i]);
+            return false;
+        }
+    }
+    hdr = h;
+    return true;
+}
+
+static bool aot_load(const char *path)
+{
+    int64_t t0 = get_clock();
+    struct stat st;
+    int fd = open(path, O_RDONLY);
+    bool ok;
+
+    if (fd < 0) {
+        return false;
+    }
+    ok = fstat(fd, &st) == 0 && aot_map(path, fd, st.st_size);
+    close(fd);
+    if (!ok) {
+        aot_unload();
+        return false;
+    }
+    /* the (pc, flags) index for x86_translate_code */
+    index_mask = pow2ceil(MAX(hdr->nb_entries * 2, 1024)) - 1;
+    index_head = g_new0(uint32_t, index_mask + 1);
+    index_next = g_new0(uint32_t, hdr->nb_entries + 1);
+    for (uint32_t id = 1; id <= hdr->nb_entries; id++) {
+        const AotEntry *e = &hdr->entries[id];
+        uint32_t h = index_hash(e->pc, e->flags) & index_mask;
+        index_next[id] = index_head[h];
+        index_head[h] = id;
+    }
+    valid_pages = bitmap_new(1u << (32 - 12));
+    *hdr->gen = 1;
+    snprintf(loaded_path, sizeof(loaded_path), "%s", path);
+    smp_mb();
+    aot_loaded = true;
+    fprintf(stderr, "aot: %s: %u translated blocks, %u helpers, built %s, mapped in %.0f ms"
+            " (%zu MiB)\n", path, hdr->nb_entries, hdr->nb_imports, hdr->built ? hdr->built : "?",
+            (get_clock() - t0) / 1e6, map_size >> 20);
+    return true;
+}
+
+/* --- recording -------------------------------------------------------------------------- */
+
+static QemuMutex rec_lock;
+static QemuCond rec_cond;
+static QemuThread rec_thread;
+static GQueue rec_queue = G_QUEUE_INIT;     /* GStrings to write, under rec_lock */
+static GString rec_close;                     /* queued: close the file (title change) */
+static GString *rec_buf;
+static char rec_path[160];
+static FILE *rec_file;                        /* the writer thread's */
+static GHashTable *rec_seen;                  /* keys written this session */
+static GHashTable *rec_why;                   /* reason -> count, under rec_lock */
+static uint64_t st_rec_blocks, st_rec_bytes, st_rec_skipped, st_rec_known;
+static bool rec_thread_started;
+
+static void *rec_writer(void *arg)
+{
+    qemu_mutex_lock(&rec_lock);
+    for (;;) {
+        GString *chunk;
+        while (!(chunk = g_queue_pop_head(&rec_queue))) {
+            qemu_cond_wait(&rec_cond, &rec_lock);
+        }
+        if (chunk == &rec_close) {
+            if (rec_file) {
+                fclose(rec_file);
+                rec_file = NULL;
+            }
+            continue;
+        }
+        if (!rec_file && rec_path[0]) {
+            rec_file = fopen(rec_path, "a");
+        }
+        qemu_mutex_unlock(&rec_lock);
+        if (rec_file) {
+            fwrite(chunk->str, 1, chunk->len, rec_file);
+            fflush(rec_file);
+        }
+        qatomic_add(&st_rec_bytes, chunk->len);
+        g_string_free(chunk, true);
+        qemu_mutex_lock(&rec_lock);
+    }
+    return NULL;
+}
+
+static void rec_push(GString *chunk)
+{
+    qemu_mutex_lock(&rec_lock);
+    g_queue_push_tail(&rec_queue, chunk);
+    qemu_cond_signal(&rec_cond);
+    qemu_mutex_unlock(&rec_lock);
+}
+
+static void rec_flush(void)
+{
+    if (rec_buf && rec_buf->len) {
+        rec_push(rec_buf);
+        rec_buf = g_string_sized_new(512 * KiB);
+    }
+}
+
+static void rec_stop(void)
+{
+    if (!aot_recording) {
+        return;
+    }
+    aot_recording = false;
+    rec_flush();
+    rec_push(&rec_close);
+}
+
+static void rec_start(uint32_t title)
+{
+    char dir[96];
+    g_autofree char *abi = NULL;
+
+    snprintf(dir, sizeof(dir), AOT_DIR "/%08x", title);
+    if (g_mkdir_with_parents(dir, 0777) != 0) {
+        fprintf(stderr, "aot: can't make %s\n", dir);
+        return;
+    }
+    abi = g_strdup_printf("%s/aot_abi.h", dir);
+    g_file_set_contents(abi, target->abi_header, -1, NULL);
+    qemu_mutex_lock(&rec_lock);
+    /* one file per session; the build merges them and drops blocks seen twice */
+    for (int n = 0; n < 10000; n++) {
+        snprintf(rec_path, sizeof(rec_path), "%s/blocks-%04d.c", dir, n);
+        if (access(rec_path, F_OK) != 0) {
+            break;
+        }
+    }
+    qemu_mutex_unlock(&rec_lock);
+    if (!rec_thread_started) {
+        qemu_thread_create(&rec_thread, "aot-writer", rec_writer, NULL, QEMU_THREAD_DETACHED);
+        rec_thread_started = true;
+    }
+    if (!rec_buf) {
+        rec_buf = g_string_sized_new(512 * KiB);
+    }
+    g_hash_table_remove_all(rec_seen);
+    aot_recording = true;
+    fprintf(stderr, "aot: recording blocks to %s\n", rec_path);
+}
+
+static uint64_t rec_key(uint32_t pc, uint32_t flags, uint32_t cflags, uint64_t hash)
+{
+    return hash ^ ((uint64_t)pc << 32 | flags) * 0x9E3779B97F4A7C15ull ^ cflags;
+}
+
+static uint32_t aot_cflags(uint32_t cf)
+{
+    return cf & ~(CF_INVALID | CF_CLUSTER_MASK);
+}
+
+void aot_record_tb(TCGContext *s, TranslationBlock *tb, vaddr pc)
+{
+    uint32_t cf = aot_cflags(tb_cflags(tb));
+    const char *why = NULL;
+    gpointer key;
+
+    if (!aot_recording || tb->aot_id) {
+        return;
+    }
+    if ((cf & (CF_COUNT_MASK | CF_SINGLE_STEP | CF_USE_ICOUNT | CF_NOIRQ | CF_BP_PAGE |
+               CF_NO_GOTO_TB | CF_NO_GOTO_PTR | CF_MEMI_ONLY | CF_PARALLEL)) ||
+        !(cf & CF_PCREL)) {
+        why = "block flags (single step, I/O, icount)";
+    } else if (tb->cs_base != 0 || pc > UINT32_MAX) {
+        why = "segmented code";
+    } else if (target->title_flags_ok && !target->title_flags_ok(tb->flags)) {
+        why = "not 32-bit protected mode";
+    }
+    if (!why) {
+        key = (gpointer)(uintptr_t)rec_key(pc, tb->flags, cf, tb->ihash);
+        if (g_hash_table_contains(rec_seen, key)) {
+            return;
+        }
+        g_hash_table_add(rec_seen, key);
+        /* already in the loaded file: nothing new to record */
+        if (aot_loaded) {
+            for (uint32_t id = index_head[index_hash(pc, tb->flags) & index_mask]; id;
+                 id = index_next[id]) {
+                const AotEntry *e = &hdr->entries[id];
+                if (e->pc == pc && e->flags == tb->flags && e->cflags == cf &&
+                    e->hash == tb->ihash && e->size == tb->size) {
+                    st_rec_known++;
+                    return;
+                }
+            }
+        }
+        if (tcg_aot_emit_tb(s, tb, pc, rec_buf, &why)) {
+            st_rec_blocks++;
+            if (rec_buf->len >= 256 * KiB) {
+                rec_flush();
+            }
+            return;
+        }
+        /* a failed emit may have left a partial record in rec_buf: it writes only on success */
+    }
+    st_rec_skipped++;
+    qemu_mutex_lock(&rec_lock);
+    gpointer n = g_hash_table_lookup(rec_why, why);
+    if (!n) {
+        g_hash_table_insert(rec_why, g_strdup(why), GUINT_TO_POINTER(1));
+    } else {
+        g_hash_table_insert(rec_why, g_strdup(why), GUINT_TO_POINTER(GPOINTER_TO_UINT(n) + 1));
+    }
+    qemu_mutex_unlock(&rec_lock);
+}
+
+/* --- the game ---------------------------------------------------------------------------- */
+
+void aot_set_title(uint32_t title_id)
+{
+    char path[96];
+
+    if (!target) {
+        return;
+    }
+    current_title = title_id;
+    rec_stop();
+    if (loaded_title != title_id) {
+        aot_unload();
+        if (title_id && aot_use) {
+            snprintf(path, sizeof(path), AOT_DIR "/%08x.aot", title_id);
+            if (access(path, R_OK) == 0 && aot_load(path)) {
+                loaded_title = title_id;
+            }
+        }
+    }
+    if (title_id && aot_record) {
+        rec_start(title_id);
+    }
+}
+
+/* --- running ----------------------------------------------------------------------------- */
+
+int aot_find(CPUState *cpu, const TranslationBlock *tb, vaddr pc, uint16_t *size)
+{
+    uint32_t cf = aot_cflags(tb_cflags(tb));
+    CPUArchState *env = cpu_env(cpu);
+
+    if (!aot_loaded || !aot_use || pc > UINT32_MAX || tb->cs_base != 0) {
+        return 0;
+    }
+    for (uint32_t id = index_head[index_hash(pc, tb->flags) & index_mask]; id; id = index_next[id]) {
+        const AotEntry *e = &hdr->entries[id];
+        int mmu_idx = cpu_mmu_index(cpu, true);
+        void *host;
+        bool mapped = true;
+
+        if (e->pc != pc || e->flags != tb->flags || e->cflags != cf) {
+            continue;
+        }
+        /* the block's bytes must be readable code (no fault from looking) */
+        for (vaddr p = pc & TARGET_PAGE_MASK; p < pc + e->size; p += TARGET_PAGE_SIZE) {
+            int fl = probe_access_flags(env, p, 1, MMU_INST_FETCH, mmu_idx, true, &host, 0);
+            if (fl & (TLB_INVALID_MASK | TLB_MMIO)) {
+                mapped = false;
+                break;
+            }
+        }
+        if (!mapped) {
+            continue;
+        }
+        if (tb_code_hash_func(env, pc, e->size) != e->hash) {
+            st_misses_hash++;
+            continue;
+        }
+        *size = e->size;
+        st_trampolines++;
+        return id;
+    }
+    return 0;
+}
+
+static void exit_count(uint32_t pc, uint32_t kind)
+{
+    uint32_t h = ((pc * 0x9E3779B1u) ^ (kind * 0x85EBCA77u)) >> 13;
+
+    exit_totals[kind]++;
+    for (int probe = 0; probe < 32; probe++, h++) {
+        AotExitSlot *s = &exit_slots[h & (EXIT_SLOTS - 1)];
+        if (s->n == 0) {
+            s->pc = pc;
+            s->kind = kind;
+        }
+        if (s->pc == pc && s->kind == kind) {
+            s->n++;
+            return;
+        }
+    }
+    exit_dropped++;
+}
+
+static void exit_note(CPUState *cpu, uint32_t entered_pc)
+{
+    TCGTBCPUState s = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+    uint32_t pc = (uint32_t)s.pc;
+    uint32_t kind = EXIT_NOT_IN_FILE;
+
+    exit_count(entered_pc, EXIT_ENTRY);
+    if (qatomic_read(&cpu->neg.icount_decr.u16.high) || qatomic_read(&cpu->exit_request)) {
+        kind = EXIT_REQUEST;
+    } else {
+        for (uint32_t id = index_head[index_hash(pc, s.flags) & index_mask]; id; id = index_next[id]) {
+            const AotEntry *e = &hdr->entries[id];
+            if (e->pc == pc && e->flags == s.flags) {
+                kind = hdr->valid[id] ? EXIT_VALID : EXIT_NOT_VALID;
+                break;
+            }
+        }
+        if (kind == EXIT_NOT_IN_FILE && g_hash_table_contains(exit_pcs, GUINT_TO_POINTER(pc))) {
+            kind = EXIT_FLAGS;      /* a block at this pc, under other flags */
+        }
+    }
+    exit_count(pc, kind);
+}
+
+/*
+ * The block the CPU would run next, if it is in the file and valid (its trampoline ran this
+ * generation): what the main loop would find with tb_lookup, for the CPU's real flags. The blocks'
+ * own lookup (AOT_IND) uses the flags they were compiled with: after POPF, STI, a segment load and
+ * the like it misses, and so does every exit_tb.
+ */
+static uint32_t aot_next_id(CPUState *cpu)
+{
+    TCGTBCPUState s = cpu->cc->tcg_ops->get_tb_cpu_state(cpu);
+    uint32_t cf;
+
+    if (s.cs_base != 0 || s.pc > UINT32_MAX) {
+        return 0;
+    }
+    cf = aot_cflags(curr_cflags(cpu));
+    for (uint32_t id = index_head[index_hash(s.pc, s.flags) & index_mask]; id; id = index_next[id]) {
+        const AotEntry *e = &hdr->entries[id];
+        if (e->pc == s.pc && e->flags == s.flags && e->cflags == cf) {
+            return hdr->valid[id] ? id : 0;
+        }
+    }
+    return 0;
+}
+
+void HELPER(aot_run)(CPUArchState *env, uint32_t id)
+{
+    CPUState *cpu = env_cpu(env);
+    const AotEntry *e;
+
+    if (unlikely(!aot_loaded || id == 0 || id > hdr->nb_entries)) {
+        /*
+         * A trampoline from before the file changed (aot_set_title flushes them, but
+         * one may run before the flush): drop all TBs and go back to the main loop,
+         * which retranslates this one, rather than loop on it.
+         */
+        queue_tb_flush(env_cpu(env));
+        cpu_loop_exit(env_cpu(env));
+    }
+    e = &hdr->entries[id];
+    hdr->valid[id] = 1;
+    set_bit(e->pc >> 12, valid_pages);
+    set_bit((e->pc + e->size - 1) >> 12, valid_pages);
+    st_runs++;
+    for (int n = 0;; n++) {
+        hdr->enter(env, id);
+        if (unlikely(exit_watch)) {
+            exit_note(cpu, e->pc);
+        }
+        /*
+         * Nothing for the main loop to do (no interrupt, exit request, one-off TB flags, single
+         * step or breakpoint): the next block, if translated and valid, runs from here - what
+         * cpu_exec would do, minus its round trip (cpu_handle_interrupt, tb_lookup, cpu_tb_exec).
+         * Every 256 the main loop gets a turn anyway.
+         */
+        if (!aot_direct || n >= 255 || qatomic_read(&cpu->neg.icount_decr.u16.high) ||
+            qatomic_read(&cpu->exit_request) || qatomic_read(&cpu->interrupt_request) ||
+            cpu->cflags_next_tb != -1 || cpu->singlestep_enabled ||
+            !QTAILQ_EMPTY(&cpu->breakpoints)) {
+            return;
+        }
+        id = aot_next_id(cpu);
+        if (!id) {
+            return;
+        }
+        e = &hdr->entries[id];
+        st_direct++;
+    }
+}
+
+void aot_entered(int id)
+{
+}
+
+void aot_tb_invalidated(int id)
+{
+    if (aot_loaded && id > 0 && (uint32_t)id <= hdr->nb_entries) {
+        hdr->valid[id] = 0;
+    }
+}
+
+static void aot_new_generation(void)
+{
+    /*
+     * Blocks check "valid[id]" (1) at entry; files before v00.24 compare it with *gen, which stays
+     * 1: clearing the flags ends the generation for both.
+     */
+    memset(hdr->valid, 0, (hdr->nb_entries + 1) * sizeof(uint32_t));
+    *hdr->gen = 1;
+    bitmap_zero(valid_pages, 1u << (32 - 12));
+    st_gens++;
+}
+
+void aot_tlb_flushed(void)
+{
+    if (aot_loaded) {
+        aot_new_generation();
+    }
+}
+
+void aot_tlb_flushed_page(vaddr addr)
+{
+    if (aot_loaded && addr <= UINT32_MAX) {
+        uint32_t p = addr >> 12;
+        if (test_bit(p, valid_pages) || (p > 0 && test_bit(p - 1, valid_pages))) {
+            aot_new_generation();
+        }
+    }
+}
+
+void aot_tlb_flushed_range(vaddr addr, vaddr len)
+{
+    if (!aot_loaded) {
+        return;
+    }
+    if (len > 64 * TARGET_PAGE_SIZE || addr > UINT32_MAX) {
+        aot_new_generation();
+        return;
+    }
+    for (vaddr a = addr; a < addr + len; a += TARGET_PAGE_SIZE) {
+        uint32_t p = a >> 12;
+        if (test_bit(p, valid_pages) || (p > 0 && test_bit(p - 1, valid_pages))) {
+            aot_new_generation();
+            return;
+        }
+    }
+}
+
+void aot_tb_flushed(void)
+{
+    if (aot_loaded) {
+        aot_new_generation();
+    }
+}
+
+bool aot_restore_state(CPUState *cpu, uintptr_t host_pc)
+{
+    if (!aot_loaded || host_pc < (uintptr_t)map_base || host_pc >= (uintptr_t)map_base + map_size) {
+        return false;
+    }
+    target->restore(cpu, hdr->cur[0], (int)hdr->cur[1]);
+    return true;
+}
+
+bool aot_unwind_state_data(CPUState *cpu, uintptr_t host_pc, uint64_t *data)
+{
+    if (!aot_loaded || host_pc < (uintptr_t)map_base || host_pc >= (uintptr_t)map_base + map_size) {
+        return false;
+    }
+    /* as insn_start's words in a PC-relative block: the pc's page offset, cc_op */
+    data[0] = hdr->cur[0] & ~TARGET_PAGE_MASK;
+    data[1] = hdr->cur[1];
+    return true;
+}
+
+void aot_stats(GString *out, bool verbose)
+{
+    if (aot_loaded) {
+        uint32_t valid = 0;
+        if (verbose) {
+            for (uint32_t id = 1; id <= hdr->nb_entries; id++) {
+                valid += hdr->valid[id] != 0;
+            }
+        }
+        g_string_append_printf(out, "aot: %s %u blocks, %" PRIu64 " entries from the JIT, %"
+                               PRIu64 " run straight after (%s), %" PRIu64 " trampolines, %"
+                               PRIu64 " code changed, %" PRIu64 " generations", loaded_path,
+                               hdr->nb_entries, st_runs, st_direct, aot_direct ? "on" : "off",
+                               st_trampolines, st_misses_hash, st_gens);
+        if (verbose) {
+            g_string_append_printf(out, ", %u valid now; flat page tables (MMU %d): %" PRIu64
+                                   " fills, %" PRIu64 " clears", valid, aft_mmu, aft_fills, aft_clears);
+        }
+    } else {
+        g_string_append(out, "aot: no translated code loaded");
+    }
+    if (aot_recording || st_rec_blocks) {
+        g_string_append_printf(out, "; recorded %" PRIu64 " blocks (%" PRIu64 " KiB written, %"
+                               PRIu64 " already compiled, %" PRIu64 " not translatable)",
+                               st_rec_blocks, qatomic_read(&st_rec_bytes) >> 10, st_rec_known,
+                               st_rec_skipped);
+    }
+    if (verbose && st_rec_skipped) {
+        GHashTableIter it;
+        gpointer k, v;
+        qemu_mutex_lock(&rec_lock);
+        g_hash_table_iter_init(&it, rec_why);
+        while (g_hash_table_iter_next(&it, &k, &v)) {
+            g_string_append_printf(out, "\n  not translated: %u x %s", GPOINTER_TO_UINT(v),
+                                   (const char *)k);
+        }
+        qemu_mutex_unlock(&rec_lock);
+    }
+}
+
+static int exit_slot_cmp(gconstpointer a, gconstpointer b)
+{
+    const AotExitSlot *x = a, *y = b;
+    return x->n < y->n ? 1 : x->n > y->n ? -1 : 0;
+}
+
+/* The live console's "aot exits [on|off]": the exit histogram since it was switched on. */
+void aot_exits(GString *out, const char *args)
+{
+    if (!aot_loaded) {
+        g_string_append(out, "aot exits: no translated code loaded\n");
+        return;
+    }
+    if (strcmp(args, "on") == 0 || strcmp(args, "clear") == 0) {
+        if (!exit_slots) {
+            exit_slots = g_new0(AotExitSlot, EXIT_SLOTS);
+        }
+        exit_watch = false;
+        smp_mb();
+        g_usleep(20000);                /* (an exit being noted finishes) */
+        if (exit_pcs) {
+            g_hash_table_destroy(exit_pcs);
+        }
+        exit_pcs = g_hash_table_new(g_direct_hash, g_direct_equal);
+        for (uint32_t id = 1; id <= hdr->nb_entries; id++) {
+            g_hash_table_add(exit_pcs, GUINT_TO_POINTER(hdr->entries[id].pc));
+        }
+        memset(exit_slots, 0, EXIT_SLOTS * sizeof(*exit_slots));
+        memset(exit_totals, 0, sizeof(exit_totals));
+        exit_dropped = 0;
+        exit_runs0 = st_runs;
+        exit_since_ns = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+        smp_mb();
+        exit_watch = true;
+        g_string_append(out, "aot exits: recording (\"aot exits\" for the table, \"aot exits off\" to stop)\n");
+        return;
+    }
+    if (strcmp(args, "off") == 0) {
+        exit_watch = false;
+        g_string_append(out, "aot exits: stopped\n");
+        return;
+    }
+    if (!exit_slots) {
+        g_string_append(out, "aot exits: not recording (\"aot exits on\")\n");
+        return;
+    }
+    const double secs = MAX(1e-3, (qemu_clock_get_ns(QEMU_CLOCK_REALTIME) - exit_since_ns) / 1e9);
+    const uint64_t runs = st_runs - exit_runs0;
+    uint64_t returned = 0;
+    for (int k = 0; k < EXIT_KINDS; k++) {
+        if (k != EXIT_ENTRY) {
+            returned += exit_totals[k];
+        }
+    }
+    g_string_append_printf(out, "aot exits over %.1f s%s: %" PRIu64 " runs (%.0f/s), %" PRIu64
+                           " returned, %" PRIu64 " left by longjmp (exceptions, helpers)\n",
+                           secs, exit_watch ? "" : " (stopped)", runs, runs / secs, returned,
+                           runs > returned ? runs - returned : 0);
+    for (int k = 0; k < EXIT_KINDS; k++) {
+        if (k != EXIT_ENTRY) {
+            g_string_append_printf(out, "  %10.0f/s %5.1f%%  %s\n", exit_totals[k] / secs,
+                                   100.0 * exit_totals[k] / MAX(returned, 1), exit_names[k]);
+        }
+    }
+    if (exit_dropped) {
+        g_string_append_printf(out, "  (%" PRIu64 " not in the table: full)\n", exit_dropped);
+    }
+    g_autofree AotExitSlot *copy = g_memdup2(exit_slots, EXIT_SLOTS * sizeof(*exit_slots));
+    qsort(copy, EXIT_SLOTS, sizeof(*copy), exit_slot_cmp);
+    for (int pass = 0; pass < 2; pass++) {
+        int shown = 0;
+        g_string_append(out, pass ? "busiest trampolines (entered):\n" : "where the blocks stopped:\n");
+        for (int i = 0; i < EXIT_SLOTS && shown < 40 && copy[i].n; i++) {
+            if ((copy[i].kind == EXIT_ENTRY) != (pass == 1)) {
+                continue;
+            }
+            g_string_append_printf(out, "  %10.0f/s  %08x  %s\n", copy[i].n / secs, copy[i].pc,
+                                   exit_names[copy[i].kind]);
+            shown++;
+        }
+    }
+}
+
+/* The live console's "aot load" / "aot off", with the machine stopped and the TBs flushed after. */
+const char *aot_switch(bool load)
+{
+    char path[96];
+
+    aot_unload();
+    if (!load) {
+        return "translated code dropped: the JIT runs everything";
+    }
+    if (!current_title) {
+        return "no game started from the library";
+    }
+    snprintf(path, sizeof(path), AOT_DIR "/%08x.aot", current_title);
+    if (access(path, R_OK) != 0) {
+        return "no translated code for this game on the console";
+    }
+    if (!aot_load(path)) {
+        return "the file did not load (xemu.log says why)";
+    }
+    loaded_title = current_title;
+    return "loaded";
+}
