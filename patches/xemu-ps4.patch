+void ps4_thread_busy_report(char *out, size_t size, int min_percent); /* port/ps4_sampler.cpp */
+void ps4_watch_thread(const char *name);
+void ps4_sampler_register_thread(const char *name);
+void ps4_sampler_start(void);
+
+/* Settings > Profiler or /data/xemu/profile.txt: the 1 kHz sampler writes samples.log */
+static bool profiling;
+
+/* libkernel's thread calls (the PS4's priorities: 256 highest .. 767 lowest, 700 default), under
+ * names of our own: OpenOrbis' libkernel.h declares scePthreadSetaffinity without its arguments */
+int ps4x_set_affinity(pthread_t thread, uint64_t mask) __asm__("scePthreadSetaffinity");
+int ps4x_set_priority(pthread_t thread, int prio) __asm__("scePthreadSetprio");
+
+/*
+ * Where xemu's threads run (Settings > CPU layout, ps4.ini cpu_layout). The PS4 gives threads of
+ * one priority no turns: a busy thread keeps its core until it blocks, and with every thread free
+ * to run anywhere at the default priority (v00.15) the emulated CPU, the NV2A and the APU kept
+ * landing on each other's cores while others sat idle - the "synchronization-bound" 1 fps (the
+ * Max Payne 3 port saw the same: 3x in its fights once the threads had places). Pinned: the four
+ * threads that set the pace get a core each, nothing else may run there; everything else shares
+ * cores 4-6. Priorities only matter among the sharers: vblank and the main loop's wake-ups first,
+ * the APU's voice workers next, the frontend, then the background.
+ */
+typedef struct ThreadPlace {
+    const char *name;
+    int core;       /* -1: the shared cores */
+    int priority;
+} ThreadPlace;
+
+static const ThreadPlace thread_places[] = {
+    { "CPU 0/TCG", 0, 640 },            /* the emulated Pentium III */
+    { "ALL CPUs/TCG", 0, 640 },         /* (single-threaded TCG) */
+    { "nv2a.pfifo_thread", 1, 640 },    /* the GPU: push buffer, Vulkan recording, submits */
+    { "qemu_main", 2, 620 },            /* QEMU's main loop: timers, interrupts, disk I/O */
+    { "mcpx.apu_thread", 3, 630 },      /* the APU's frame loop and its DSPs (interpreter) */
+    { "mcpx.voice_worker", -1, 640 },
+    { "vblank-timer", -1, 600 },
+    { "worker", -1, 700 },              /* QEMU's thread pool (disk reads) */
+    { "call_rcu", -1, 720 },
+    { "ps4-monitor", -1, 720 },
+};
+
+static uint64_t app_cores = 0x3f;       /* the cores the app may use (0x7f with the 7th) */
+static uint64_t shared_cores = 0x30;    /* what isn't pinned: cores 4.. */
+
+static void place_thread(const char *name)
+{
+    const ThreadPlace *place = NULL;
+    for (size_t i = 0; i < ARRAY_SIZE(thread_places); i++) {
+        if (strcmp(name, thread_places[i].name) == 0) {
+            place = &thread_places[i];
+        }
+    }
+    if (ps4_settings.cpu_layout == PS4_CPU_FLOATING) {
+        ps4x_set_affinity(pthread_self(), app_cores);
+        return;
+    }
+    const uint64_t mask = place && place->core >= 0 ? (1ull << place->core) : shared_cores;
+    int r1 = ps4x_set_affinity(pthread_self(), mask);
+    int r2 = place ? ps4x_set_priority(pthread_self(), place->priority) : 0;
+    if (place) {
+        ps4_boot_tracef("thread %s: cores %#llx%s, priority %d%s", name, (unsigned long long)mask,
+                        r1 ? " (refused)" : "", place->priority, r2 ? " (refused)" : "");
+    }
+}
+
+/*
+ * Every QEMU thread, first thing (util/qemu-thread-posix.c). The emulation's busy threads go
+ * to the sampler when profiling (it keeps the name pointer: a copy; QEMU starts its threads
+ * with every signal blocked, the sampler's SIGPROF must come through).
+ */
+void ps4_thread_started(const char *name)
+{
+    /*
+     * QEMU starts its threads with every signal blocked (the main loop handles them): let the kit's
+     * crash handler, thread dumps and profilers reach them. SIGUSR2 stays blocked: QEMU's coroutines
+     * start through it (coroutine-sigaltstack.c).
+     */
+    {
+        sigset_t s;
+        sigemptyset(&s);
+        sigaddset(&s, SIGSEGV);
+        sigaddset(&s, SIGBUS);
+        sigaddset(&s, SIGILL);
+        sigaddset(&s, SIGFPE);
+        sigaddset(&s, SIGABRT);
+        sigaddset(&s, SIGTRAP);
+        sigaddset(&s, SIGUSR1);
+        sigaddset(&s, SIGVTALRM);
+        pthread_sigmask(SIG_UNBLOCK, &s, NULL);
+    }
+    place_thread(name);
+    static const char *const sampled[] = { "nv2a.pfifo_thread", "mcpx.apu_thread",
+                                           "qemu_main" };
+    /* the emulated CPU: "CPU 0/TCG" (multi-threaded TCG) or "ALL CPUs/TCG" */
+    bool sample = profiling && g_str_has_suffix(name, "/TCG");
+    for (size_t i = 0; i < ARRAY_SIZE(sampled); i++) {
+        sample |= profiling && strcmp(name, sampled[i]) == 0;
+    }
+    if (!sample) {
+        ps4_watch_thread(name);
+        return;
+    }
+    sigset_t prof;
+    sigemptyset(&prof);
+    sigaddset(&prof, SIGPROF);
+    pthread_sigmask(SIG_UNBLOCK, &prof, NULL);
+    ps4_sampler_register_thread(g_strdup(name));
+}
+
+/* the busiest threads over the last 5 s, for the HUD's overlay (ps4-frontend.h) */
+char ps4_perf_threads[256];
+/* how busy the GPU was over the last 5 s, in percent (-1: not known yet) */
+int ps4_perf_gpu = -1;
+
+/* port/mesa/ac_ps4_drm.c: GPU time with work in flight, and first start to last end, in GPU
+ * clock ticks (timestamps around each submission) */
+void ac_ps4_get_gpu_busy(uint64_t *busy_ticks, uint64_t *span_ticks);
+void ps4_thread_cpu_tick(void);
+
+/*
+ * Every 5 s in boot-trace.log: frames presented (and with the emulated display in them),
+ * frames the guest flipped on the NV2A, the guest's clock and where its CPU is, and each named
+ * thread at 5% or more (one near 100% limits the speed). Racy reads, for diagnosis only.
+ */
+static void *monitor_thread(void *opaque)
+{
+    uint64_t last_frames = 0, last_display = 0;
+    unsigned int last_flips = 0;
+    int64_t last_guest_ns = 0;
+    while (!qatomic_read(&qemu_exiting)) {
+        g_usleep(5 * G_USEC_PER_SEC);
+        uint64_t frames, display;
+        ps4_present_stats(&frames, &display);
+        unsigned int flips = g_nv2a_stats.frame_count;
+        int64_t guest_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        CPUState *cpu = first_cpu;
+        uint64_t pc = 0;
+        if (cpu != NULL && CPU_GET_CLASS(cpu)->get_pc) {
+            pc = CPU_GET_CLASS(cpu)->get_pc(cpu);
+        }
+        char threads[sizeof(ps4_perf_threads)];
+        ps4_thread_busy_report(threads, sizeof(threads), 5);
+        memcpy(ps4_perf_threads, threads, sizeof(threads));
+        static uint64_t last_busy, last_span;
+        uint64_t busy, span;
+        ac_ps4_get_gpu_busy(&busy, &span);
+        if (span > last_span && last_span != 0) {
+            ps4_perf_gpu = (int)((busy - last_busy) * 100 / (span - last_span));
+        }
+        last_busy = busy;
+        last_span = span;
+        char pad_stats[160];
+        ps4_pad_stats(pad_stats, sizeof(pad_stats));
+        /* the main loop's waits since the last line (util/qemu-timer.c) */
+        static uint64_t last_waits, last_sleeps, last_spin_ns;
+        const uint64_t waits = ps4_poll_waits, sleeps = ps4_poll_sleeps,
+                       spin_ns = ps4_poll_spin_total_ns;
+        char loop_stats[200];
+        snprintf(loop_stats, sizeof(loop_stats), "main loop %.0f waits/s, %.0f slept, spun %.1f%%",
+                 (waits - last_waits) / 5.0, (sleeps - last_sleeps) / 5.0,
+                 (spin_ns - last_spin_ns) / 5e9 * 100.0);
+        last_waits = waits;
+        last_sleeps = sleeps;
+        last_spin_ns = spin_ns;
+        static uint64_t last_resets, last_walks;
+        const uint64_t resets = tlb_dirty_index_resets, walks = tlb_dirty_index_walks;
+        if (tlb_dirty_index_enabled) {
+            const size_t len = strlen(loop_stats);
+            snprintf(loop_stats + len, sizeof(loop_stats) - len, "; TLB dirty resets %.0f/s, %.0f walked",
+                     (resets - last_resets) / 5.0, (walks - last_walks) / 5.0);
+        }
+        last_resets = resets;
+        last_walks = walks;
+        ps4_heap_trim();
+        if (ps4_settings.monitor_log) {
+            trace("monitor: presented %.1f/s (display in %.1f/s), guest flips %.1f/s, "
+                  "guest clock +%.2f s, runstate %s, cpu pc 0x%08" PRIx64 "%s | GPU %d%% | %s | %s | %s",
+                  (frames - last_frames) / 5.0, (display - last_display) / 5.0,
+                  (flips - last_flips) / 5.0, (guest_ns - last_guest_ns) / 1e9,
+                  RunState_str(runstate_get()), pc,
+                  cpu != NULL && cpu->halted ? " (halted)" : "", ps4_perf_gpu, threads, loop_stats,
+                  pad_stats);
+        }
+        /* (no cpu_dump_state here: from this thread, with the guest kernel running, it took
+         * the process down in v00.07) */
+
+        /* the automatic profile: once the game has run 60 s, the first time it flips fewer than
+         * 20 frames a second for two monitor periods in a row (then once more, 5 minutes later) */
+        static int slow_periods, auto_profiles;
+        static int64_t last_profile_ns;
+        const int64_t now_ns = get_clock();
+        const double flips_per_s = (flips - last_flips) / 5.0;
+        slow_periods = runstate_is_running() && flips_per_s < 20.0 ? slow_periods + 1 : 0;
+        if (ps4_settings.auto_profile && slow_periods >= 2 && auto_profiles < 2 &&
+            guest_ns > 60 * NANOSECONDS_PER_SECOND &&
+            (last_profile_ns == 0 || now_ns - last_profile_ns > 300 * NANOSECONDS_PER_SECOND)) {
+            char reason[64];
+            snprintf(reason, sizeof(reason), "auto: %.1f flips/s", flips_per_s);
+            if (ps4_profile_now(reason)) {
+                auto_profiles++;
+                last_profile_ns = now_ns;
+            }
+        }        /* no guest frame for 30 s while running: where every thread is, once (hang.log) */
+        static int stalled_periods;
+        static bool dumped;
+        stalled_periods = runstate_is_running() && flips == last_flips ? stalled_periods + 1 : 0;
+        if (stalled_periods >= 6 && !dumped && guest_ns > 60 * NANOSECONDS_PER_SECOND) {
+            dumped = true;
+            trace("no guest frame for 30 s: thread stacks in hang.log");
+            ps4_dump_thread_stacks(XEMU_DATA "/hang.log", "no guest frame for 30 s");
+        }
+        last_frames = frames;
+        last_display = display;
+        last_flips = flips;
+        last_guest_ns = guest_ns;
+    }
+    return NULL;
+}
+
+/*
+ * QEMU's main loop sleeps until shortly before each timer deadline and spins the rest
+ * (util/qemu-timer.c, ps4_poll_ns): how much it spins comes from how far the PS4's sleeps
+ * overshoot, measured here (Settings: poll_spin_us in ps4.ini, -1 = this measurement).
+ */
+static void ps4_sleep_nanosleep(int64_t ns)
+{
+    struct timespec ts = { ns / 1000000000LL, ns % 1000000000LL };
+    nanosleep(&ts, NULL);
+}
+
+static void ps4_sleep_usleep(int64_t ns)
+{
+    sceKernelUsleep((unsigned int)(ns / 1000));
+}
+
+static void calibrate_main_loop_waits(void)
+{
+    if (ps4_settings.poll_spin_us >= 0) {
+        ps4_poll_spin_ns = (int64_t)ps4_settings.poll_spin_us * 1000;
+        trace("main loop waits: spin the last %d us (ps4.ini)", ps4_settings.poll_spin_us);
+        return;
+    }
+    /* each of the PS4's sleeps, 16 times 300 us: how much later than asked it wakes up */
+    static const char *const names[] = { "pselect", "nanosleep", "sceKernelUsleep" };
+    int64_t avg[3], worst[3];
+    for (int k = 0; k < 3; k++) {
+        int64_t total = 0;
+        worst[k] = 0;
+        for (int i = 0; i < 16; i++) {
+            struct timespec ts = { 0, 300000 };
+            const int64_t t0 = get_clock();
+            if (k == 0) {
+                pselect(0, NULL, NULL, NULL, &ts, NULL);
+            } else if (k == 1) {
+                nanosleep(&ts, NULL);
+            } else {
+                sceKernelUsleep(300);
+            }
+            const int64_t over = MAX(0, get_clock() - t0 - 300000);
+            total += over;
+            worst[k] = MAX(worst[k], over);
+        }
+        avg[k] = total / 16;
+        trace("main loop waits: a 300 us %s overshoots %lld us on average, %lld at worst", names[k],
+              (long long)(avg[k] / 1000), (long long)(worst[k] / 1000));
+    }
+    /* the short waits (under 2 ms) with the most precise of the sleeps, if it beats pselect */
+    int best = 0;
+    for (int k = 1; k < 3; k++) {
+        if (avg[k] < avg[best]) {
+            best = k;
+        }
+    }
+    if (best != 0 && avg[best] + 100000 < avg[0]) {
+        ps4_poll_short_sleep = best == 1 ? ps4_sleep_nanosleep : ps4_sleep_usleep;
+        ps4_poll_short_ns = 2000000;
+    }
+    /* spin past the usual overshoot; a sleep that is coarser than that (a 1 ms tick) is taken as
+     * it comes rather than spun through: a timer a little late beats a core lost to spinning */
+    const int64_t spin = MIN(MAX(avg[best] + 50000, 50000), 400000);
+    ps4_poll_spin_ns = spin;
+    trace("main loop waits: short ones with %s, spin the last %lld us", names[best],
+          (long long)(spin / 1000));
+}
+
+/*
+ * CPU profiles (ps4-kit's burst profiler, profiles/profile_N.txt in /data/xemu): the emulation's
+ * threads sampled every 4 ms for 8 s, with their call stacks - from the menu, or once by itself when
+ * the game runs slowly (Settings: auto_profile). The presenter (main) thread is left out: it waits on
+ * the display, and a signal there has frozen other ports.
+ */
+bool ps4_profile_now(const char *reason)
+{
+    static const char *const threads[] = { "CPU 0/TCG", "ALL CPUs/TCG", "nv2a.pfifo", "qemu_main",
+                                           "mcpx.apu", "mcpx.voice", "worker" };
+    ps4_profile_set_threads(threads, ARRAY_SIZE(threads));
+    ps4_profile_set_enabled(1);
+    const bool started = ps4_profile_start(8.0, reason);
+    trace("profile (%s): %s", reason, started ? "8 s from now, profiles/profile_N.txt" : "one is running");
+    return started;
+}
