+/*
+ * xemu-ps4: the PS4 frontend's pieces (xemu-ps4.c, ps4-present.cc, ps4-hud.cc)
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#ifndef UI_PS4_PS4_FRONTEND_H
+#define UI_PS4_PS4_FRONTEND_H
+
+#include <stdbool.h>
+#include <SDL3/SDL.h>
+#include "hw/xbox/nv2a/nv2a_vk_ps4.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ps4-present.cc: VideoOut swapchain on the renderer's device, ImGui on top */
+bool ps4_present_ready(void);
+bool ps4_present_init(const NV2AVkDevice *dev);
+/* Draws one frame: the display image (between nv2a_get/release_framebuffer_surface) scaled to
+ * the screen, then the HUD's ImGui frame; returns once the GPU is done with the display image. */
+void ps4_present_frame(bool have_display);
+void ps4_present_shutdown(void);
+/* frames presented so far, and those that had the emulated display in them */
+void ps4_present_stats(uint64_t *frames, uint64_t *display_frames);
+
+/* ps4-pad.c: the DualShock 4 as an SDL virtual gamepad (after SDL's gamepad subsystem) */
+void ps4_pad_init(void);
+/* its SDL joystick id (0 if it couldn't be set up) */
+SDL_JoystickID ps4_pad_joystick_id(void);
+/* reads, failures, reopens and the last buttons, for the monitor */
+void ps4_pad_stats(char *out, size_t size);
+
+/* xemu-ps4.c: the busiest threads over the last 5 s ("name N%, ..."), for the overlay */
+extern char ps4_perf_threads[256];
+
+/* xemu-ps4.c: why the Xbox can't start (a BIOS mismatch, ...), NULL if nothing is known wrong */
+extern const char *ps4_setup_problem;
+
+/* ps4-hud.cc: notifications, status and menus (ImGui), called with the main loop lock */
+void ps4_hud_process_sdl_event(const SDL_Event *event);
+void ps4_hud_update(void);
+/* between ImGui::NewFrame and ImGui::Render (presenter) */
+void ps4_hud_draw(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/ui/ps4/ps4-hud.cc b/ui/ps4/ps4-hud.cc
new file mode 100644
index 0000000000..0ab2702976
--- /dev/null
+++ b/ui/ps4/ps4-hud.cc
@@ -0,0 +1,178 @@
+/*
+ * xemu-ps4: the HUD drawn over the emulated picture (ImGui): notifications and error messages
+ * (xemu-notifications.h, which the desktop's xui implements), and what is missing before a
+ * game can start. The home screen and menus (from Resonance's launcher) come on top of this.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "ps4-frontend.h"
+#include "ui/xemu-notifications.h"
+#include "ui/xemu-settings.h"
+#include "hw/xbox/nv2a/debug.h"
+
+#include "imgui.h"
+
+#include <chrono>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <unistd.h>
+
+namespace
+{
+using Clock = std::chrono::steady_clock;
+
+struct Message
+{
+    std::string text;
+    bool error;
+    Clock::time_point shown;
+};
+
+std::mutex sMutex;
+std::deque<Message> sQueue;     // waiting to be shown, oldest first
+Message sCurrent;
+bool sShowing;
+constexpr auto kShowTime = std::chrono::seconds(4);
+constexpr auto kErrorShowTime = std::chrono::seconds(10);
+
+void Queue(const char *msg, bool error)
+{
+    std::lock_guard<std::mutex> lock(sMutex);
+    sQueue.push_back({ msg, error, {} });
+}
+
+void DrawNotification()
+{
+    std::lock_guard<std::mutex> lock(sMutex);
+    const auto now = Clock::now();
+    if (sShowing && now - sCurrent.shown > (sCurrent.error ? kErrorShowTime : kShowTime)) {
+        sShowing = false;
+    }
+    if (!sShowing && !sQueue.empty()) {
+        sCurrent = sQueue.front();
+        sCurrent.shown = now;
+        sQueue.pop_front();
+        sShowing = true;
+    }
+    if (!sShowing) {
+        return;
+    }
+    const ImVec2 screen = ImGui::GetIO().DisplaySize;
+    ImGui::SetNextWindowPos(ImVec2(screen.x * 0.5f, screen.y - 80.0f), ImGuiCond_Always,
+                            ImVec2(0.5f, 1.0f));
+    ImGui::SetNextWindowBgAlpha(0.8f);
+    ImGui::Begin("##notification", nullptr,
+                 ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_AlwaysAutoResize |
+                     ImGuiWindowFlags_NoNav | ImGuiWindowFlags_NoFocusOnAppearing |
+                     ImGuiWindowFlags_NoInputs);
+    if (sCurrent.error) {
+        ImGui::TextColored(ImVec4(1.0f, 0.4f, 0.4f, 1.0f), "%s", sCurrent.text.c_str());
+    } else {
+        ImGui::TextUnformatted(sCurrent.text.c_str());
+    }
+    ImGui::End();
+}
+
+// Top left: the game's frame rate (NV2A flips), the display's, and the busiest threads
+void DrawPerformance()
+{
+    static Clock::time_point last = Clock::now();
+    static unsigned lastFlips;
+    static uint64_t lastFrames;
+    static float gameFps, displayFps;
+    const auto now = Clock::now();
+    const float secs = std::chrono::duration<float>(now - last).count();
+    if (secs >= 0.5f) {
+        uint64_t frames, displayFrames;
+        ps4_present_stats(&frames, &displayFrames);
+        const unsigned flips = g_nv2a_stats.frame_count;
+        gameFps = (flips - lastFlips) / secs;
+        displayFps = (frames - lastFrames) / secs;
+        lastFlips = flips;
+        lastFrames = frames;
+        last = now;
+    }
+    ImGui::SetNextWindowPos(ImVec2(16.0f, 16.0f), ImGuiCond_Always);
+    ImGui::SetNextWindowBgAlpha(0.55f);
+    ImGui::Begin("##performance", nullptr,
+                 ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_AlwaysAutoResize |
+                     ImGuiWindowFlags_NoNav | ImGuiWindowFlags_NoFocusOnAppearing |
+                     ImGuiWindowFlags_NoInputs);
+    ImGui::Text("Game %.1f FPS   Display %.0f FPS", gameFps, displayFps);
+    if (ps4_perf_threads[0] != '\0') {
+        ImGui::TextColored(ImVec4(0.7f, 0.7f, 0.7f, 1.0f), "%s", ps4_perf_threads);
+    }
+    ImGui::End();
+}
+
+// Until the BIOS files are in place the Xbox can't start: say where they go
+void DrawSetupHelp()
+{
+    const bool haveBootrom = g_config.sys.files.bootrom_path[0] != '\0' &&
+                             access(g_config.sys.files.bootrom_path, R_OK) == 0;
+    const bool haveFlash = g_config.sys.files.flashrom_path[0] != '\0' &&
+                           access(g_config.sys.files.flashrom_path, R_OK) == 0;
+    if (haveBootrom && haveFlash) {
+        if (ps4_setup_problem != nullptr) {
+            const ImVec2 screen = ImGui::GetIO().DisplaySize;
+            ImGui::SetNextWindowPos(ImVec2(screen.x * 0.5f, screen.y * 0.5f), ImGuiCond_Always,
+                                    ImVec2(0.5f, 0.5f));
+            ImGui::SetNextWindowSize(ImVec2(screen.x * 0.6f, 0.0f));
+            ImGui::Begin("xemu for PS4", nullptr,
+                         ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoMove |
+                             ImGuiWindowFlags_NoResize);
+            ImGui::TextWrapped("%s", ps4_setup_problem);
+            ImGui::End();
+        }
+        return;
+    }
+    const ImVec2 screen = ImGui::GetIO().DisplaySize;
+    ImGui::SetNextWindowPos(ImVec2(screen.x * 0.5f, screen.y * 0.5f), ImGuiCond_Always,
+                            ImVec2(0.5f, 0.5f));
+    ImGui::Begin("xemu for PS4", nullptr,
+                 ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_AlwaysAutoResize |
+                     ImGuiWindowFlags_NoMove);
+    ImGui::TextUnformatted("The Xbox BIOS files are missing.");
+    ImGui::Spacing();
+    ImGui::TextUnformatted("Copy them to /data/xemu/bios on the PS4 (FTP), then restart:");
+    ImGui::BulletText("MCPX boot ROM (512 bytes)%s", haveBootrom ? ": found" : "");
+    ImGui::BulletText("flash BIOS (256 KiB or 1 MiB)%s", haveFlash ? ": found" : "");
+    ImGui::Spacing();
+    ImGui::TextUnformatted("Hard disk image: /data/xemu/hdd/xbox_hdd.qcow2");
+    ImGui::TextUnformatted("Games (.iso): /data/xemu/games");
+    ImGui::End();
+}
+} // namespace
+
+extern "C" void xemu_queue_notification(const char *msg)
+{
+    fprintf(stderr, "notification: %s\n", msg);
+    Queue(msg, false);
+}
+
+extern "C" void xemu_queue_error_message(const char *msg)
+{
+    fprintf(stderr, "error: %s\n", msg);
+    Queue(msg, true);
+}
+
+extern "C" void ps4_hud_process_sdl_event(const SDL_Event *event)
+{
+    (void)event;
+}
+
+extern "C" void ps4_hud_update(void)
+{
+}
+
+extern "C" void ps4_hud_draw(void)
+{
+    DrawPerformance();
+    DrawSetupHelp();
+    DrawNotification();
+}
diff --git a/ui/ps4/ps4-pad.c b/ui/ps4/ps4-pad.c
