+#elif HAVE_SHARED_DISPLAY_IMAGE
+    /* The display image is rendered (and idle) when the sync completes; the
+     * frontend samples it until nv2a_release_framebuffer_surface (ps4.c). */
+    qemu_event_reset(&d->pgraph.sync_complete);
+    qatomic_set(&pg->sync_pending, true);
+    pfifo_kick(d);
+    qemu_mutex_unlock(&d->pfifo.lock);
