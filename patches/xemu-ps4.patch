+/* Settings > Profiler or /data/xemu/profile.txt: the 1 kHz sampler writes samples.log */
+static bool profiling;
+
+/* libkernel's thread calls (the PS4's priorities: 256 highest .. 767 lowest, 700 default), under
+ * names of our own: OpenOrbis' libkernel.h declares scePthreadSetaffinity without its arguments */
+int ps4x_set_affinity(pthread_t thread, uint64_t mask) __asm__("scePthreadSetaffinity");
+int ps4x_set_priority(pthread_t thread, int prio) __asm__("scePthreadSetprio");
+
+/*
+ * Where xemu's threads run (Settings > CPU layout, ps4.ini cpu_layout). The PS4 gives threads of
+ * one priority no turns: a busy thread keeps its core until it blocks, and with every thread free
+ * to run anywhere at the default priority (v00.15) the emulated CPU, the NV2A and the APU kept
+ * landing on each other's cores while others sat idle - the "synchronization-bound" 1 fps (the
+ * Max Payne 3 port saw the same: 3x in its fights once the threads had places). Pinned: the four
+ * threads that set the pace get a core each, nothing else may run there; everything else shares
+ * cores 4-6. Priorities only matter among the sharers: vblank and the main loop's wake-ups first,
+ * the APU's voice workers next, the frontend, then the background.
+ */
+typedef struct ThreadPlace {
+    const char *name;
+    int core;       /* -1: the shared cores */
+    int priority;
+} ThreadPlace;
+
+static const ThreadPlace thread_places[] = {
+    { "CPU 0/TCG", 0, 640 },            /* the emulated Pentium III */
+    { "ALL CPUs/TCG", 0, 640 },         /* (single-threaded TCG) */
+    { "nv2a.pfifo_thread", 1, 640 },    /* the GPU: push buffer, Vulkan recording, submits */
+    { "qemu_main", 2, 620 },            /* QEMU's main loop: timers, interrupts, disk I/O */
+    { "mcpx.apu_thread", 3, 630 },      /* the APU's frame loop and its DSPs (interpreter) */
+    { "mcpx.voice_worker", -1, 680 },
+    { "vblank-timer", -1, 600 },
+    { "worker", -1, 700 },              /* QEMU's thread pool (disk reads) */
+    { "call_rcu", -1, 720 },
+    { "ps4-monitor", -1, 720 },
+};
+
+static uint64_t app_cores = 0x3f;       /* the cores the app may use (0x7f with the 7th) */
+static uint64_t shared_cores = 0x30;    /* what isn't pinned: cores 4.. */
+
+static void place_thread(const char *name)
+{
+    const ThreadPlace *place = NULL;
+    for (size_t i = 0; i < ARRAY_SIZE(thread_places); i++) {
+        if (strcmp(name, thread_places[i].name) == 0) {
+            place = &thread_places[i];
+        }
+    }
+    if (ps4_settings.cpu_layout == PS4_CPU_FLOATING) {
+        ps4x_set_affinity(pthread_self(), app_cores);
+        return;
+    }
+    const uint64_t mask = place && place->core >= 0 ? (1ull << place->core) : shared_cores;
+    int r1 = ps4x_set_affinity(pthread_self(), mask);
+    int r2 = place ? ps4x_set_priority(pthread_self(), place->priority) : 0;
+    if (place) {
+        ps4_boot_tracef("thread %s: cores %#llx%s, priority %d%s", name, (unsigned long long)mask,
+                        r1 ? " (refused)" : "", place->priority, r2 ? " (refused)" : "");
+    }
+}
+
+/*
+ * Every QEMU thread, first thing (util/qemu-thread-posix.c). The emulation's busy threads go
+ * to the sampler when profiling (it keeps the name pointer: a copy; QEMU starts its threads
+ * with every signal blocked, the sampler's SIGPROF must come through).
+ */
+void ps4_thread_started(const char *name)
+{
+    /*
+     * QEMU starts its threads with every signal blocked (the main loop handles them): let the kit's
+     * crash handler, thread dumps and profilers reach them. SIGUSR2 stays blocked: QEMU's coroutines
+     * start through it (coroutine-sigaltstack.c).
+     */
+    {
+        sigset_t s;
+        sigemptyset(&s);
+        sigaddset(&s, SIGSEGV);
+        sigaddset(&s, SIGBUS);
+        sigaddset(&s, SIGILL);
+        sigaddset(&s, SIGFPE);
+        sigaddset(&s, SIGABRT);
+        sigaddset(&s, SIGTRAP);
+        sigaddset(&s, SIGUSR1);
+        sigaddset(&s, SIGVTALRM);
+        pthread_sigmask(SIG_UNBLOCK, &s, NULL);
+    }
+    place_thread(name);
+    static const char *const sampled[] = { "nv2a.pfifo_thread", "mcpx.apu_thread",
+                                           "qemu_main" };
+    /* the emulated CPU: "CPU 0/TCG" (multi-threaded TCG) or "ALL CPUs/TCG" */
+    bool sample = profiling && g_str_has_suffix(name, "/TCG");
+    for (size_t i = 0; i < ARRAY_SIZE(sampled); i++) {
+        sample |= profiling && strcmp(name, sampled[i]) == 0;
+    }
+    if (!sample) {
+        ps4_watch_thread(name);
+        return;
+    }
+    sigset_t prof;
+    sigemptyset(&prof);
+    sigaddset(&prof, SIGPROF);
+    pthread_sigmask(SIG_UNBLOCK, &prof, NULL);
+    ps4_sampler_register_thread(g_strdup(name));
+}
+
+/* the busiest threads over the last 5 s, for the HUD's overlay (ps4-frontend.h) */
+char ps4_perf_threads[256];
+/* how busy the GPU was over the last 5 s, in percent (-1: not known yet) */
+int ps4_perf_gpu = -1;
+
+/* port/mesa/ac_ps4_drm.c: GPU time with work in flight, and first start to last end, in GPU
+ * clock ticks (timestamps around each submission) */
+void ac_ps4_get_gpu_busy(uint64_t *busy_ticks, uint64_t *span_ticks);
+void ps4_thread_cpu_tick(void);
+
+/*
+ * Every 5 s in boot-trace.log: frames presented (and with the emulated display in them),
+ * frames the guest flipped on the NV2A, the guest's clock and where its CPU is, and each named
+ * thread at 5% or more (one near 100% limits the speed). Racy reads, for diagnosis only.
+ */
+static void *monitor_thread(void *opaque)
+{
+    uint64_t last_frames = 0, last_display = 0;
+    unsigned int last_flips = 0;
+    int64_t last_guest_ns = 0;
+    while (!qatomic_read(&qemu_exiting)) {
+        g_usleep(5 * G_USEC_PER_SEC);
+        uint64_t frames, display;
+        ps4_present_stats(&frames, &display);
+        unsigned int flips = g_nv2a_stats.frame_count;
+        int64_t guest_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        CPUState *cpu = first_cpu;
+        uint64_t pc = 0;
+        if (cpu != NULL && CPU_GET_CLASS(cpu)->get_pc) {
+            pc = CPU_GET_CLASS(cpu)->get_pc(cpu);
+        }
+        char threads[sizeof(ps4_perf_threads)];
+        ps4_thread_busy_report(threads, sizeof(threads), 5);
+        memcpy(ps4_perf_threads, threads, sizeof(threads));
+        static uint64_t last_busy, last_span;
+        uint64_t busy, span;
+        ac_ps4_get_gpu_busy(&busy, &span);
+        if (span > last_span && last_span != 0) {
+            ps4_perf_gpu = (int)((busy - last_busy) * 100 / (span - last_span));
+        }
+        last_busy = busy;
+        last_span = span;
+        char pad_stats[160];
+        ps4_pad_stats(pad_stats, sizeof(pad_stats));
+        /* the main loop's waits since the last line (util/qemu-timer.c) */
+        static uint64_t last_waits, last_sleeps, last_spin_ns;
+        const uint64_t waits = ps4_poll_waits, sleeps = ps4_poll_sleeps,
+                       spin_ns = ps4_poll_spin_total_ns;
+        char loop_stats[200];
+        snprintf(loop_stats, sizeof(loop_stats), "main loop %.0f waits/s, %.0f slept, spun %.1f%%",
+                 (waits - last_waits) / 5.0, (sleeps - last_sleeps) / 5.0,
+                 (spin_ns - last_spin_ns) / 5e9 * 100.0);
+        last_waits = waits;
+        last_sleeps = sleeps;
+        last_spin_ns = spin_ns;
+        static uint64_t last_resets, last_walks;
+        const uint64_t resets = tlb_dirty_index_resets, walks = tlb_dirty_index_walks;
+        if (tlb_dirty_index_enabled) {
+            const size_t len = strlen(loop_stats);
+            snprintf(loop_stats + len, sizeof(loop_stats) - len, "; TLB dirty resets %.0f/s, %.0f walked",
+                     (resets - last_resets) / 5.0, (walks - last_walks) / 5.0);
+        }
+        last_resets = resets;
+        last_walks = walks;
+        ps4_heap_trim();
+        g_autoptr(GString) aot_line = g_string_new(NULL);
+        aot_stats(aot_line, false);
+        snprintf(ps4_live_last_monitor, sizeof(ps4_live_last_monitor),
+                 "presented %.1f/s (display in %.1f/s), guest flips %.1f/s, guest clock +%.2f s, "
+                 "runstate %s, cpu pc 0x%08" PRIx64 " | GPU %d%% | %s | %s | %s",
+                 (frames - last_frames) / 5.0, (display - last_display) / 5.0,
+                 (flips - last_flips) / 5.0, (guest_ns - last_guest_ns) / 1e9,
+                 RunState_str(runstate_get()), pc, ps4_perf_gpu, threads, loop_stats, aot_line->str);
+        if (ps4_settings.monitor_log) {
+            trace("monitor: presented %.1f/s (display in %.1f/s), guest flips %.1f/s, "
+                  "guest clock +%.2f s, runstate %s, cpu pc 0x%08" PRIx64 "%s | GPU %d%% | %s | %s | %s"
+                  " | %s",
+                  (frames - last_frames) / 5.0, (display - last_display) / 5.0,
+                  (flips - last_flips) / 5.0, (guest_ns - last_guest_ns) / 1e9,
+                  RunState_str(runstate_get()), pc,
+                  cpu != NULL && cpu->halted ? " (halted)" : "", ps4_perf_gpu, threads, loop_stats,
+                  pad_stats, aot_line->str);
+        }
+        /* (no cpu_dump_state here: from this thread, with the guest kernel running, it took
+         * the process down in v00.07) */
+
+        /* the automatic profile: once the game has run 60 s, the first time it flips fewer than
+         * 20 frames a second for two monitor periods in a row (then once more, 5 minutes later) */
+        static int slow_periods, auto_profiles;
+        static int64_t last_profile_ns;
+        const int64_t now_ns = get_clock();
+        const double flips_per_s = (flips - last_flips) / 5.0;
+        slow_periods = runstate_is_running() && flips_per_s < 20.0 ? slow_periods + 1 : 0;
+        if (ps4_settings.auto_profile && slow_periods >= 2 && auto_profiles < 2 &&
+            guest_ns > 60 * NANOSECONDS_PER_SECOND &&
+            (last_profile_ns == 0 || now_ns - last_profile_ns > 300 * NANOSECONDS_PER_SECOND)) {
+            char reason[64];
+            snprintf(reason, sizeof(reason), "auto: %.1f flips/s", flips_per_s);
+            if (ps4_profile_now(reason)) {
+                auto_profiles++;
+                last_profile_ns = now_ns;
+            }
+        }        /* no guest frame for 30 s while running: where every thread is, once (hang.log) */
+        static int stalled_periods;
+        static bool dumped;
+        stalled_periods = runstate_is_running() && flips == last_flips ? stalled_periods + 1 : 0;
+        if (stalled_periods >= 6 && !dumped && guest_ns > 60 * NANOSECONDS_PER_SECOND) {
+            dumped = true;
+            trace("no guest frame for 30 s: thread stacks in hang.log");
+            ps4_dump_thread_stacks(XEMU_DATA "/hang.log", "no guest frame for 30 s");
+        }
+        last_frames = frames;
+        last_display = display;
+        last_flips = flips;
+        last_guest_ns = guest_ns;
+    }
+    return NULL;
+}
+
+/*
+ * QEMU's main loop sleeps until shortly before each timer deadline and spins the rest
+ * (util/qemu-timer.c, ps4_poll_ns): how much it spins comes from how far the PS4's sleeps
+ * overshoot, measured here (Settings: poll_spin_us in ps4.ini, -1 = this measurement).
+ */
+static void ps4_sleep_nanosleep(int64_t ns)
+{
+    struct timespec ts = { ns / 1000000000LL, ns % 1000000000LL };
+    nanosleep(&ts, NULL);
+}
+
+static void ps4_sleep_usleep(int64_t ns)
+{
+    sceKernelUsleep((unsigned int)(ns / 1000));
+}
+
+static void calibrate_main_loop_waits(void)
+{
+    if (ps4_settings.poll_spin_us >= 0) {
+        ps4_poll_spin_ns = (int64_t)ps4_settings.poll_spin_us * 1000;
+        trace("main loop waits: spin the last %d us (ps4.ini)", ps4_settings.poll_spin_us);
+        return;
+    }
+    /* each of the PS4's sleeps, 16 times 300 us: how much later than asked it wakes up */
+    static const char *const names[] = { "pselect", "nanosleep", "sceKernelUsleep" };
+    int64_t avg[3], worst[3];
+    for (int k = 0; k < 3; k++) {
+        int64_t total = 0;
+        worst[k] = 0;
+        for (int i = 0; i < 16; i++) {
+            struct timespec ts = { 0, 300000 };
+            const int64_t t0 = get_clock();
+            if (k == 0) {
+                pselect(0, NULL, NULL, NULL, &ts, NULL);
+            } else if (k == 1) {
+                nanosleep(&ts, NULL);
+            } else {
+                sceKernelUsleep(300);
+            }
+            const int64_t over = MAX(0, get_clock() - t0 - 300000);
+            total += over;
+            worst[k] = MAX(worst[k], over);
+        }
+        avg[k] = total / 16;
+        trace("main loop waits: a 300 us %s overshoots %lld us on average, %lld at worst", names[k],
+              (long long)(avg[k] / 1000), (long long)(worst[k] / 1000));
+    }
+    /* the short waits (under 2 ms) with the most precise of the sleeps, if it beats pselect */
+    int best = 0;
+    for (int k = 1; k < 3; k++) {
+        if (avg[k] < avg[best]) {
+            best = k;
+        }
+    }
+    if (best != 0 && avg[best] + 100000 < avg[0]) {
+        ps4_poll_short_sleep = best == 1 ? ps4_sleep_nanosleep : ps4_sleep_usleep;
+        ps4_poll_short_ns = 2000000;
+    }
+    /* spin past the usual overshoot; a sleep that is coarser than that (a 1 ms tick) is taken as
+     * it comes rather than spun through: a timer a little late beats a core lost to spinning */
+    const int64_t spin = MIN(MAX(avg[best] + 50000, 50000), 400000);
+    ps4_poll_spin_ns = spin;
+    trace("main loop waits: short ones with %s, spin the last %lld us", names[best],
+          (long long)(spin / 1000));
+}
+
+/*
+ * CPU profiles (ps4-kit's burst profiler, profiles/profile_N.txt in /data/xemu): the emulation's
+ * threads sampled every 4 ms for 8 s, with their call stacks - from the menu, or once by itself when
+ * the game runs slowly (Settings: auto_profile). The presenter (main) thread is left out: it waits on
+ * the display, and a signal there has frozen other ports.
+ */
+bool ps4_profile_now(const char *reason)
+{
+    static const char *const threads[] = { "CPU 0/TCG", "ALL CPUs/TCG", "nv2a.pfifo", "qemu_main",
+                                           "mcpx.apu", "mcpx.voice", "worker" };
+    ps4_profile_set_threads(threads, ARRAY_SIZE(threads));
+    ps4_profile_set_enabled(1);
+    const bool started = ps4_profile_start(8.0, reason);
+    trace("profile (%s): %s", reason, started ? "8 s from now, profiles/profile_N.txt" : "one is running");
+    return started;
+}
+
+static int g_argc;
+static char **g_argv;
+static int g_argc;
+static char **g_argv;
+
+static void *qemu_main(void *opaque)
+{
+    qemu_init(g_argc, g_argv);
+    exit_status = qemu_main_loop();
+    qatomic_set(&qemu_exiting, true);
+    bql_unlock();
+    qemu_mutex_unlock_main_loop();
+
+    qemu_sem_wait(&display_shutdown_sem);
+    bql_lock();
+    qemu_cleanup(exit_status);
+    bql_unlock();
+    return NULL;
+}
+
+/*
+ * The DualShock 4 on Xbox port 1. xemu-input binds a gamepad when SDL reports it added; in
+ * v00.10 that never showed in the log. If the pad isn't among xemu's controllers a second
+ * after start, hand xemu-input the "added" event; if port 1 holds the keyboard (no use on the
+ * PS4), the pad takes it.
+ */
+static void ensure_pad_bound(void)
+{
+    static int64_t start_ns;
+    static bool done;
+    const SDL_JoystickID id = ps4_pad_joystick_id();
+    const int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    if (done || id == 0) {
+        return;
+    }
+    if (start_ns == 0) {
+        start_ns = now;
+    }
+    if (now - start_ns < NANOSECONDS_PER_SECOND) {
+        return;
+    }
+    done = true;
+
+    ControllerState *con = NULL, *iter;
+    QTAILQ_FOREACH (iter, &available_controllers, entry) {
+        if (iter->type == INPUT_DEVICE_SDL_GAMEPAD && iter->sdl_joystick_id == id) {
+            con = iter;
+        }
+    }
+    if (con == NULL) {
+        trace("pad: not among xemu's controllers after 1 s: adding it");
+        SDL_Event added = { 0 };
+        added.type = SDL_EVENT_GAMEPAD_ADDED;
+        added.gdevice.which = id;
+        xemu_input_process_sdl_events(&added);
+        QTAILQ_FOREACH (iter, &available_controllers, entry) {
+            if (iter->type == INPUT_DEVICE_SDL_GAMEPAD && iter->sdl_joystick_id == id) {
+                con = iter;
+            }
+        }
+    }
+    if (con == NULL) {
+        trace("pad: xemu couldn't open it as a gamepad (%s)", SDL_GetError());
+        return;
+    }
+    ControllerState *port1 = xemu_input_get_bound(0);
+    if (con->bound < 0 && (port1 == NULL || port1->type == INPUT_DEVICE_SDL_KEYBOARD)) {
+        xemu_input_bind(0, con, 1);
+    }
+    trace("pad: '%s' on Xbox port %d", con->name ? con->name : "?", con->bound + 1);
+}
+
+static void poll_events(void)
+{
+    SDL_Event ev;
+    static int logged;
+    while (SDL_PollEvent(&ev)) {
+        if (logged < 16 && ev.type >= SDL_EVENT_JOYSTICK_AXIS_MOTION &&
+            ev.type < SDL_EVENT_FINGER_DOWN && ev.type != SDL_EVENT_JOYSTICK_AXIS_MOTION &&
+            ev.type != SDL_EVENT_GAMEPAD_AXIS_MOTION) {
+            trace("SDL event 0x%x (device %u)", ev.type, (unsigned)ev.jdevice.which);
+            logged++;
+        }
+        xemu_main_loop_lock();
+        ps4_hud_process_sdl_event(&ev);
+        xemu_input_process_sdl_events(&ev);
+        xemu_main_loop_unlock();
+    }
+    xemu_main_loop_lock();
+    ensure_pad_bound();
+    xemu_input_update_controllers();
+    xemu_main_loop_unlock();
+}
+
+static void render_frame(void)
+{
+    ps4_thread_cpu_tick();
+    /* the device appears once the machine's NV2A has brought the Vulkan renderer up */
+    if (!ps4_present_ready()) {
+        NV2AVkDevice dev;
+        if (!nv2a_vk_ps4_get_device(&dev) || !ps4_present_init(&dev)) {
+            SDL_Delay(10);
+            return;
+        }
+        trace("presenting on VideoOut");
+        const char *dvd = g_config.sys.files.dvd_path;
+        if (ps4_settings.boot_launcher) {
+            ps4_launcher_open();
+        } else if (dvd == NULL || dvd[0] == '\0' || access(dvd, R_OK) != 0) {
+            ps4_hud_open_games();
+        }
+    }
+
+    /*
+     * The renderer's display image (frames the guest draws without the GPU, through the VGA
+     * framebuffer, are not shown yet) - but only when the guest has flipped since, or a quarter
+     * second has passed (screens drawn without flips). Each request flushes the renderer's
+     * pending work and waits for it if the displayed surface was drawn into: 60 times a second
+     * on the PS4 that cost speed and showed half-drawn frames (flashing, v00.10). In between,
+     * the presenter shows its copy of the last frame.
+     */
+    static unsigned int last_flips;
+    static int64_t last_fetch_ns;
+    const unsigned int flips = g_nv2a_stats.frame_count;
+    const int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    const bool fetch = flips != last_flips || now - last_fetch_ns > 250 * SCALE_MS;
+    bool have_display = false;
+    if (fetch) {
+        have_display = nv2a_get_framebuffer_surface() != 0;
+        last_flips = flips;
+        last_fetch_ns = now;
+    }
+
+    xemu_main_loop_lock();
+    ps4_hud_update();
+    xemu_main_loop_unlock();
+
+    ps4_present_frame(have_display);
+    if (fetch) {
+        nv2a_release_framebuffer_surface();
+    }
+
+    /* The system keeps the controller's input while its boot splash counts as shown (the pad's
+     * reads come back "intercepted"): hide it once there is a picture of ours, and say so.
+     * (ps4-wsi.cc also hides it at the first flip, without checking.) */
+    static int splash_tries;
+    if (splash_tries < 3 && (splash_tries == 0 || ps4_pad_intercepted())) {
+        int r = sceSystemServiceHideSplashScreen();
+        trace("splash screen hidden (%x)%s", (unsigned)r,
+              ps4_pad_intercepted() ? ", pad still intercepted" : "");
+        splash_tries++;
+    }
+}
+
+int main(int argc, char **argv)
+{
+    QemuThread thread;
+
+    load_system_modules();
+    mkdir(XEMU_DATA, 0777);
+    mkdir(XEMU_DATA "/bios", 0777);
+    mkdir(XEMU_DATA "/hdd", 0777);
+    mkdir(XEMU_DATA "/games", 0777);
+    /* no /tmp on the PS4 (glib's temporary files, QEMU's fallbacks) */
+    mkdir(XEMU_DATA "/tmp", 0777);
+    setenv("TMPDIR", XEMU_DATA "/tmp", 1);
+    redirect_output();
+    atexit(trace_exit);
+    setlocale(LC_NUMERIC, "C");
+    ps4_settings_load();
+    ps4_settings_save();    /* every key in the file, for editing by hand */
+
+    /*
+     * Threads: stacks from the kit's heap (direct memory) rather than the shared flexible pool;
+     * new threads on the shared cores, pinned ones move themselves (ps4_thread_started). This
+     * thread presents and polls the pads: a shared core, above the background threads.
+     */
+    ps4_kit_set_thread_stacks_from_heap(1);
+    app_cores = ps4_new_thread_cores ? ps4_new_thread_cores : 0x3f;
+    shared_cores = app_cores & ~0xfull;
+    if (shared_cores == 0 || ps4_settings.cpu_layout == PS4_CPU_FLOATING) {
+        shared_cores = app_cores;
+    }
+    ps4_kit_set_new_thread_cores(shared_cores);
+    ps4x_set_affinity(pthread_self(), shared_cores);
+    if (ps4_settings.cpu_layout == PS4_CPU_PINNED) {
+        ps4x_set_priority(pthread_self(), 620);
+    }
+    /* RADV's shader cache: compiled pipelines kept between runs (ps4-kit Mesa patches 0023-0025) */
+    mkdir(XEMU_DATA "/cache", 0777);
+    setenv("MESA_SHADER_CACHE_DIR", XEMU_DATA "/cache/mesa", 1);
+    profiling = ps4_settings.profiler || access(XEMU_DATA "/profile.txt", F_OK) == 0;
+    tlb_dirty_index_enabled = ps4_settings.tlb_index;
+    ps4_settings_apply_aot();
+    if (profiling) {
+        ps4_sampler_start();
+        ps4_sampler_register_thread("main (display)");
+    }
+
+    trace("xemu-ps4 %s (%s %s) starting", xemu_version, xemu_commit, xemu_date);
+    trace("CPU: %s, OS: %s", xemu_get_cpu_info(), xemu_get_os_info());
+    trace("CPU: %s at %u MHz, OS: %s; cores %#llx, layout %s", xemu_get_cpu_info(), ps4_kit_cpu_mhz(),
+          xemu_get_os_info(), (unsigned long long)app_cores,
+          ps4_settings.cpu_layout == PS4_CPU_PINNED ? "pinned" : "floating");
+    calibrate_main_loop_waits();
+
+    xemu_settings_set_path(XEMU_DATA "/xemu.toml");
+    if (!xemu_settings_load()) {
+        trace("xemu.toml: %s", xemu_settings_get_error_message());
+    }
+    apply_ps4_settings();
+    xemu_settings_save();
+    atexit(xemu_settings_save);
+
+    /* One subsystem at a time: SDL_Init stops at the first that fails. Sound: SDL's PS4 driver
+     * (port/sdl3: sceAudioOut, 48 kHz stereo), its buffer from Settings (ps4.ini audio_frames). */
+    char frames[16];
+    snprintf(frames, sizeof(frames), "%d", ps4_settings.audio_frames);
+    SDL_SetHint(SDL_HINT_AUDIO_DEVICE_SAMPLE_FRAMES, frames);
+    static const struct {
+        SDL_InitFlags flag;
+        const char *name;
+    } subsystems[] = {
+        { SDL_INIT_EVENTS, "events" },
+        { SDL_INIT_GAMEPAD, "gamepad" },
+        { SDL_INIT_AUDIO, "audio" },
+    };
+    for (size_t i = 0; i < ARRAY_SIZE(subsystems); i++) {
+        if (!SDL_InitSubSystem(subsystems[i].flag)) {
+            trace("SDL %s: %s", subsystems[i].name, SDL_GetError());
+        }
+    }
+    trace("SDL audio driver: %s", SDL_GetCurrentAudioDriver() ? SDL_GetCurrentAudioDriver() : "none");
+    ps4_pad_init();
+
+    /* QEMU parses no command line here: the machine comes from xemu.toml (system/vl.c). Extra
+     * QEMU options, one per line, from /data/xemu/qemu-args.txt (e.g. -d in_asm,int -D file). */
+    GPtrArray *args = g_ptr_array_new();
+    g_ptr_array_add(args, (char *)"xemu");
+    g_autofree char *extra = NULL;
+    if (g_file_get_contents(XEMU_DATA "/qemu-args.txt", &extra, NULL, NULL)) {
+        for (char **line = g_strsplit(extra, "\n", -1), **l = line; *l; l++) {
+            g_strstrip(*l);
+            if (**l != '\0' && **l != '#') {
+                trace("extra QEMU argument: %s", *l);
+                g_ptr_array_add(args, *l);
+            }
+        }
+    }
+    if (ps4_settings.boot_launcher) {
+        /* the library first: the Xbox waits stopped until a game is picked (ps4_launch_game) */
+        g_ptr_array_add(args, (char *)"-S");
+    } else {
+        ps4_emulation_started = true;
+    }
+    if (ps4_settings.gdb_port > 0) {
+        g_ptr_array_add(args, (char *)"-gdb");
+        g_ptr_array_add(args, g_strdup_printf("tcp::%d", ps4_settings.gdb_port));
+        trace("GDB stub for the guest CPU on TCP port %d", ps4_settings.gdb_port);
+    }
+    g_ptr_array_add(args, NULL);
+    g_argc = args->len - 1;
+    g_argv = (char **)args->pdata;
+
+    /* QEMU names its threads for the system only when asked (-name debug-threads=on): the kit's
+     * profiler and thread dumps find threads by those names (v00.18's profile sampled nothing) */
+    qemu_thread_naming(true);
+    nv2a_context_init();
+
+    qemu_sem_init(&display_init_sem, 0);
+    qemu_sem_init(&display_shutdown_sem, 0);
+    trace("starting the emulator");
+    qemu_thread_create(&thread, "qemu_main", qemu_main, NULL, QEMU_THREAD_JOINABLE);
+    qemu_sem_wait(&display_init_sem);
+
+    tcg_register_init_ctx();
+    qemu_set_current_aio_context(qemu_get_aio_context());
+
+    xemu_main_loop_lock();
+    xemu_input_init();
+    xemu_main_loop_unlock();
+
+    QemuThread monitor;
+    qemu_thread_create(&monitor, "ps4-monitor", monitor_thread, NULL, QEMU_THREAD_DETACHED);
+    ps4_live_start(ps4_settings.live_port);
+
+    trace("main loop");
+    while (!qatomic_read(&qemu_exiting)) {
+        poll_events();
+        render_frame();
+    }
+    trace("exiting (%d)", exit_status);
+    qemu_sem_post(&display_shutdown_sem);
+    qemu_thread_join(&thread);
+    qemu_thread_join(&vblank_thread);
+    ps4_present_shutdown();
+    SDL_Quit();
+    return exit_status;
+}
+
+bool ps4_load_disc(const char *path)
+{
+    Error *err = NULL;
+    xemu_load_disc(path, &err);
+    if (err) {
+        trace("load disc %s: %s", path, error_get_pretty(err));
+        error_free(err);
+        return false;
+    }
+    trace("disc: %s", path);
+    xemu_settings_save();
+    return true;
+}
+
+void ps4_eject_disc(void)
+{
+    Error *err = NULL;
+    xemu_eject_disc(&err);
+    if (err) {
+        error_free(err);
+    }
+    xemu_settings_save();
+}
+
+/* a game has been started (the library then offers "back to the game") */
+bool ps4_emulation_started;
+
+/*
+ * The library's pick (ps4-launcher.cc), under the main loop lock: the disc in the drive, then the
+ * machine started - from its first stop (-S: the BIOS boots straight into the game) or, when a
+ * game was running, reset with the new disc.
+ */
+bool ps4_launch_game(const char *path)
+{
+    Error *err = NULL;
+    const bool fresh = runstate_check(RUN_STATE_PRELAUNCH);
+    /*
+     * The game's translated code (accel/tcg/aot.c): its .aot loaded and its blocks recorded,
+     * with the Xbox's CPU stopped. The TBs made before (BIOS, another game) are dropped, so
+     * that the game's blocks go through the new file.
+     */
+    const uint32_t title_id = ps4_iso_title_id(path);
+    if (runstate_is_running()) {
+        vm_stop(RUN_STATE_PAUSED);
+    }
+    aot_set_title(title_id);
+    tb_flush__exclusive_or_serial();
+    trace("launch: title ID %08x", title_id);
+    qmp_blockdev_change_medium("ide0-cd1", NULL, path, "raw", false, false, false, 0, &err);
+    if (err) {
+        trace("launch %s: %s", path, error_get_pretty(err));
+        error_free(err);
+        return false;
+    }
+    xemu_settings_set_string(&g_config.sys.files.dvd_path, path);
+    xemu_settings_save();
+    xbox_smc_update_tray_state();
+    if (!fresh) {
+        qemu_system_reset_request(SHUTDOWN_CAUSE_HOST_UI);
+    }
+    if (!runstate_is_running()) {
+        qmp_cont(&err);
+        if (err) {
+            trace("launch: cont: %s", error_get_pretty(err));
+            error_free(err);
+        }
+    }
+    ps4_emulation_started = true;
+    trace("launch: %s (%s)", path, fresh ? "first start" : "reset with the new disc");
+    return true;
+}
+
+void ps4_pause_emulation(bool pause)
+{
+    if (pause && runstate_is_running()) {
+        vm_stop(RUN_STATE_PAUSED);
+    } else if (!pause && runstate_check(RUN_STATE_PAUSED)) {
+        vm_start();
+    }
+}
+
+void ps4_request_reset(void)
+{
+    qemu_system_reset_request(SHUTDOWN_CAUSE_HOST_UI);
+}
+
+void ps4_request_quit(void)
+{
+    qemu_system_shutdown_request(SHUTDOWN_CAUSE_HOST_UI);
+}
+
+void xemu_eject_disc(Error **errp)
+{
+    Error *error = NULL;
+
+    xbox_smc_eject_button();
+    xemu_settings_set_string(&g_config.sys.files.dvd_path, "");
+
+    /* Xbox software may request that the drive open, but do it now anyway */
+    qmp_eject("ide0-cd1", NULL, true, false, &error);
+    if (error) {
+        error_propagate(errp, error);
+    }
+
+    xbox_smc_update_tray_state();
+}
+
+void xemu_load_disc(const char *path, Error **errp)
+{
+    Error *error = NULL;
+
+    /* Ensure an eject sequence is always triggered so Xbox software reloads */
+    xbox_smc_eject_button();
+    xemu_settings_set_string(&g_config.sys.files.dvd_path, "");
+
+    qmp_blockdev_change_medium("ide0-cd1", NULL, path, "raw", false, false,
+                               false, 0, &error);
+    if (error) {
+        error_propagate(errp, error);
+    } else {
+        xemu_settings_set_string(&g_config.sys.files.dvd_path, path);
+    }
+
+    xbox_smc_update_tray_state();
+}
