diff --git a/ui/ps4/xemu-ps4.c b/ui/ps4/xemu-ps4.c
new file mode 100644
index 0000000..d4e08ee
--- /dev/null
+++ b/ui/ps4/xemu-ps4.c
@@ -0,0 +1,1176 @@
+/*
+ * xemu-ps4: the PS4 frontend (replaces ui/xemu.c and its SDL window + OpenGL).
+ *
+ *   /app0                     packaged files (eboot.bin, data/: fonts and pictures)
+ *   /data/xemu                xemu.toml, eeprom.bin, logs (boot-trace.log, crash.log, xemu.log)
+ *   /data/xemu/bios           the MCPX boot ROM (512 bytes) and the flash BIOS (256 KiB or 1 MiB)
+ *   /data/xemu/hdd            the hard disk image (xbox_hdd.qcow2)
+ *   /data/xemu/games          games (.iso, XISO)
+ *
+ * The emulator runs on its own thread as on the desktop; this thread presents the Vulkan
+ * renderer's display image on VideoOut (ps4-present.cc) with the HUD and menus drawn by ImGui
+ * (ps4-hud.cc), and polls the pads through SDL (xemu-input.c).
+ *
+ * Copyright (c) 2020-2025 Matt Borgerson (ui/xemu.c, which this follows)
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qemu/thread.h"
+#include "qemu/main-loop.h"
+#include "qemu/rcu.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-block.h"
+#include "qapi/qapi-commands-misc.h"
+#include "ui/console.h"
+#include "system/runstate.h"
+#include "system/system.h"
+#include "ui/xemu-input.h"
+#include "ui/xemu-settings.h"
+#include "xemu-version.h"
+#include "ui/xemu-os-utils.h"
+#include "ui/xemu-notifications.h"
+#include "hw/xbox/smbus.h"
+#include "hw/xbox/nv2a/nv2a.h"
+#include "hw/xbox/nv2a/nv2a_vk_ps4.h"
+#include "hw/xbox/nv2a/debug.h"
+#include "hw/core/cpu.h"
+#include "system/cpus.h"
+#include "exec/aot.h"
+#include "exec/tb-flush.h"
+#include "qemu/timer.h"
+#include "ps4-frontend.h"
+#include "ps4-settings.h"
+#include "ps4_kit.h"
+#include "ps4_kit_diag.h"
+
+#include <SDL3/SDL.h>
+#include <dirent.h>
+#include <locale.h>
+#include <orbis/Sysmodule.h>
+#include <orbis/libkernel.h>
+#include <orbis/SystemService.h>
+#include <pthread.h>
+#include <sys/select.h>
+
+/* (ps4_boot_trace: ps4-kit's crash log, ps4_kit_diag.h) */
+void tcg_register_init_ctx(void);       /* tcg.c */
+
+#define XEMU_DATA "/data/xemu"
+
+/* util/qemu-timer.c: the main loop's waits (ps4_poll_ns) */
+extern int64_t ps4_poll_spin_ns, ps4_poll_short_ns;
+extern void (*ps4_poll_short_sleep)(int64_t ns);
+extern uint64_t ps4_poll_waits, ps4_poll_sleeps, ps4_poll_spin_total_ns;
+int sceKernelUsleep(unsigned int usec);
+/* accel/tcg/cputlb.c: the TLB dirty index (set before the machine starts) and its counts */
+extern bool tlb_dirty_index_enabled;
+extern uint64_t tlb_dirty_index_resets, tlb_dirty_index_walks;
+/* below: the desktop's ui/xemu.c has these */
+void xemu_eject_disc(Error **errp);
+void xemu_load_disc(const char *path, Error **errp);
+
+/* ps4-kit: this app's folder for crash.log, boot-trace.log and the profilers' files */
+PS4_DIAG_DATA_DIR(XEMU_DATA);
+
+/*
+ * ps4-kit's heap (before main: fields only): its log lines and mappings named "xemu". Its part in
+ * the system flexible pool is 64 MiB instead of 256: the heap overflowed into direct memory 0.3 s
+ * after start anyway, and the pool is where executable memory comes from - the JIT's 64 MiB and a
+ * game's translated code (accel/tcg/aot.c, 150+ MiB; the kernel refuses executable direct memory).
+ * The pool's kernel objects and Sony's modules keep more room than before (64 + 64 + 158 MiB vs
+ * 256 + 64).
+ */
+void ps4_kit_configure_heap(ps4_kit_heap_options *o)
+{
