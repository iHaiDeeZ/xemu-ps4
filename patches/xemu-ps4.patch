+#define AOT_MAGIC 0x31544f41554d4558ull   /* "XEMUAOT1" */
+#define AOT_VERSION 1
+
+bool aot_use = true;
+bool aot_record = true;
+bool aot_direct = true;
+bool aot_recording;
+bool aot_loaded;
+
+static const AotTarget *target;
