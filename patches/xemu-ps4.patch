diff --git a/hw/xbox/nv2a/pgraph/vk/ps4.c b/hw/xbox/nv2a/pgraph/vk/ps4.c
new file mode 100644
index 0000000000..f96821fbe1
--- /dev/null
+++ b/hw/xbox/nv2a/pgraph/vk/ps4.c
@@ -0,0 +1,82 @@
+/*
+ * xemu-ps4: the Vulkan renderer's device, display image and queue for the PS4 frontend
+ * (hw/xbox/nv2a/nv2a_vk_ps4.h).
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/thread.h"
+#include "hw/xbox/nv2a/nv2a_int.h"
+#include "hw/xbox/nv2a/nv2a_vk_ps4.h"
+#include "renderer.h"
+
+static QemuMutex queue_mutex;
+
+static void __attribute__((constructor)) init_queue_mutex(void)
+{
+    qemu_mutex_init(&queue_mutex);
+}
+
+void pgraph_vk_queue_lock(void)
+{
+    qemu_mutex_lock(&queue_mutex);
+}
+
+void pgraph_vk_queue_unlock(void)
+{
+    qemu_mutex_unlock(&queue_mutex);
+}
+
+void nv2a_vk_ps4_queue_lock(void)
+{
+    pgraph_vk_queue_lock();
+}
+
+void nv2a_vk_ps4_queue_unlock(void)
+{
+    pgraph_vk_queue_unlock();
+}
+
+static PGRAPHVkState *vk_state(void)
+{
+    if (g_nv2a == NULL ||
+        g_nv2a->pgraph.renderer == NULL ||
+        g_nv2a->pgraph.renderer->type != CONFIG_DISPLAY_RENDERER_VULKAN) {
+        return NULL;
+    }
+    return qatomic_read(&g_nv2a->pgraph.vk_renderer_state);
+}
+
+bool nv2a_vk_ps4_get_device(NV2AVkDevice *out)
+{
+    PGRAPHVkState *r = vk_state();
+    if (r == NULL || r->device == VK_NULL_HANDLE || r->queue == VK_NULL_HANDLE) {
+        return false;
+    }
+    out->instance = r->instance;
+    out->physical_device = r->physical_device;
+    out->device = r->device;
+    out->queue = r->queue;
+    out->queue_family = pgraph_vk_find_queue_families(r->physical_device).queue_family;
+    out->api_version = r->vk_api_version;
+    out->get_instance_proc_addr = ps4_vk_get_instance_proc_addr();
+    return true;
+}
+
+bool nv2a_vk_ps4_get_display(VkImage *image, VkImageView *view, uint32_t *width,
+                             uint32_t *height)
+{
+    PGRAPHVkState *r = vk_state();
+    if (r == NULL || r->display.image == VK_NULL_HANDLE) {
+        return false;
+    }
+    *image = r->display.image;
+    *view = r->display.image_view;
+    *width = r->display.width;
+    *height = r->display.height;
+    return true;
+}
