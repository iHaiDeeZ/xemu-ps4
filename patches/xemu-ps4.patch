+static void aot_emit_qemu_ldst(AotEmit *e, TCGOp *op)
+{
+    TCGOpcode c = op->opc;
+    bool is_ld = c == INDEX_op_qemu_ld || c == INDEX_op_qemu_ld2;
+    bool pair = c == INDEX_op_qemu_ld2 || c == INDEX_op_qemu_st2;
+    int nout = is_ld ? (pair ? 2 : 1) : 0;
+    int nin = is_ld ? 1 : (pair ? 3 : 2);
+    MemOpIdx oi = op->args[nout + nin];
+    MemOp mop = get_memop(oi);
+    unsigned mmu = get_mmuidx(oi);
+    MemOp size = mop & MO_SIZE;
+    TCGAtomAlign aa;
+    unsigned a_mask, s_mask;
+    uint32_t cmp_mask, adj;
+    int fast_ofs;
+    const char *addr = aot_t(e, op->args[is_ld ? nout : nin - 1]);
+
+    if (mop & MO_BSWAP) {
+        aot_failf(e, "big-endian access");
+        return;
+    }
+    if (e->s->addr_type != TCG_TYPE_I32) {
+        aot_failf(e, "64-bit guest addresses");
+        return;
+    }
+    aa = atom_and_align_for_opc(e->s, mop, MO_ATOM_IFALIGN, size == MO_128);
+    a_mask = (1u << aa.align) - 1;
+    s_mask = (1u << size) - 1;
+    cmp_mask = (uint32_t)TARGET_PAGE_MASK | a_mask;
+    adj = a_mask >= s_mask ? 0 : s_mask - a_mask;
+    fast_ofs = tlb_mask_table_ofs(e->s, mmu);
+
+    /* the slow path makes env current (MMIO, a fault's longjmp) and names the insn */
+    if (is_ld) {
+        TCGType t = arg_temp(op->args[0])->type;
+        if (pair) {
+            g_string_append_printf(e->o, " AOT_LD128(%s, %s, %s, %d, %uu, 0x%xu, %u, 0x%" PRIx64
+                                   "u, %d);", aot_t(e, op->args[0]), aot_t(e, op->args[1]), addr,
+                                   fast_ofs, adj, cmp_mask, (unsigned)oi, e->cur_pc, e->cur_cc);
+        } else {
+            static const char *ext[] = { "uint8_t", "uint16_t", "uint32_t", "uint64_t" };
+            static const char *sext[] = { "int8_t", "int16_t", "int32_t", "int64_t" };
+            g_string_append_printf(e->o, " AOT_LD(%s, %s, %s, %d, %s, %d, %uu, 0x%xu, %u, 0x%"
+                                   PRIx64 "u, %d);", aot_t(e, op->args[0]), aot_ctype(t), addr,
+                                   1 << size, (mop & MO_SIGN) ? sext[size] : ext[size], fast_ofs,
+                                   adj, cmp_mask, (unsigned)oi, e->cur_pc, e->cur_cc);
+        }
+    } else {
+        if (pair) {
+            g_string_append_printf(e->o, " AOT_ST128(%s, %s, %s, %d, %uu, 0x%xu, %u, 0x%" PRIx64
+                                   "u, %d);", aot_t(e, op->args[0]), aot_t(e, op->args[1]), addr,
+                                   fast_ofs, adj, cmp_mask, (unsigned)oi, e->cur_pc, e->cur_cc);
+        } else {
+            static const char *st[] = { "uint8_t", "uint16_t", "uint32_t", "uint64_t" };
+            g_string_append_printf(e->o, " AOT_ST(%s, %s, %d, %s, %d, %uu, 0x%xu, %u, 0x%" PRIx64
+                                   "u, %d);", aot_t(e, op->args[0]), addr, 1 << size, st[size],
+                                   fast_ofs, adj, cmp_mask, (unsigned)oi, e->cur_pc, e->cur_cc);
+        }
+    }
+}
