diff --git a/hw/xbox/nv2a/nv2a_vk_ps4.h b/hw/xbox/nv2a/nv2a_vk_ps4.h
new file mode 100644
index 0000000000..8531287d1e
--- /dev/null
+++ b/hw/xbox/nv2a/nv2a_vk_ps4.h
@@ -0,0 +1,50 @@
+/*
+ * xemu-ps4: what the PS4 frontend (ui/ps4) needs from the Vulkan renderer to present on the
+ * renderer's own device: there is no OpenGL on the PS4 to hand the picture to.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2 of the License, or (at your option) any later version.
+ */
+
+#ifndef HW_XBOX_NV2A_NV2A_VK_PS4_H
+#define HW_XBOX_NV2A_NV2A_VK_PS4_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <vulkan/vulkan.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct NV2AVkDevice {
+    VkInstance instance;
+    VkPhysicalDevice physical_device;
+    VkDevice device;
+    VkQueue queue;
+    uint32_t queue_family;
+    uint32_t api_version;
+    PFN_vkGetInstanceProcAddr get_instance_proc_addr;
+} NV2AVkDevice;
+
+/* The renderer's device, once the Vulkan renderer is up (false before). */
+bool nv2a_vk_ps4_get_device(NV2AVkDevice *out);
+
+/*
+ * The emulated display, rendered and idle in SHADER_READ_ONLY_OPTIMAL layout. Valid between
+ * nv2a_get_framebuffer_surface() returning nonzero and nv2a_release_framebuffer_surface().
+ */
+bool nv2a_vk_ps4_get_display(VkImage *image, VkImageView *view, uint32_t *width,
+                             uint32_t *height);
+
+/* The renderer's queue is shared: every vkQueueSubmit/vkQueuePresentKHR holds this lock. */
+void nv2a_vk_ps4_queue_lock(void);
+void nv2a_vk_ps4_queue_unlock(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
