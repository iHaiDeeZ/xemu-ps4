diff --git a/ui/ps4/ps4-wsi.cc b/ui/ps4/ps4-wsi.cc
new file mode 100644
index 0000000000..906f52885d
--- /dev/null
+++ b/ui/ps4/ps4-wsi.cc
@@ -0,0 +1,551 @@
+/*
+	xemu-ps4: Vulkan window system integration on the PS4 (from Resonance's ps4_wsi.cpp, itself
+	from Crema's PS4WSI.cpp).
+
+	RADV (DolphinPS4's GNM port) is linked into the executable and has no WSI. This file adds
+	VK_EXT_headless_surface and VK_KHR_swapchain on top of it the way DolphinPS4 presents: the
+	swapchain images are linear R8G8B8A8 images in host-visible memory (GPU address = CPU address
+	on the PS4), registered as VideoOut buffers, and presenting queues a VideoOut flip behind the
+	GPU work submitted so far (ac_ps4_submit_flip in the Mesa winsys). xemu's Vulkan renderer
+	(through volk) and the PS4 presenter (ps4-present.cc) use the standard surface/swapchain API
+	through ps4_vk_get_instance_proc_addr(). vkAcquireNextImageKHR and vkQueuePresentKHR submit
+	to the graphics queue: callers hold nv2a_vk_ps4_queue_lock().
+
+	This program is free software: you can redistribute it and/or modify
+	it under the terms of the GNU General Public License as published by
+	the Free Software Foundation, either version 2 of the License, or
+	(at your option) any later version.
+ */
+#include "ps4-wsi.h"
+
+#include <vulkan/vulkan.h>
+#include <orbis/VideoOut.h>
+#include <orbis/libkernel.h>
+#include <orbis/SystemService.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+#include <mutex>
+#include <vector>
+
+extern "C" VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL vk_icdGetInstanceProcAddr(VkInstance instance, const char *name);
+extern "C" VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL vk_common_GetDeviceProcAddr(VkDevice device, const char *name);
+// port/mesa/ac_ps4_drm.c: queues a VideoOut flip behind the submitted GPU work (GPU-side flip)
+extern "C" int ac_ps4_submit_flip(int video, unsigned buffer, unsigned mode, int64_t arg);
+
+namespace
+{
+constexpr u32 kMaxImages = 4;
+constexpr VkDeviceSize kFramebufferAlign = 2 << 20;	// VideoOut buffer alignment
+
+struct PS4Surface
+{
+	u32 magic = 0x50533453;
+};
+
+struct PS4Swapchain
+{
+	VkDevice device;
+	u32 imageCount;
+	VkImage images[kMaxImages] {};
+	VkDeviceMemory memory[kMaxImages] {};
+	int bufferSet = -1;
+	int firstBuffer = 0;
+	u32 nextImage = 0;
+	u32 flipMode = ORBIS_VIDEO_OUT_FLIP_VSYNC;
+};
+
+VkInstance sInstance = VK_NULL_HANDLE;
+VkPhysicalDevice sPhysicalDevice = VK_NULL_HANDLE;
+int sVideo = -1;
+OrbisKernelEqueue sFlipQueue;
+u64 sFlipsSubmitted = 0;
+int sNextFirstBuffer = 0;
+std::mutex sMutex;
+
+template<typename T>
+T Device(VkDevice device, const char *name) {
+	return (T)vk_common_GetDeviceProcAddr(device, name);
+}
+
+template<typename T>
+T Instance(const char *name) {
+	return (T)vk_icdGetInstanceProcAddr(sInstance, name);
+}
+
+bool OpenVideoOut()
+{
+	if (sVideo >= 0)
+		return true;
+	sVideo = sceVideoOutOpen(0xFF, 0, 0, nullptr);
+	if (sVideo < 0)
+	{
+		ERROR_LOG(RENDERER, "PS4WSI: sceVideoOutOpen failed: %x", sVideo);
+		return false;
+	}
+	sceKernelCreateEqueue(&sFlipQueue, "xemu flip");
+	sceVideoOutAddFlipEvent(sFlipQueue, sVideo, nullptr);
+	return true;
+}
+
+// appends one extension to an enumeration result (count/properties two-call idiom)
+VkResult AppendExtensions(std::vector<VkExtensionProperties>& list, std::initializer_list<std::pair<const char *, u32>> extra,
+		u32 *count, VkExtensionProperties *props)
+{
+	for (const auto& [name, specVersion] : extra)
+	{
+		VkExtensionProperties p {};
+		strncpy(p.extensionName, name, VK_MAX_EXTENSION_NAME_SIZE - 1);
+		p.specVersion = specVersion;
+		list.push_back(p);
+	}
+	if (props == nullptr)
+	{
+		*count = (u32)list.size();
+		return VK_SUCCESS;
+	}
+	const u32 n = std::min<u32>(*count, (u32)list.size());
+	memcpy(props, list.data(), n * sizeof(VkExtensionProperties));
+	*count = n;
+	return n < list.size() ? VK_INCOMPLETE : VK_SUCCESS;
+}
+
+std::vector<const char *> WithoutExtensions(u32 count, const char *const *names, std::initializer_list<const char *> drop)
+{
+	std::vector<const char *> result;
+	for (u32 i = 0; i < count; i++)
+		if (std::none_of(drop.begin(), drop.end(), [&](const char *d) { return strcmp(names[i], d) == 0; }))
+			result.push_back(names[i]);
+	return result;
+}
+
+// --- instance level ---
+
+VKAPI_ATTR VkResult VKAPI_CALL EnumerateInstanceExtensionProperties(const char *layer, u32 *count, VkExtensionProperties *props)
+{
+	auto real = (PFN_vkEnumerateInstanceExtensionProperties)vk_icdGetInstanceProcAddr(VK_NULL_HANDLE, "vkEnumerateInstanceExtensionProperties");
+	u32 n = 0;
+	real(layer, &n, nullptr);
+	std::vector<VkExtensionProperties> list(n);
+	real(layer, &n, list.data());
+	list.resize(n);
+	return AppendExtensions(list, { { VK_KHR_SURFACE_EXTENSION_NAME, 25 }, { VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME, 1 } }, count, props);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL CreateInstance(const VkInstanceCreateInfo *info, const VkAllocationCallbacks *alloc, VkInstance *instance)
+{
+	auto real = (PFN_vkCreateInstance)vk_icdGetInstanceProcAddr(VK_NULL_HANDLE, "vkCreateInstance");
+	VkInstanceCreateInfo copy = *info;
+	auto names = WithoutExtensions(info->enabledExtensionCount, info->ppEnabledExtensionNames,
+			{ VK_KHR_SURFACE_EXTENSION_NAME, VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME });
+	copy.enabledExtensionCount = (u32)names.size();
+	copy.ppEnabledExtensionNames = names.data();
+	VkResult r = real(&copy, alloc, instance);
+	if (r == VK_SUCCESS)
+		sInstance = *instance;
+	return r;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL EnumerateDeviceExtensionProperties(VkPhysicalDevice physicalDevice, const char *layer, u32 *count, VkExtensionProperties *props)
+{
+	auto real = Instance<PFN_vkEnumerateDeviceExtensionProperties>("vkEnumerateDeviceExtensionProperties");
+	u32 n = 0;
+	real(physicalDevice, layer, &n, nullptr);
+	std::vector<VkExtensionProperties> list(n);
+	real(physicalDevice, layer, &n, list.data());
+	list.resize(n);
+	return AppendExtensions(list, { { VK_KHR_SWAPCHAIN_EXTENSION_NAME, 70 } }, count, props);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL CreateDevice(VkPhysicalDevice physicalDevice, const VkDeviceCreateInfo *info, const VkAllocationCallbacks *alloc, VkDevice *device)
+{
+	auto real = Instance<PFN_vkCreateDevice>("vkCreateDevice");
+	VkDeviceCreateInfo copy = *info;
+	auto names = WithoutExtensions(info->enabledExtensionCount, info->ppEnabledExtensionNames, { VK_KHR_SWAPCHAIN_EXTENSION_NAME });
+	copy.enabledExtensionCount = (u32)names.size();
+	copy.ppEnabledExtensionNames = names.data();
+	sPhysicalDevice = physicalDevice;
+	return real(physicalDevice, &copy, alloc, device);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL CreateHeadlessSurfaceEXT(VkInstance, const VkHeadlessSurfaceCreateInfoEXT *, const VkAllocationCallbacks *, VkSurfaceKHR *surface)
+{
+	*surface = (VkSurfaceKHR)new PS4Surface();
+	return VK_SUCCESS;
+}
+
+VKAPI_ATTR void VKAPI_CALL DestroySurfaceKHR(VkInstance, VkSurfaceKHR surface, const VkAllocationCallbacks *)
+{
+	delete (PS4Surface *)surface;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL GetPhysicalDeviceSurfaceSupportKHR(VkPhysicalDevice, u32 queueFamily, VkSurfaceKHR, VkBool32 *supported)
+{
+	*supported = queueFamily == 0 ? VK_TRUE : VK_FALSE;	// the graphics queue family
+	return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL GetPhysicalDeviceSurfaceCapabilitiesKHR(VkPhysicalDevice, VkSurfaceKHR, VkSurfaceCapabilitiesKHR *caps)
+{
+	*caps = {};
+	caps->minImageCount = 2;
+	caps->maxImageCount = 3;	// as DolphinPS4: render into one while one is shown and one is queued
+	caps->currentExtent = { ps4wsi::kWidth, ps4wsi::kHeight };
+	caps->minImageExtent = caps->currentExtent;
+	caps->maxImageExtent = caps->currentExtent;
+	caps->maxImageArrayLayers = 1;
+	caps->supportedTransforms = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+	caps->currentTransform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+	caps->supportedCompositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+	caps->supportedUsageFlags = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+	return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL GetPhysicalDeviceSurfaceFormatsKHR(VkPhysicalDevice, VkSurfaceKHR, u32 *count, VkSurfaceFormatKHR *formats)
+{
+	// VideoOut A8B8G8R8 = R8G8B8A8 in memory (verified by DolphinPS4)
+	if (formats == nullptr)
+	{
+		*count = 1;
+		return VK_SUCCESS;
+	}
+	if (*count < 1)
+		return VK_INCOMPLETE;
+	formats[0] = { VK_FORMAT_R8G8B8A8_UNORM, VK_COLOR_SPACE_SRGB_NONLINEAR_KHR };
+	*count = 1;
+	return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL GetPhysicalDeviceSurfacePresentModesKHR(VkPhysicalDevice, VkSurfaceKHR, u32 *count, VkPresentModeKHR *modes)
+{
+	const VkPresentModeKHR supported[] = { VK_PRESENT_MODE_FIFO_KHR, VK_PRESENT_MODE_IMMEDIATE_KHR, VK_PRESENT_MODE_MAILBOX_KHR };
+	if (modes == nullptr)
+	{
+		*count = std::size(supported);
+		return VK_SUCCESS;
+	}
+	const u32 n = std::min<u32>(*count, std::size(supported));
+	memcpy(modes, supported, n * sizeof(VkPresentModeKHR));
+	*count = n;
+	return n < std::size(supported) ? VK_INCOMPLETE : VK_SUCCESS;
+}
+
+// --- device level ---
+
+u32 HostVisibleMemoryType(u32 typeBits)
+{
+	VkPhysicalDeviceMemoryProperties props;
+	Instance<PFN_vkGetPhysicalDeviceMemoryProperties>("vkGetPhysicalDeviceMemoryProperties")(sPhysicalDevice, &props);
+	const VkMemoryPropertyFlags want = VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT | VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+	for (u32 i = 0; i < props.memoryTypeCount; i++)
+		if ((typeBits & (1u << i)) && (props.memoryTypes[i].propertyFlags & want) == want)
+			return i;
+	return UINT32_MAX;
+}
+
+void FreeSwapchain(PS4Swapchain *sc)
+{
+	if (sc->bufferSet >= 0)
+		sceVideoOutUnregisterBuffers(sVideo, sc->bufferSet);
+	auto destroyImage = Device<PFN_vkDestroyImage>(sc->device, "vkDestroyImage");
+	auto freeMemory = Device<PFN_vkFreeMemory>(sc->device, "vkFreeMemory");
+	for (u32 i = 0; i < sc->imageCount; i++)
+	{
+		if (sc->images[i])
+			destroyImage(sc->device, sc->images[i], nullptr);
+		if (sc->memory[i])
+			freeMemory(sc->device, sc->memory[i], nullptr);
+	}
+	delete sc;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL CreateSwapchainKHR(VkDevice device, const VkSwapchainCreateInfoKHR *info, const VkAllocationCallbacks *, VkSwapchainKHR *swapchain)
+{
+	std::lock_guard<std::mutex> _(sMutex);
+	if (!OpenVideoOut())
+		return VK_ERROR_INITIALIZATION_FAILED;
+	auto sc = new PS4Swapchain();
+	sc->device = device;
+	sc->imageCount = std::clamp<u32>(info->minImageCount, 2, kMaxImages);
+	sc->flipMode = info->presentMode == VK_PRESENT_MODE_FIFO_KHR ? ORBIS_VIDEO_OUT_FLIP_VSYNC : ORBIS_VIDEO_OUT_FLIP_HSYNC;
+	auto createImage = Device<PFN_vkCreateImage>(device, "vkCreateImage");
+	auto getRequirements = Device<PFN_vkGetImageMemoryRequirements>(device, "vkGetImageMemoryRequirements");
+	auto allocateMemory = Device<PFN_vkAllocateMemory>(device, "vkAllocateMemory");
+	auto mapMemory = Device<PFN_vkMapMemory>(device, "vkMapMemory");
+	auto bindMemory = Device<PFN_vkBindImageMemory>(device, "vkBindImageMemory");
+	auto getLayout = Device<PFN_vkGetImageSubresourceLayout>(device, "vkGetImageSubresourceLayout");
+	void *addresses[kMaxImages] {};
+	u32 pitch = ps4wsi::kWidth;
+	for (u32 i = 0; i < sc->imageCount; i++)
+	{
+		VkImageCreateInfo ici { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+		ici.imageType = VK_IMAGE_TYPE_2D;
+		ici.format = VK_FORMAT_R8G8B8A8_UNORM;
+		ici.extent = { ps4wsi::kWidth, ps4wsi::kHeight, 1 };
+		ici.mipLevels = 1;
+		ici.arrayLayers = 1;
+		ici.samples = VK_SAMPLE_COUNT_1_BIT;
+		ici.tiling = VK_IMAGE_TILING_LINEAR;
+		ici.usage = info->imageUsage | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+		ici.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+		VkResult r = createImage(device, &ici, nullptr, &sc->images[i]);
+		if (r != VK_SUCCESS)
+		{
+			ERROR_LOG(RENDERER, "PS4WSI: vkCreateImage failed: %d", r);
+			FreeSwapchain(sc);
+			return r;
+		}
+		VkMemoryRequirements req;
+		getRequirements(device, sc->images[i], &req);
+		// VideoOut wants 2 MiB aligned buffers: over-allocate, bind at an aligned offset
+		VkMemoryAllocateInfo mai { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+		mai.allocationSize = req.size + kFramebufferAlign;
+		mai.memoryTypeIndex = HostVisibleMemoryType(req.memoryTypeBits);
+		u8 *base = nullptr;
+		r = allocateMemory(device, &mai, nullptr, &sc->memory[i]);
+		if (r == VK_SUCCESS)
+			r = mapMemory(device, sc->memory[i], 0, VK_WHOLE_SIZE, 0, (void **)&base);
+		if (r != VK_SUCCESS)
+		{
+			ERROR_LOG(RENDERER, "PS4WSI: swapchain memory failed: %d", r);
+			FreeSwapchain(sc);
+			return r;
+		}
+		const uintptr_t baseAddress = (uintptr_t)base;
+		VkDeviceSize offset = ((baseAddress + kFramebufferAlign - 1) & ~(kFramebufferAlign - 1)) - baseAddress;
+		offset = (offset + req.alignment - 1) & ~(req.alignment - 1);
+		bindMemory(device, sc->images[i], sc->memory[i], offset);
+		VkImageSubresource sub { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0 };
+		VkSubresourceLayout layout;
+		getLayout(device, sc->images[i], &sub, &layout);
+		addresses[i] = base + offset + layout.offset;
+		pitch = (u32)(layout.rowPitch / 4);
+	}
+	OrbisVideoOutBufferAttribute attribute;
+	sceVideoOutSetBufferAttribute(&attribute, ORBIS_VIDEO_OUT_PIXEL_FORMAT_A8B8G8R8_SRGB, ORBIS_VIDEO_OUT_TILING_MODE_LINEAR, 0,
+			ps4wsi::kWidth, ps4wsi::kHeight, pitch);
+	// alternate between two buffer index ranges so a new swapchain can register while the old one is still on screen
+	sc->firstBuffer = sNextFirstBuffer;
+	sNextFirstBuffer = sNextFirstBuffer == 0 ? 8 : 0;
+	sc->bufferSet = sceVideoOutRegisterBuffers(sVideo, sc->firstBuffer, addresses, (int)sc->imageCount, &attribute);
+	if (sc->bufferSet < 0)
+	{
+		ERROR_LOG(RENDERER, "PS4WSI: sceVideoOutRegisterBuffers failed: %x", sc->bufferSet);
+		FreeSwapchain(sc);
+		return VK_ERROR_INITIALIZATION_FAILED;
+	}
+	NOTICE_LOG(RENDERER, "PS4WSI: swapchain of %u images %ux%u pitch %u, buffers %d+", sc->imageCount, ps4wsi::kWidth, ps4wsi::kHeight,
+			pitch, sc->firstBuffer);
+	*swapchain = (VkSwapchainKHR)sc;
+	return VK_SUCCESS;
+}
+
+VKAPI_ATTR void VKAPI_CALL DestroySwapchainKHR(VkDevice device, VkSwapchainKHR swapchain, const VkAllocationCallbacks *)
+{
+	if (!swapchain)
+		return;
+	std::lock_guard<std::mutex> _(sMutex);
+	Device<PFN_vkDeviceWaitIdle>(device, "vkDeviceWaitIdle")(device);
+	FreeSwapchain((PS4Swapchain *)swapchain);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL GetSwapchainImagesKHR(VkDevice, VkSwapchainKHR swapchain, u32 *count, VkImage *images)
+{
+	auto sc = (PS4Swapchain *)swapchain;
+	if (images == nullptr)
+	{
+		*count = sc->imageCount;
+		return VK_SUCCESS;
+	}
+	const u32 n = std::min(*count, sc->imageCount);
+	memcpy(images, sc->images, n * sizeof(VkImage));
+	*count = n;
+	return n < sc->imageCount ? VK_INCOMPLETE : VK_SUCCESS;
+}
+
+// present statistics, logged every 10 s
+struct
+{
+	std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+	u64 flips = 0;
+	u64 waitNs = 0;
+	u32 timeouts = 0;
+	s64 lastFlipArg = 0;
+} sStats;
+
+// The image about to be rendered into must be off screen: with N images in rotation it was
+// shown by flip n-N+1 and replaced on screen by flip n-N+2 (n = flips submitted).
+void WaitImageOffScreen(u32 imageCount)
+{
+	if (sFlipsSubmitted < imageCount - 1)
+		return;
+	const s64 needed = (s64)(sFlipsSubmitted - (imageCount - 2));
+	const auto t0 = std::chrono::steady_clock::now();
+	bool done = false;
+	for (int tries = 0; tries < 40 && !done; tries++)
+	{
+		OrbisVideoOutFlipStatus status {};
+		if (sceVideoOutGetFlipStatus(sVideo, &status) < 0)
+			break;
+		sStats.lastFlipArg = status.flipArg;
+		if (status.flipArg >= needed)
+		{
+			done = true;
+			break;
+		}
+		OrbisKernelEvent ev;
+		int got = 0;
+		OrbisKernelUseconds timeout = 5000;
+		sceKernelWaitEqueue(sFlipQueue, &ev, 1, &got, &timeout);
+	}
+	if (!done)
+		sStats.timeouts++;
+	sStats.waitNs += std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count();
+}
+
+void CountPresent()
+{
+	sStats.flips++;
+	const auto now = std::chrono::steady_clock::now();
+	const double secs = std::chrono::duration<double>(now - sStats.start).count();
+	if (secs < 10.0)
+		return;
+	INFO_LOG(RENDERER, "PS4WSI: %.1f flips/s, acquire waits %.0f ms/s, %u timeouts, flipArg %lld of %llu submitted",
+			sStats.flips / secs, sStats.waitNs / 1e6 / secs, sStats.timeouts, (long long)sStats.lastFlipArg,
+			(unsigned long long)sFlipsSubmitted);
+	sStats.start = now;
+	sStats.flips = 0;
+	sStats.waitNs = 0;
+	sStats.timeouts = 0;
+}
+
+VkQueue GraphicsQueue(VkDevice device)
+{
+	VkQueue queue = VK_NULL_HANDLE;
+	Device<PFN_vkGetDeviceQueue>(device, "vkGetDeviceQueue")(device, 0, 0, &queue);
+	return queue;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL AcquireNextImageKHR(VkDevice device, VkSwapchainKHR swapchain, u64, VkSemaphore semaphore, VkFence fence, u32 *index)
+{
+	auto sc = (PS4Swapchain *)swapchain;
+	WaitImageOffScreen(sc->imageCount);
+	*index = sc->nextImage;
+	sc->nextImage = (sc->nextImage + 1) % sc->imageCount;
+	if (semaphore || fence)
+	{
+		// signal the acquire semaphore/fence right away: the image is free
+		VkSubmitInfo si { VK_STRUCTURE_TYPE_SUBMIT_INFO };
+		si.signalSemaphoreCount = semaphore ? 1 : 0;
+		si.pSignalSemaphores = &semaphore;
+		const VkResult r = Device<PFN_vkQueueSubmit>(device, "vkQueueSubmit")(GraphicsQueue(device), 1, &si, fence);
+		if (r != VK_SUCCESS)
+			ERROR_LOG(RENDERER, "PS4WSI: acquire signal submit failed: %d", r);
+		return r;
+	}
+	return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL QueuePresentKHR(VkQueue queue, const VkPresentInfoKHR *info)
+{
+	VkResult result = VK_SUCCESS;
+	for (u32 i = 0; i < info->swapchainCount; i++)
+	{
+		auto sc = (PS4Swapchain *)info->pSwapchains[i];
+		auto queueSubmit = Device<PFN_vkQueueSubmit>(sc->device, "vkQueueSubmit");
+		// consume the wait semaphores (one queue, in order: the rendering was submitted before)
+		std::vector<VkPipelineStageFlags> stages(info->waitSemaphoreCount, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT);
+		VkSubmitInfo si { VK_STRUCTURE_TYPE_SUBMIT_INFO };
+		si.waitSemaphoreCount = i == 0 ? info->waitSemaphoreCount : 0;
+		si.pWaitSemaphores = info->pWaitSemaphores;
+		si.pWaitDstStageMask = stages.data();
+		const u32 buffer = (u32)sc->firstBuffer + info->pImageIndices[i];
+		const s64 arg = (s64)(sFlipsSubmitted + 1);
+		if (si.waitSemaphoreCount)
+		{
+			const VkResult sr = queueSubmit(queue, 1, &si, VK_NULL_HANDLE);
+			if (sr != VK_SUCCESS)
+				ERROR_LOG(RENDERER, "PS4WSI: present semaphore submit failed: %d", sr);
+		}
+		// the flip goes to the GPU behind the frame's commands: no CPU wait for the GPU or vblank
+		int r = ac_ps4_submit_flip(sVideo, buffer, sc->flipMode, arg);
+		const bool gpuFlip = r == 0;
+		if (!gpuFlip)
+		{
+			// fallback: wait for the GPU on the CPU, then flip
+			Device<PFN_vkQueueWaitIdle>(sc->device, "vkQueueWaitIdle")(queue);
+			r = sceVideoOutSubmitFlip(sVideo, (int)buffer, sc->flipMode, arg);
+		}
+		if (r < 0)
+		{
+			ERROR_LOG(RENDERER, "PS4WSI: flip failed: %x", r);
+			result = VK_ERROR_SURFACE_LOST_KHR;
+		}
+		else
+		{
+			sFlipsSubmitted++;
+			CountPresent();
+			// the PS4 keeps its boot splash (the app's picture) over everything until the app
+			// says it has a picture of its own
+			if (sFlipsSubmitted == 1)
+				sceSystemServiceHideSplashScreen();
+			if (sFlipsSubmitted <= 3)
+				NOTICE_LOG(RENDERER, "PS4WSI: flip %llu of buffer %u (%s)", (unsigned long long)sFlipsSubmitted, buffer,
+						gpuFlip ? "GPU-side" : "CPU wait");
+		}
+		if (info->pResults)
+			info->pResults[i] = r < 0 ? VK_ERROR_SURFACE_LOST_KHR : VK_SUCCESS;
+	}
+	return result;
+}
+
+PFN_vkVoidFunction Intercept(const char *name)
+{
+#define PS4WSI_ENTRY(fn) if (strcmp(name, "vk" #fn) == 0) return (PFN_vkVoidFunction)&fn
+	PS4WSI_ENTRY(EnumerateInstanceExtensionProperties);
+	PS4WSI_ENTRY(CreateInstance);
+	PS4WSI_ENTRY(EnumerateDeviceExtensionProperties);
+	PS4WSI_ENTRY(CreateDevice);
+	PS4WSI_ENTRY(CreateHeadlessSurfaceEXT);
+	PS4WSI_ENTRY(DestroySurfaceKHR);
+	PS4WSI_ENTRY(GetPhysicalDeviceSurfaceSupportKHR);
+	PS4WSI_ENTRY(GetPhysicalDeviceSurfaceCapabilitiesKHR);
+	PS4WSI_ENTRY(GetPhysicalDeviceSurfaceFormatsKHR);
+	PS4WSI_ENTRY(GetPhysicalDeviceSurfacePresentModesKHR);
+	PS4WSI_ENTRY(CreateSwapchainKHR);
+	PS4WSI_ENTRY(DestroySwapchainKHR);
+	PS4WSI_ENTRY(GetSwapchainImagesKHR);
+	PS4WSI_ENTRY(AcquireNextImageKHR);
+	PS4WSI_ENTRY(QueuePresentKHR);
+#undef PS4WSI_ENTRY
+	return nullptr;
+}
+
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL GetDeviceProcAddr(VkDevice device, const char *name)
+{
+	// vulkan.hpp's DispatchLoaderDynamic::init(device) looks vkGetDeviceProcAddr up again through
+	// itself: RADV's would then resolve the swapchain functions, and it has none (all null)
+	if (strcmp(name, "vkGetDeviceProcAddr") == 0)
+		return (PFN_vkVoidFunction)&GetDeviceProcAddr;
+	if (auto fn = Intercept(name))
+		return fn;
+	return vk_common_GetDeviceProcAddr(device, name);
+}
+
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL GetInstanceProcAddr(VkInstance instance, const char *name)
+{
+	if (strcmp(name, "vkGetInstanceProcAddr") == 0)
+		return (PFN_vkVoidFunction)&GetInstanceProcAddr;
+	if (strcmp(name, "vkGetDeviceProcAddr") == 0)
+		return (PFN_vkVoidFunction)&GetDeviceProcAddr;
+	if (auto fn = Intercept(name))
+		return fn;
+	return vk_icdGetInstanceProcAddr(instance, name);
+}
+
+} // namespace
+
+extern "C" PFN_vkGetInstanceProcAddr ps4_vk_get_instance_proc_addr(void) {
+	return &GetInstanceProcAddr;
+}
