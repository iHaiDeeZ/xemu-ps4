#!/usr/bin/env bash
# xemu-ps4's compilers: ps4-kit's wrappers (toolchain/bin/ps4-cc and ps4-c++: compile for the PS4,
# link a PS4 program with the OpenOrbis runtime) with this port's build tree and sysroot, for
# meson, CMake and configure, which call them by name. ps4-cc is a copy of this file: the name
# picks the language.
export PSB="${PSB:-$HOME/xemups4-build}"
export PS4_SYSROOT="${PS4_SYSROOT:-$PSB/sysroot}"
exec "${PS4_KIT:-$HOME/ps4-kit}/toolchain/bin/$(basename "$0")" "$@"
